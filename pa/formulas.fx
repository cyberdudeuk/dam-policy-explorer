nfTut = Table(
  {id: "around", title: "Find your way around", summ: "The six sections, the main navigation and how pages work", mins: 2, kind: "home", ref: "", ic: Icon.Waypoint},
  {id: "scope", title: "Decide whether an asset is in scope", summ: "Use the asset test and the worked examples", mins: 3, kind: "test", ref: "", ic: Icon.CheckBadge},
  {id: "match", title: "Look for a match in the National Data Library", summ: "Check whether the data set is already listed on data.gov.uk", mins: 2, kind: "match", ref: "", ic: Icon.Link},
  {id: "return", title: "Work through your return", summ: "The twelve steps, and how to keep track", mins: 3, kind: "page", ref: "return", ic: Icon.DetailList},
  {id: "answers", title: "Find, read and save an answer", summ: "Questions and answers, search and the glossary", mins: 2, kind: "questions", ref: "", ic: Icon.QuestionMark},
  {id: "access", title: "Use it your way", summ: "Keyboard, screen reader, phone, tablet or laptop", mins: 2, kind: "page", ref: "accessibility", ic: Icon.View}
);
nfTutSteps = Table(
  {tid: "around", n: 1, h: "Home is in six numbered sections", t: "They follow the order you will need them: 1 understand the policy, 2 decide what is in scope, 3 make and send your return, 4 find an answer, 5 get help, 6 your area. Each section has its own colour and lists its own links."},
  {tid: "around", n: 2, h: "The main navigation is always there", t: "On a phone it is the bar at the bottom of the screen. On a laptop or large tablet it moves to the top right. It has Home, Asset test, Questions, Examples and My area."},
  {tid: "around", n: 3, h: "Long pages are split into sections", t: "A page shows one section at a time. Use Next and Previous at the bottom, or Contents to jump. The bar under the title shows how far through you are."},
  {tid: "around", n: 4, h: "Search from Home", t: "The search box on Home looks across pages, answers, examples and the glossary. Type two or more letters."},
  {tid: "around", n: 5, h: "Save what you need", t: "Choose Save on any page section, answer, example or word. You will find them again in My area, under Saved."},
  {tid: "around", n: 6, h: "Know where an answer comes from", t: "Every answer carries a label: Policy, GDS position, Suggested practice, Programme plan or Open. If anything here disagrees with GOV.UK, GOV.UK is right."},
  {tid: "scope", n: 1, h: "Open the Asset test", t: "Choose Asset test in the main navigation, or in section 2 on Home."},
  {tid: "scope", n: 2, h: "Name the asset if you want to", t: "The name only labels your result. It stays on this device."},
  {tid: "scope", n: 3, h: "Answer five questions, one at a time", t: "Choose an answer, then Next. For the purposes question you can choose several. If you do not know, choose Not sure: the test will tell you what to confirm."},
  {tid: "scope", n: 4, h: "Read the result", t: "There are four possible results: include it, include it if you have time, include it provisionally and flag it, or leave it out. The result gives the reason and the next step."},
  {tid: "scope", n: 5, h: "Compare with worked examples", t: "Open Examples and filter by In scope, Out of scope or It depends to find a case like yours."},
  {tid: "scope", n: 6, h: "Find your tested assets later", t: "They are listed in My area, under Tested."},
  {tid: "match", n: 1, h: "Open Matchmaker", t: "It is in section 2 on Home, and at the end of an asset test result."},
  {tid: "match", n: 2, h: "Describe the data asset", t: "One or two sentences about what the data is. Leave out anything sensitive: your search words are sent to data.gov.uk when you search."},
  {tid: "match", n: 3, h: "Narrow it down if you can", t: "Publisher, topic and format are optional. They are added to the search words."},
  {tid: "match", n: 4, h: "Search", t: "Matchmaker picks the key words from your description and opens the results on data.gov.uk in your browser. You can also search with your exact words."},
  {tid: "match", n: 5, h: "Use what you find", t: "If the same data set is listed, use its title and publisher so your return describes it the same way. If nothing matches, note that too."},
  {tid: "return", n: 1, h: "Open Your return", t: "It is in section 3 on Home. The page takes you through the twelve steps of the Baseline Return."},
  {tid: "return", n: 2, h: "Read one section at a time", t: "Use Next and Previous. Use Contents to jump to a step."},
  {tid: "return", n: 3, h: "Mark steps as done", t: "Open My area and choose Progress. Select a step to mark it done, and again to undo it. The bar shows how many of the twelve you have finished."},
  {tid: "return", n: 4, h: "See what happens after you send it", t: "Track your return, also in section 3, explains what happens next and what the return shows."},
  {tid: "answers", n: 1, h: "Open Questions", t: "Choose Questions in the main navigation."},
  {tid: "answers", n: 2, h: "Filter or search", t: "Choose a topic to filter the list, or type a word in the search box. The count shows how many answers match."},
  {tid: "answers", n: 3, h: "Read the answer and its source", t: "Open an answer to read it. The label at the top says where it comes from, and the sources are listed at the end."},
  {tid: "answers", n: 4, h: "Save it", t: "Choose Save. Saved answers are kept in My area, under Saved."},
  {tid: "answers", n: 5, h: "Check a word", t: "The Glossary, in section 4 on Home, explains the terms the policy uses."},
  {tid: "access", n: 1, h: "Keyboard", t: "Use Tab and Shift+Tab to move between controls, and Enter or Space to choose. The control you are on has a thick yellow outline."},
  {tid: "access", n: 2, h: "Screen reader", t: "Each screen has one main heading and section headings you can jump between. Counts and results are announced when they change. Icons that only decorate are hidden from screen readers."},
  {tid: "access", n: 3, h: "Any screen size", t: "Everything fits the width of your screen: one column on a phone, two or three on larger screens, and nothing scrolls sideways. Turn a phone or tablet on its side to give wide content more room."},
  {tid: "access", n: 4, h: "Long sections", t: "A long section scrolls inside its panel. If you use a keyboard only and cannot scroll it, choose Contents, then Open the full page in the web explorer."},
  {tid: "access", n: 5, h: "Motion", t: "The background moves slowly. It stops if your device is set to reduce motion."}
);
nfContact = "https://forms.cloud.microsoft/e/SLBvuPX7jK";
nfStale = 30;
nfSupTabs = Table(
  {tab: "Get help"},
  {tab: "Contact us"},
  {tab: "Feedback"}
);
nfRepo = "https://github.com/cyberdudeuk/dam-policy-explorer";
nfReqTypes = Table(
  {v: "A question about the policy"},
  {v: "A problem with this app"},
  {v: "An accessibility problem"},
  {v: "A suggestion"},
  {v: "Something else"}
);
nfSupport = Table(
  {title: "Tutorials and tours", summ: "Short walk-throughs of the main tasks", kind: "learn", ref: "", ic: Icon.Lightbulb},
  {title: "User guide", summ: "How to use this app", kind: "page", ref: "guide", ic: Icon.Journal},
  {title: "Questions and answers", summ: "Check whether your question is already answered", kind: "questions", ref: "", ic: Icon.QuestionMark},
  {title: "How to ask a policy question", summ: "Who to ask, and what happens next", kind: "page", ref: "ask", ic: Icon.Message},
  {title: "Accessibility", summ: "What works, what does not yet, and how to tell us", kind: "page", ref: "accessibility", ic: Icon.View},
  {title: "About this app", summ: "Version, sources, method and what is planned", kind: "page", ref: "about", ic: Icon.Information},
  {title: "Report a problem or suggest something", summ: "Write a message and open the contact form", kind: "contact", ref: "", ic: Icon.Send}
);
nfSteps = Table(
  {n: 1, title: "Name who is in charge"},
  {n: 2, title: "Agree who owns your data"},
  {n: 3, title: "Start a list of possible assets"},
  {n: 4, title: "Check each one against the scope principles"},
  {n: 5, title: "Agree the list across your organisation"},
  {n: 6, title: "Name an owner and a steward for each asset"},
  {n: 7, title: "Fill in the 24 details"},
  {n: 8, title: "Link a data quality plan"},
  {n: 9, title: "Check the returns from organisations that report to you"},
  {n: 10, title: "Sign off and send"},
  {n: 11, title: "Keep it current"},
  {n: 12, title: "Share what you learned"}
);
nfRoles = Table(
  {role: "Lead coordinator", tip: "Start with Your return, then Track your return."},
  {role: "Chief data officer", tip: "Start with The policy in plain English, then Roles and journeys."},
  {role: "Data owner", tip: "Start with the Asset test, then Worked examples."},
  {role: "Data steward", tip: "Start with Your return, step 7: fill in the 24 details."},
  {role: "Exploring", tip: "Start with The policy in plain English, or take the tour."}
);
nfMeTabs = Table(
  {tab: "Progress"},
  {tab: "Saved"},
  {tab: "Tested"},
  {tab: "Settings"}
);
nfStats = "55 answers · 71 worked examples · 32 words explained";
nfFirst = With({n: User().FullName}, If("," in n, Trim(First(Split(Last(Split(n, ",")).Value, "(")).Value), First(Split(n, " ")).Value));
nfLogo = "data:image/svg+xml;utf8," & EncodeUrl("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='14' fill='#0b55a3'/><ellipse cx='27' cy='20' rx='13' ry='5' fill='none' stroke='#fff' stroke-width='3.2'/><path d='M14 20v20c0 2.8 5.8 5 13 5' fill='none' stroke='#fff' stroke-width='3.2' stroke-linecap='round'/><path d='M14 30c0 2.8 5.8 5 13 5' fill='none' stroke='#fff' stroke-width='3.2' stroke-linecap='round'/><path d='M40 20v6' stroke='#fff' stroke-width='3.2' stroke-linecap='round'/><circle cx='43' cy='42' r='9.5' fill='#00a88f' stroke='#fff' stroke-width='3.2'/><path d='M43 36.5l2.2 4.5-4.4 1.1z' fill='#fff'/><path d='M43 47.5l-2.2-4.5 4.4-1.1z' fill='#fff' opacity='.75'/></svg>");
nfNav = Table(
  {n: 0, label: "Home", ic: Icon.Home},
  {n: 1, label: "Asset test", ic: Icon.CheckBadge},
  {n: 2, label: "Questions", ic: Icon.QuestionMark},
  {n: 3, label: "Examples", ic: Icon.LevelsLayersItems},
  {n: 4, label: "Search", ic: Icon.Search}
);
nfTour = Table(
  {n: 1, h: "Welcome", t: "This app answers questions about the Data Asset Management Policy. Every answer shows where it comes from."},
  {n: 2, h: "Six sections, in order", t: "Home has six numbered sections in the order you will need them: understand, decide what is in scope, make your return, find an answer, get help, and your own area."},
  {n: 3, h: "Test an asset", t: "The asset test asks five questions and tells you whether an asset goes in your return, and why."},
  {n: 4, h: "Find a match", t: "Matchmaker checks whether the same or a related data set is already listed in the National Data Library on data.gov.uk."},
  {n: 5, h: "Read a page", t: "Long pages are split into sections. Use Contents, Previous and Next to move around."},
  {n: 6, h: "If it disagrees with GOV.UK", t: "This is a prototype. If anything here disagrees with GOV.UK, GOV.UK is right."}
);
nfNewCount = 110;
nfIndex = Table(
  {type: "Page", title: "The policy: Overview", kind: "page", ref: "policy", n: 1, t: "The Data Asset Management Policy asks government organisations to find, describe and look after the data they share with each other. GDS published it on 27 May 2026. This page explains the policy. It does not replace it. Read the policy on GOV.UK .", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "The policy: Why it exists", kind: "page", ref: "policy", n: 2, t: "Government relies on data that passes between organisations. When nobody knows what that data is, who owns it or how good it is, services and decisions suffer. The policy sets a minimum standard for quality, discoverability, interoperability and clear ownership. [Policy]", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "The policy: Who it applies to", kind: "page", ref: "policy", n: 3, t: "Who the policy applies to Government departments Applies?: [Must] Arm's length bodies: executive agencies, non-departmental public bodies, non-ministerial departments Applies?: [Must] Public corporations Applies?: [Optional] Local government Applies?: [Optional] Devolved governments Applies?: [Use their own data sharing governance] Source: Data Asset Management Policy in government (GOV.UK)", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "The policy: What you must do", kind: "page", ref: "policy", n: 4, t: "Find and record your data assets Identify the data assets in scope, manage metadata about them in your data catalogue , and report them to GDS. Section 4 of the policy [Policy] Departments coordinate their arm's length bodies Send metadata on your own assets, and coordinate and assure the returns from your arm's length bodies. Section 4 of the policy [Policy] Name an owner for every asset Every identified data asset must have a named data owner , accountable for decisions about it. Section 5 of", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "The policy: What counts as a critical data asset", kind: "page", ref: "policy", n: 5, t: "First, the data must be OFFICIAL . SECRET and TOP SECRET data is not in scope. [Policy] Then all four DAM Policy scope principles must apply. [GDS position] It meets a critical criterion. It supports at least one of seven critical purposes. It is shared. It has value across government through reuse: shared under a data sharing agreement, published as open data, or could create value if shared. You are accountable for it. You manage or control it, including others' data you have materially change", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "The policy: What the policy does not do", kind: "page", ref: "policy", n: 6, t: "It does not make you share data. It does not remove any legal obligation you already have. It does not promise that data will be available, or of a given quality, beyond what is already agreed. Source: Data Asset Management Policy in government (GOV.UK)", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "The policy: Myths and facts", kind: "page", ref: "policy", n: 7, t: "Myth Listing data means we have to share it. Fact No. The policy does not create a duty to share data or remove any legal obligation. [Policy] Myth We have to report every data asset we hold. Fact No. Only critical data assets, as the policy defines them, go in the return. [GDS position] Myth Data owners replace information asset owners. Fact No. Information asset owners keep their role. The data owner role adds to it. [Policy] Myth We need to buy a particular catalogue product. Fact No. The pol", flag: "Updated", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "The policy: From requirement to capability", kind: "page", ref: "policy", n: 8, t: "Each requirement rests on a capability your organisation needs. The capabilities page shows all 32 and links to a playbook for each. Identify and report critical data assets (section 4)→ CR-05 Identify and scope critical data assets CR-03 Central reporting, assurance and arm's length body coordination Manage metadata in your data catalogue (section 4)→ CR-06 Data cataloguing and metadata management CR-11 Interoperability, data standards and identifiers A named data owner for every asset (section", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "The policy: Who does what", kind: "page", ref: "policy", n: 9, t: "Roles and responsibilities Chief data officer What they do: Responsible for putting the policy into practice in the organisation. Names a coordinator and signs off the return. Where this comes from: [Policy] source Coordinator What they do: Runs the return day to day: gathers the list, works with owners and stewards, checks the returns from arm's length bodies. Where this comes from: [Programme plan] Data owner What they do: Named for each asset and accountable for decisions about it, including", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "The policy: The guidance that goes with it", kind: "page", ref: "policy", n: 10, t: "Identifying and recording critical data assets Recording metadata to describe critical data assets Data ownership model Data quality action plan: implementation guide Data quality issues framework The Government Data Quality Framework", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "The policy: What GDS offers", kind: "page", ref: "policy", n: 11, t: "Published guidance and standards, including the data quality action plan guide and the data quality issues framework. Support targeted at organisations' different levels of data maturity and resources, starting with assets that are proven to be reused. A service, being developed, to make data asset metadata easy to find across government. Source: Data Asset Management Policy in government (GOV.UK)", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Your return: Overview", kind: "page", ref: "return", n: 1, t: "Make your organisation’s data asset return Four parts and twelve steps, from getting ready to sending your list to GDS (the Government Digital Service). Each step says who does it, what you need and what you end up with. When: GDS plans to collect the first return, called the Baseline Return, in January 2027. Aim to be ready by Friday 18 December 2026, before the Christmas break. The January date comes from the programme plan. It is not yet written in the published policy, so check with us befor", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Your return: What do I need to do?", kind: "page", ref: "return", n: 2, t: "Four parts, in order. Choose a step to open it. At the end of each step there is a link to the next one. 1. Get ready 1. Name who is in charge 2. Agree who owns your data 2. Make your list 3. Start a list of possible assets 4. Check each one against the scope principles 5. Agree the list across your organisation 6. Name an owner and a steward for each asset 7. Fill in the 24 details 8. Link a data quality plan 3. Check and send 9. Check the returns from organisations that report to you 10. Sign", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Your return: The twelve steps", kind: "page", ref: "return", n: 3, t: "Get ready 1. Name who is in charge Your takes charge of the return. They name a coordinator and give them time to do the work. Who does this Your chief data officer leads. This is the most senior person in charge of data. The coordinator does the day-to-day work. What you need Your organisation chart, and a list of the organisations that report to your department (often called ). What you end up with A person in charge, a coordinator, and a list of everyone who needs to take part. Based on: Data", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Your return: Is my list ready to send?", kind: "page", ref: "return", n: 4, t: "This finds the most common problems, so your return can be accepted first time. The check follows the version 3 workbook. First save the workbook’s return sheet as a CSV file. The file check needs JavaScript, which is switched off or blocked in your browser. You can still use the list of checks below to go through your file by hand. What the check looks for Must fix The file has all 24 columns of the version 3 template. The 13 details that must be filled in are filled in. Text fits the length th", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Your return: What happens after I send it?", kind: "page", ref: "return", n: 5, t: "We receive it You get a reference number. We keep your original file exactly as you sent it. We check it Automatic checks first, then a person looks at anything unclear. We ask once, if we need to If something needs changing, we send one message listing everything. It joins the register Your assets join one cross-government register, with a record of where each came from. We use it to help The register shows where support is needed most. An honest gap is not a mistake. If your return says, for e", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Your return: Where can I get help?", kind: "page", ref: "return", n: 6, t: "Use our contact form . Tell us which step your question is about. We will add useful answers to our published answers, without your name or your organisation’s name. The form is on GitHub, so what you write can be seen by others. Do not include personal or sensitive information. If you need this information in a different format, such as large print, audio or Easy Read, use the same form and tell us what you need.", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Your return: What do the words mean?", kind: "page", ref: "return", n: 7, t: "Show the words and what they mean Critical data asset A set of data that goes to, or comes from, another part of government, and that important work depends on. Baseline Return The first list of critical data assets each organisation sends to GDS. OFFICIAL The lowest level of the government’s security classifications. Most government data is OFFICIAL. Data owner The person who is responsible for a set of data and decides how it is used. Data steward The person who looks after a set of data day t", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Track your return: Overview", kind: "page", ref: "track", n: 1, t: "For coordinators and chief data officers: where your return has got to, what you sent, and what the policy's measures will show across government. Your information stays with you. Everything on this page is saved or read in your own browser. Nothing is uploaded or sent to anyone.", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Track your return: Where your return has got to", kind: "page", ref: "track", n: 2, t: "Record each stage as it happens, so you and your chief data officer can see it at a glance. GDS tells you each step by email to your coordinator.", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Track your return: What you sent", kind: "page", ref: "track", n: 3, t: "Open the CSV copy of the version 3 workbook you sent (in Excel, choose Save as , then CSV ). The page shows what is in it and how ready each asset is, using the same checks GDS uses first.", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Track your return: Across government", kind: "page", ref: "track", n: 4, t: "When returns arrive, GDS will report these measures to the Chief Data Officer Council and to ministers. No returns have arrived yet: the Baseline Return is due in January 2027, so nothing is shown here until then. [Programme plan] Planned cross-government measures Returns received What it shows: Returns received against the organisations expected to send one. Broken down by: Department and arm's length body Available: [After the Baseline Return] Critical data assets reported What it shows: Numbe", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Track your return: Coming next: your organisation's live view in Teams", kind: "page", ref: "track", n: 5, t: "The next release will show each organisation its own return, status and measures, live, inside this app in Microsoft Teams. Return data will be kept in SharePoint, and Power BI will show each organisation only its own data, after you sign in with your work account. [Suggested practice]", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Roles and journeys: Overview", kind: "page", ref: "people", n: 1, t: "Who takes part in the DAM Policy, what each person needs, and the route through this app and the playbooks that fits their role. The roles and user stories come from the DAM capability playbooks , and the questions from the GDS question register. They still need testing with real users. [Suggested practice]", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Roles and journeys: All journeys at a glance", kind: "page", ref: "people", n: 2, t: "Each role moves through the same five stages. Choose a link to go to that step. Journey map: roles by stage Lead policy coordinator Learn: The policy in plain English The four scope principles Prepare: Name who is in charge, set up arm's length body contacts Build the candidate list Do: Test each asset Confirm owners and fill in the details Report: Check the list Assure arm's length body returns, sign off and send Improve: Schedule the annual review Share what you learned Chief data officer Lear", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Roles and journeys: Lead policy coordinator", kind: "page", ref: "people", n: 3, t: "Coordinates adoption day to day, collates and assures the return, and represents the organisation at the Working Group. Context Works across many teams, often alongside another role. Needs one route from start to return, and templates to reuse. Goals Get the Baseline Return right first time Avoid retyping information that already exists Keep arm's length bodies in step User stories As a lead policy coordinator, I need one ordered route from mobilising to an assured return, so that nothing is mis", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Roles and journeys: Chief data officer", kind: "page", ref: "people", n: 4, t: "Accountable for adopting the policy across the organisation and, in a department, its arm's length bodies. Context Has little time, decides on resourcing and reports progress to the Chief Data Officer Council. Wants summaries first, detail on request. Goals Adopt the policy once, without the three capabilities duplicating effort Know the organisation's position at any time Show credible progress to the CDO Council User stories As a chief data officer, I need to see what the policy requires and w", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Roles and journeys: Data owner", kind: "page", ref: "people", n: 5, t: "The senior leader accountable for the meaning, content, quality and management of one or more critical data assets. Context Data ownership is one of several responsibilities. Makes decisions and signs off; others do the day-to-day work. Goals Understand exactly what they are accountable for Make decisions quickly with the right evidence Name a successor so the asset is never orphaned User stories As a data owner , I need a clear list of the decisions that are mine, so that I can sign off with co", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Roles and journeys: Data steward", kind: "page", ref: "people", n: 6, t: "Runs critical data assets day to day: their standards, access, metadata and quality processes. Context Does the detailed work and keeps the records current. Needs step-by-step methods and templates. Goals Keep the catalogue record and quality plan current without heroics Find problems before users do Hand over cleanly when moving on User stories As a data steward , I need step-by-step instructions with templates, so that I can do the work consistently across assets. As a data steward, I need one", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Roles and journeys: Catalogue manager or data custodian", kind: "page", ref: "people", n: 7, t: "Runs the catalogue and the systems behind it, so records can be found, harvested and kept accurate. Context Works with tools and standards. Needs to know what any catalogue must expose, whatever the product. Goals Records that machines can harvest, not only people Conform to the cross-government metadata standard Avoid lock-in to one product User stories As a catalogue manager or data custodian, I need the exact metadata properties and how they map to the standard, so that records conform first", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Roles and journeys: Data quality lead or analyst", kind: "page", ref: "people", n: 8, t: "Brings methods and tools for measuring and improving quality across many assets. Context Supports several stewards. Needs a consistent scoring method and tools that work without installing anything. Goals Score issues the same way across assets Automate measurement across assets Show quality fairly for every group the data describes User stories As a data quality lead or analyst, I need the government scoring method and tools that apply it, so that priorities are consistent and defensible. As a", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Roles and journeys: Programme or project lead", kind: "page", ref: "people", n: 9, t: "Leads a change programme or project that creates, changes, migrates or retires critical data assets. Context The programme has its own governance, gates, budget and suppliers. Data asset management can feel like someone else's job until a gate review, migration or handover exposes the gaps. Goals Pass assurance gates without late data surprises Hand over assets with owners and quality plans in place Avoid creating the next legacy system User stories As a programme or project lead, I need to know", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Roles and journeys: Commercial or technology lead", kind: "page", ref: "people", n: 10, t: "Chooses, buys or builds the tools that catalogue, check and govern critical data, and writes the contracts that keep the data yours. Context Asked to find a catalogue, quality or master data tool quickly, often with a supplier's suite already on the table. Goals Buy what the DAM Policy actually needs Prove a tool works with our data before signing Keep the option to leave User stories As a commercial or technology lead, I need ready-made requirements for each kind of tool, with priorities, so th", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Capabilities: Overview", kind: "page", ref: "capabilities", n: 1, t: "The policy names a few things you must do. Doing them well rests on 32 capabilities, from leadership and strategy to tooling, risk and handover. Find the ones that matter to you, and go straight to the playbook for each. The capability model and playbooks are the DAM capability playbooks , a prototype. They are not government guidance. Where they repeat GOV.UK, GOV.UK is the authority. [Suggested practice] Explicit The policy names it as a requirement or responsibility. Implicit The policy depen", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Capabilities: Where to start", kind: "page", ref: "capabilities", n: 2, t: "Start with the core capabilities the policy names. They are the ones your first return depends on. Identify and report critical data assets (section 4)→ CR-05 CR-03 → Cataloguing playbook Manage metadata in your data catalogue (section 4)→ CR-06 CR-11 → Cataloguing playbook A named data owner for every asset (section 5)→ CR-07 → Governance playbook A data quality action plan or equivalent (section 6)→ CR-08 CR-09 → Quality playbook Review every year (section 4)→ CR-04 → Governance playbook The c", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Capabilities: Direction and oversight", kind: "page", ref: "capabilities", n: 3, t: "CR-01 Accountable leadership and policy oversight Explicit · for Chief data officer In the capability model CR-02 Data strategy and prioritisation by reuse value Implicit · for Chief data officer In the capability model CR-03 Central reporting, assurance and arm's length body coordination Explicit · for Lead policy coordinator, Chief data officer In the capability model CR-04 Performance measurement and annual review Explicit · for Lead policy coordinator, Chief data officer In the capability mo", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Capabilities: Core DAM capabilities", kind: "page", ref: "capabilities", n: 4, t: "CR-05 Identify and scope critical data assets Explicit · for Lead policy coordinator In the capability model CR-06 Data cataloguing and metadata management Explicit · for Lead policy coordinator, Data steward , Catalogue manager or data custodian In the capability model CR-07 Data ownership and stewardship Explicit · for Data owner In the capability model CR-08 Data quality management through action plans Explicit · for Data owner, Data steward, Data quality lead or analyst In the capability mod", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Capabilities: Data management enablers", kind: "page", ref: "capabilities", n: 5, t: "CR-10 Data life cycle management Explicit In the capability model CR-11 Interoperability, data standards and identifiers Explicit · for Data steward, Catalogue manager or data custodian In the capability model CR-12 Data architecture and data services Implicit · for Catalogue manager or data custodian In the capability model CR-13 Catalogue and quality tooling Implicit · for Catalogue manager or data custodian, Commercial or technology lead In the capability model CR-14 Reference data, master da", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Capabilities: Protection, ethics and trust", kind: "page", ref: "capabilities", n: 6, t: "CR-16 Security classification and protective controls Explicit In the capability model CR-17 Data protection and lawful sharing Explicit In the capability model CR-18 AI readiness and data and AI ethics Explicit In the capability model CR-19 Data risk management Explicit · for Data owner In the capability model CR-20 Third-party and supplier data Implicit · for Commercial or technology lead In the capability model CR-30 Equality and inclusion in data Inferred · for Data quality lead or analyst I", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Capabilities: People and culture", kind: "page", ref: "capabilities", n: 7, t: "CR-21 Data skills, capability and literacy Implicit · for Lead policy coordinator In the capability model CR-22 Data culture and engagement with users Implicit In the capability model CR-23 Maturity assessment and continuous improvement Implicit · for Chief data officer In the capability model", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Capabilities: Delivery, change and value", kind: "page", ref: "capabilities", n: 8, t: "CR-24 Investment, business cases and value Explicit · for Chief data officer, Programme or project lead In the capability model CR-25 Integration with programmes, spend control and assurance Inferred · for Lead policy coordinator, Programme or project lead In the capability model CR-26 Legacy migration and decommissioning Inferred · for Programme or project lead In the capability model CR-27 Ownership transition and handover to business as usual Implicit · for Data owner, Programme or project le", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Embed it: Overview", kind: "page", ref: "embed", n: 1, t: "The return is one moment in the year. The policy works when knowing, owning and looking after your shared data becomes normal, both in day-to-day business and whenever something changes.", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Embed it: The yearly cycle", kind: "page", ref: "embed", n: 2, t: "Each stage comes from a requirement in the policy. [Policy] 1 Identify Test possible assets against the scope principles. 2 Record Describe each asset in your catalogue. 3 Own Name an owner, and a steward to look after it. 4 Assure quality Keep a quality plan, and act on the issues it finds. 5 Report Send your return to GDS. 6 Review Look at the whole list again at least once a year. Source: Data Asset Management Policy in government (GOV.UK)", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Embed it: In business as usual", kind: "page", ref: "embed", n: 3, t: "Ways organisations can keep the policy working after the first return. [Suggested practice] Put it in role descriptions Write data owner and steward duties into the roles that hold them, so they survive people moving on. Use your existing governance Take the asset list and quality plans to the board or committee that already oversees information risk. Fix a yearly date Pick a month for the annual review and put it in the business plan, ahead of the return. Keep the catalogue as the source Update", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Embed it: In change: projects and new services", kind: "page", ref: "embed", n: 4, t: "Build it in from the start, so a new service's data joins your list without extra work. This follows the Service Standard's delivery phases and point 10 of the Technology Code of Practice, which asks teams to plan for data across its lifecycle. [Suggested practice] Discovery List the data the service will create, use or share with other organisations. Note which critical purposes it serves. Alpha Run each likely asset through the asset test. Agree who will own it. Check the legal basis for any s", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Embed it: Practical kit for data owners and stewards", kind: "page", ref: "embed", n: 5, t: "Coordinators asked for practical help, not more policy. Use these as they are, or adapt them to your organisation. [Suggested practice] Data owner: what to do first Accept the role in writing, and name a successor so the asset is never left without an owner. Know each asset: what it is for, who relies on it, and what it must not be used for. Agree quality targets with your steward, and approve the asset's quality plan. Decide which risks you accept, and record them on the risk register you alrea", flag: "New", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Embed it: Briefing your arm's length bodies", kind: "page", ref: "embed", n: 6, t: "An outline for a 45-minute introduction, with a page here for each point that people can read afterwards. GDS is happy to support departments in these conversations: ask through the contact form . [Suggested practice] The ask (5 minutes) Find, record and report your critical data assets, each with an owner and a quality plan. What you must do The scope (10 minutes) OFFICIAL , and the four scope principles. Asset test Why it matters (5 minutes) Government relies on data that passes between organi", flag: "New", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Embed it: Build the capability behind it", kind: "page", ref: "embed", n: 7, t: "The return shows where your organisation's data management needs to grow: catalogues, ownership, metadata and quality. Start with the gaps the return reveals, and use the published guidance for each one. Ownership: the data ownership model Metadata: recording metadata for critical data assets Quality: the data quality action plan guide Quality culture: the Government Data Quality Framework", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Resources: Overview", kind: "page", ref: "resources", n: 1, t: "All the published guidance, templates and tools for the policy, in one list.", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Resources: Guidance, templates and tools", kind: "page", ref: "resources", n: 2, t: "16 resources Data Asset Management Policy in government The policy itself: who it applies to and what you must do. Guidance · for Coordinators, Chief data officers, Data owners [Policy] Identifying and recording critical data assets How to identify critical data assets, and the seven critical purposes. Guidance · for Coordinators, Data owners [Policy] Recording metadata to describe critical data assets The core metadata to record for each asset. Guidance · for Coordinators, Data stewards [Policy", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Resources: Meetings and recordings", kind: "page", ref: "resources", n: 3, t: "The coordinators' FAQ and meeting recordings are kept with the DAM Policy Coordinators Working Group on the Knowledge Hub. If you cannot open something, tell us through the contact form and we will send it another way.", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "User guide: Overview", kind: "page", ref: "guide", n: 1, t: "How to use the explorer, and every way to open it: in a browser on any device, installed like an app, in Microsoft Teams, Outlook and the Microsoft 365 app, in Copilot, or on your intranet.", flag: "New", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "User guide: Quick start for coordinators", kind: "page", ref: "guide", n: 2, t: "Read the policy in plain English Five minutes on what the policy asks and who does what. Test your possible assets Five questions per asset. Anything you are not sure about is included and flagged. Work through your return Twelve steps. Mark each one done; your progress is kept on your device. Check your list before you send it Open the CSV of your workbook. It is read in your browser and never uploaded. Track it, and see what it shows Record each stage, and see how ready each asset is. Stuck? T", flag: "New", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "User guide: Tours and tutorials", kind: "page", ref: "guide", n: 3, t: "Each tutorial opens the right page and walks you through it, one step at a time. You can stop at any point with Close the tour or the Escape key. Pages with a tour also have a Take a short tour of this page link under their title. Find your way around The search box, menu, display settings, your path and your progress. One minute. Test whether an asset is in scope The five questions, what happens when you are not sure, and how to export your list of assets left out. Check your list before you se", flag: "New", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "User guide: Finding your way around", kind: "page", ref: "guide", n: 4, t: "The menu at the top takes you between sections. On a narrow screen it folds behind the Menu button. Page contents , on the left, lists the sections of the page you are on. Hide or show it with its switch. What to do next , at the end of each page, suggests the next step and related pages. Tooltips : point at, or tab to, menu items, buttons, labels and words with a dotted underline to see what they mean or do. Press Escape to hide one. Every word is also in the glossary . Labels on answers tell y", flag: "New", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "User guide: On any device, in a web browser", kind: "page", ref: "guide", n: 5, t: "Open https://cyberdudeuk.github.io/dam-policy-explorer/ in Edge, Chrome, Safari or Firefox, on a computer, tablet or phone. You do not need an account or to sign in. Bookmark it, or install it: How to install the explorer like an app Windows or Mac, Edge How to install it: Open the page, then Settings and more (…) › Apps › Install this site as an app . Windows, Mac or Chromebook, Chrome How to install it: Open the page, then the install icon in the address bar, or Menu › Cast, save and share › I", flag: "New", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "User guide: In Microsoft Teams", kind: "page", ref: "guide", n: 6, t: "As a tab in a channel, today, with no administrator In the channel, select + (Add a tab). Choose Website . Name it ""DAM Policy Explorer"" and paste https://cyberdudeuk.github.io/dam-policy-explorer/ . Select Save . Everyone in the channel can now open it. As an app in the Teams sidebar, in Outlook and in the Microsoft 365 app The app adds Home, Your return, Track and Ask tabs, follows your Teams theme (including high contrast) and works on Teams desktop, web and mobile. Your Teams administrator a", flag: "New", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "User guide: In Microsoft 365 Copilot", kind: "page", ref: "guide", n: 7, t: "Where your organisation has Microsoft 365 Copilot and allows agents, the DAM Policy assistant comes with the app. Open Copilot Chat in Teams or at m365.cloud.microsoft, choose the assistant from the list of agents, and ask your question. It answers only from GOV.UK, this explorer and the capability playbooks, and shows where each answer comes from. It is an AI tool: check important answers against the source it gives.", flag: "New", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "User guide: On your intranet or SharePoint", kind: "page", ref: "guide", n: 8, t: "Link to it from a news post, a Quick links web part or your data pages: https://cyberdudeuk.github.io/dam-policy-explorer/ . Embed a page using SharePoint's Embed web part. A SharePoint administrator may first need to allow cyberdudeuk.github.io under the site's HTML Field Security settings. Link to one answer : open it on the questions page and choose Copy a link to this answer .", flag: "New", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "User guide: For IT administrators: add it for your organisation", kind: "page", ref: "guide", n: 9, t: "Microsoft Teams, Outlook and the Microsoft 365 app Download the Microsoft 365 app package (.zip) Download the app package from this page. In the Teams admin centre , go to Teams apps › Manage apps › Actions › Upload new app , and upload the package. Check it is allowed in your app permission policies. To pin it for a group of people, add it to a setup policy . For the Copilot assistant, allow the app under Integrated apps in the Microsoft 365 admin centre. People need Microsoft 365 Copilot licen", flag: "New", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "User guide: Getting help", kind: "page", ref: "guide", n: 10, t: "Use the contact form for questions, problems or suggestions. For questions about your own return, speak to your organisation's lead DAM Policy coordinator.", flag: "New", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Ask a question: Overview", kind: "page", ref: "ask", n: 1, t: "Type a question in your own words. The explorer finds the best answers from everything it holds: questions and answers, the glossary, roles and capabilities.", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Ask a question: Answers", kind: "page", ref: "ask", n: 2, t: "Ask a question, or try one of these: Do arm's length bodies send their own return? What goes in the legal gateway field? Do we report APIs or data sets? What counts as an equivalent quality plan? When is the next return due? Do data owners replace information asset owners?", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Ask a question: Ask the DAM Policy assistant in Copilot", kind: "page", ref: "ask", n: 3, t: "If your organisation uses Microsoft 365 Copilot, the DAM Policy assistant answers in conversation, in Teams and in Copilot Chat. It uses only GOV.UK, this explorer (which includes every answer in the GDS FAQs) and the capability playbooks, and it shows its sources. It is an AI tool: check important answers against the source it gives. [Suggested practice] How the search on this page works: it matches the words in your question, and common alternatives such as ALB for arm's length body, against t", flag: "Updated", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "For the GDS team: Overview", kind: "page", ref: "team", n: 1, t: "Process returns and answer questions For the GDS team: how a return travels from the mailbox to the register, and how to give clear, consistent answers. This page describes how our team works and the processing we propose. It is not published guidance.", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "For the GDS team: What do you need to do?", kind: "page", ref: "team", n: 2, t: "A return has arrived: check it Someone has asked a question: answer it See every step of the process See what still needs deciding", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "For the GDS team: How does a return move through the team?", kind: "page", ref: "team", n: 3, t: "Proposed design, not yet built The same process at four levels of detail, from a summary to every decision. Start with the summary and go deeper only if you need to. From returns to action, in five stages Collect Organisations send their returns. We keep each original file exactly as it arrived. Assure We check every return. Where something needs correcting, we ask the organisation to correct it. Consolidate Accepted returns go into one cross-government register of critical data assets. Understa", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "For the GDS team: How do I answer a question?", kind: "page", ref: "team", n: 4, t: "Every answer follows the same seven steps, so organisations get the same answer whoever they ask. Answer first. Start with the answer, in one or two sentences, using the words the person used. Say where it comes from. Name the document and the part of it. If two documents disagree, the policy comes first, then the guidance on identifying and recording assets, then the other guidance, then our own playbooks. Say how sure we are. Use one of the five labels below. Never present a suggestion as if i", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "For the GDS team: How do I check a return?", kind: "page", ref: "team", n: 5, t: "Check a return, then write one message to the organisation: what must change, what we need to ask, and the policy gaps we have recorded. The file check needs JavaScript, which is switched off or blocked in your browser. You can still use the list of checks below to go through your file by hand. What the check looks for Must fix The file has all 24 columns of the version 3 template. The 13 details that must be filled in are filled in. Text fits the length the template allows. Yes or No questions", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "For the GDS team: What do we keep a record of?", kind: "page", ref: "team", n: 6, t: "Log every question and every return, so nothing is lost and we can see how quickly we respond. Download the question log template (CSV) Download the return log template (CSV) What to record, and why For each question: the date it arrived, how it arrived, who asked and their organisation, the topic, the answer, how sure we are, who checked it, the date we replied and the date we published it. For each return: the date it arrived, the organisation, the file name, what the check found, the question", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "For the GDS team: What still needs deciding?", kind: "page", ref: "team", n: 7, t: "Whether to build the proposed automation, and who will run it. When the return template and its checks are frozen. The proposed date was 31 October 2026, which has passed without a recorded decision. The final list of organisations that must send a return. Until it is agreed, we cannot say a group is complete. Whether each organisation should only be able to edit its own return in the shared workspace. Fixes to the version 3 workbook before January. Our review found nine defects and three other", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "About this app: Overview", kind: "page", ref: "about", n: 1, t: "A one-stop shop for the Data Asset Management Policy, made for DAM Policy coordinators and usable by anyone.", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "About this app: Why we made it", kind: "page", ref: "about", n: 2, t: "Coordinators told us the policy material was spread across GOV.UK, the Knowledge Hub, slide decks, recordings and email, and that some of it was hard to find or read. They asked for simpler, clearer answers in one place. This app brings it together and says where every answer comes from.", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "About this app: How we work", kind: "page", ref: "about", n: 3, t: "We follow the Service Standard , the GDS Way and the GOV.UK guidance on writing . That means we start from users' needs, write in plain English, make every page work without JavaScript, test with assistive technology and publish what we change.", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "About this app: Where you can use it", kind: "page", ref: "about", n: 4, t: "Any web browser Current versions of Edge, Chrome, Safari and Firefox, on computers, tablets and phones. Pages work without JavaScript. Microsoft Teams As a personal app in the Teams sidebar, on desktop, web and mobile. Its colours follow your Teams theme, including high contrast. You can also pin it in a channel as a website tab. Outlook and the Microsoft 365 app The same app opens in Outlook and the Microsoft 365 app, once your administrator has made it available. Installed, and offline Install", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "About this app: What we learned from similar services", kind: "page", ref: "about", n: 5, t: "We looked at how other governments and regulators help people put a data policy into practice, and used what works. GOV.UK step-by-step navigation The six-stage journey shown on every main page, and the twelve steps of the return. GOV.UK question pages: one thing per page The asset test asks one thing at a time and explains each result. ICO data sharing information hub Entry points by audience, myths and facts, checklists and templates in one place. NSW Government Data Governance Toolkit Guidanc", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "About this app: Transparency: how it was made", kind: "page", ref: "about", n: 6, t: "Sources. Facts about the policy come only from GOV.UK. Answers from GDS that are not yet published are labelled with the date they were given. Suggested practice is labelled as such. Needs. The questions this app answers come from the GDS question register. Names and organisations are removed. Contact form. Messages go to a Microsoft Form that only GDS can see. Your email address is asked for only if you want a reply, and is used only to reply. Use of AI. Built with the help of an AI assistant (", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "About this app: Privacy", kind: "page", ref: "about", n: 7, t: "There are no cookies, no tracking and no analytics. Your display settings, your progress through the return and your list of tested assets are saved only in your own browser, on this device. Files you check are read by your browser and are never uploaded. To remove everything, choose Reset to standard in Display settings and clear the list on the asset test page.", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "About this app: Self-check", kind: "page", ref: "about", n: 8, t: "Each time it opens, the app checks itself and reports here. The self-check needs JavaScript.", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "About this app: Updates", kind: "page", ref: "about", n: 9, t: "New or changed answers, including changes to the GDS FAQs, reach you, Teams and the Copilot assistant through a new release of this explorer, recorded under What changed. We re-read the GOV.UK sources and the question register at least every 30 days. If a page has not been checked for longer than that, it shows a warning at the top. Sources were last checked on 18 November 2026.", flag: "Updated", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "About this app: Roadmap", kind: "page", ref: "about", n: 10, t: "[Now] Publish agreed answers on asset boundaries, the legal gateway field and quality plan evidence as soon as they are agreed. [Now] Worked examples and decision routes for hard cases (third-party data, restricted data, potential reuse), once the working group has agreed them. [Now] User research with coordinators on the explorer, including people who use assistive technology. [Next] Host the explorer inside Teams for everyone in the coordinators' group. [Next] Show each organisation's return s", flag: "Updated", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "About this app: What changed", kind: "page", ref: "about", n: 11, t: "18 November 2026 Version 1.2.0. Worked examples: 71 cases you can search and filter by topic, outcome and status, 35 of them agreed. From the community forum and coordinators' questions: a practical kit for data owners and stewards, a briefing outline for arm's length bodies, answers on the Performance Framework, the metadata minimum, standards for new services, and arm's length bodies nobody has contacted. Track and analyse: record where your return has got to, see what you sent and how ready e", flag: "Updated", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "About this app: Contact", kind: "page", ref: "about", n: 12, t: "Use our contact form to ask a question, report a problem or suggest a change. It is a Microsoft Form: you do not need to sign in, and only GDS sees what you send. Give a work email address only if you want a reply.", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Accessibility: Overview", kind: "page", ref: "accessibility", n: 1, t: "We want everyone to be able to use this app, whatever their needs, device or way of working.", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Accessibility: Using this app", kind: "page", ref: "accessibility", n: 2, t: "Change colours (including high contrast), text size, spacing and animation in Display settings at the top of every page. Zoom up to 400% without anything being cut off or needing sideways scrolling. Use the whole app with a keyboard, a screen reader, voice control or a switch. Read every page with JavaScript turned off. Only the interactive tools need it. Point at, or tab to, any word with a dotted underline to see what it means. Print any page: hidden sections open when you print.", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Accessibility: Inclusion", kind: "page", ref: "accessibility", n: 3, t: "We write in plain English, test our pages for reading age, and explain every specialist term. We make no assumptions about where people work, their size of organisation or their maturity with data. Small arm's length bodies are as much our users as large departments. Answers do not depend on knowing who to ask. Everything we tell one coordinator, we publish for all. The app works on slow connections and older devices: there are no web fonts, no tracking and no large downloads.", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Accessibility: How accessible it is", kind: "page", ref: "accessibility", n: 4, t: "This app aims to meet the Web Content Accessibility Guidelines version 2.2 to level AA. Every build is checked with an automated tool (axe-core) at three screen widths and in light, dark and high contrast. Automated tools find only some problems, so we will also test with people who use assistive technology. Known issues The contact form is a Microsoft Form. If it does not work with your assistive technology, ask your organisation's DAM Policy coordinator to pass your message on. Links to GOV.UK", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Accessibility: Tell us about a problem", kind: "page", ref: "accessibility", n: 5, t: "If something does not work for you, use our contact form . Tell us the page and what happened.", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Page", title: "Accessibility: Enforcement", kind: "page", ref: "accessibility", n: 6, t: "The Equality and Human Rights Commission is responsible for enforcing the Public Sector Bodies (Websites and Mobile Applications) (No. 2) Accessibility Regulations 2018. If you are not happy with how we respond to your complaint, contact the Equality Advisory and Support Service . This statement was prepared on 18 November 2026.", flag: "", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1)},
  {type: "Answer", title: "Which organisations does the policy apply to?", kind: "qa", ref: "scope-orgs", n: 0, t: "[Policy] Stated in the published policy or its guidance on GOV.UK. All UK government departments and their arm's length bodies: executive agencies, non-departmental public bodies and non-ministerial departments. It is optional for public corporations and for local government. The devolved governments use their own data sharing governance, though the principles are useful to anyone. Sources Data Asset Management Policy in government GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Exactly what is in scope? (the four scope principles)", kind: "qa", ref: "principles", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. An asset is in scope only if it is OFFICIAL and all four principles apply together: It meets a critical criterion : it supports at least one of the seven critical purposes. It is shared : it has value across government through reuse. It is shared with a public sector organisation under a data sharing agreement, published as open data, or could create value if shared. You are accountable for it : your organisation manages or controls it, including data from others that you h", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Does data we only use inside our organisation count?", kind: "qa", ref: "shared-only", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Not on its own. The policy is about data with value across government. Some data is critical inside your organisation, such as some workforce and finance data, but has no value across government, so it is out of scope. An extract of it that is shared for analysis may be in scope. GDS recommends labelling assets that are in scope as XG_CDA in your data catalogue, so they are easy to tell apart. Sources Identifying and recording critical data assets GDS DAM Policy FAQs, Novem", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "How do we judge if data could create value if shared?", kind: "qa", ref: "potential-value", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. It is a judgement, so be practical and do not hold up your return. For the Baseline Return, start with assets already shared under a data sharing agreement or published as open data. If you have time, add assets that could create value if they were easier to find and use. Signs of that include data that: supports needs that many organisations have is about common things such as people, places, organisations, businesses or services another organisation has asked for matters", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Are official statistics, or our extracts of another department's statistics, in scope?", kind: "qa", ref: "official-stats", n: 0, t: "[Policy] Stated in the published policy or its guidance on GOV.UK. Do not list published official statistics themselves. List the data behind them: the administrative data, surveys and censuses. That data is listed by the organisation that is accountable for it. An extract you take from another department is yours to list only if you have materially changed or enriched it. Otherwise the source belongs to the other department. Sources Identifying and recording critical data assets GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Do we report SECRET or TOP SECRET data?", kind: "qa", ref: "classified", n: 0, t: "[Policy] Stated in the published policy or its guidance on GOV.UK. No. Only OFFICIAL data is in scope, including OFFICIAL with markings and descriptors such as sensitive. SECRET and TOP SECRET data is excluded. Listing an asset does not force you to share it. The policy does not create a duty to share data or remove any legal obligation. Sources Data Asset Management Policy in government GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "How do Essential Shared Data Assets (ESDAs) relate to critical data assets?", kind: "qa", ref: "esda", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. The DAM Policy grew out of the Essential Shared Data Assets policy. The name changed to critical data asset, but the definition is the same. The ESDA exercise was a test using a sample of assets. The DAM Policy applies across all of government. Sources GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Are there two kinds of critical data asset, internal and shared?", kind: "qa", ref: "internal-shared", n: 0, t: "[Open] Still being decided. The answer says what to do meanwhile. For the DAM Policy there is one kind: a critical data asset is OFFICIAL, meets a critical criterion, is shared or has value across government, is yours to account for, and is the source. That is what goes in your return. Other exercises, such as the Performance Framework, also ask about data that is critical only inside your organisation. Keep your own list of those if it helps, and label the ones in scope of the DAM Policy XG_CDA so the two are never confused. Agreed wording for the two terms has been asked for and is not settl", flag: "New", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Does our kind of data fit one of the seven critical purposes?", kind: "qa", ref: "purpose-fit", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Judge by what the data does, not what it is called. For example, biosecurity or biosurveillance data fits national security and resilience where it supports resilience, emergency response or critical functions, as long as it is OFFICIAL. You can give more than one purpose number for an asset. Use the purposes and numbering in version 3 of the template, which match the published guidance. Sources Data quality issues framework DAM Policy Baseline Return template, version 3 (d", flag: "New", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Which hard cases are still being decided?", kind: "qa", ref: "open-scenarios", n: 0, t: "[Open] Still being decided. The answer says what to do meanwhile. GDS is still agreeing how these cases should be handled, and will publish worked examples: Third-party data you have enriched, and commercially licensed data Assets owned jointly by more than one organisation Data sets, scores or predictions produced by AI Data held in archived or legacy systems Routine exchanges under umbrella agreements Dependencies in a data supply chain Meanwhile, test each asset against the four scope principles. If you are still not sure, include it in your return and flag it, as the asset test does. Tell", flag: "New", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "A team is moving to another department. Who returns its assets?", kind: "qa", ref: "machinery", n: 0, t: "[Open] Still being decided. The answer says what to do meanwhile. The department that receives the team, because it becomes accountable for the data. Keep each asset's unique identifier when it moves, so it can be traced from one return to the next. How follow-up questions are routed during a move is still being agreed. Meanwhile, tell GDS about the move through your lead coordinator. Sources Data Asset Management Policy in government DAM Policy coordinator meetings, September to November 2026", flag: "New", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "We already have our own definition of critical data assets. What do we do?", kind: "qa", ref: "own-definition", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Keep it for your own purposes. The DAM Policy definition covers data with value across government, so some assets you treat as critical will not be in scope. How you manage both is up to you. To keep catalogues consistent across government, label the ones in scope of the policy XG_CDA . Sources GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "We have not formally identified our critical data assets yet. What now?", kind: "qa", ref: "not-identified", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Make a reasonable effort to identify and report them in line with the policy and guidance. The first return sets a baseline to improve from. If you cannot meet a deadline, tell GDS through your lead coordinator. Sources GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Do we report all our data assets, or only critical ones?", kind: "qa", ref: "only-cdas", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Only critical data assets as the policy defines them. You can catalogue anything else for your own purposes, but it does not go in the return. Sources GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Who is accountable, and who should our coordinator be?", kind: "qa", ref: "who-accountable", n: 0, t: "[Policy] Stated in the published policy or its guidance on GOV.UK. Your chief data officer is responsible for putting the policy into practice. If you have no chief data officer, the director responsible for data is accountable. Every asset must have a named data owner. The coordinator role comes from the programme, not the policy. Your chief data officer names someone who knows your organisation's data and gives them time for the work. See who does what . Sources Data Asset Management Policy in government Data ownership model GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Does the data owner role replace information asset owners?", kind: "qa", ref: "iao", n: 0, t: "[Policy] Stated in the published policy or its guidance on GOV.UK. No. Information asset owners keep their role and their accountability for managing, securing and complying with rules about information assets. The data owner role adds to it by making clear who is accountable for how data is accessed, used, improved and governed. The data ownership model explains the difference. Training for data owners is being developed. Sources Data ownership model GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Who reports an asset when ownership is shared or spread across teams?", kind: "qa", ref: "shared-service", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. The organisation that holds data ownership accountability reports it. Where there is a shared service, agree between you which organisation that is. Others may have stewardship or operational roles, but each asset has one named data owner. Sources Data ownership model GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Is there practical, day-to-day help for data owners and stewards?", kind: "qa", ref: "owner-kit", n: 0, t: "[Suggested practice] Written for this app, built on the policy. Helpful, not required. Yes: see the practical kit for data owners and stewards . It has a checklist for each role, what to do first, questions to ask yourself each quarter, and a guide for the regular owner and steward conversation. It is built on the data ownership model and the capability playbooks. GDS is also developing training for data owners. Sources Data ownership model GDS DAM Policy FAQs, November 2026", flag: "New", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "What metadata is mandatory?", kind: "qa", ref: "minimum-metadata", n: 0, t: "[Policy] Stated in the published policy or its guidance on GOV.UK. The minimum set is in Recording metadata to describe critical data assets . It recommends the Data Catalogue Vocabulary (DCAT) to describe data sets and data services. The UK Cross-Government Metadata Exchange Model is one practical way to apply it. The return asks for less than this: a smaller set of details GDS uses to monitor the policy. Keep the full metadata in your own catalogue. See step 7 . Sources Recording metadata to describe critical data assets GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "A field is not in the minimum. Should we stop collecting it?", kind: "qa", ref: "mandatory-kinds", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. No. The minimum is a floor, not a ceiling. Leaving a field out of the return is not an instruction to stop collecting it. GDS has described four senses of ""mandatory"": Policy mandatory : what the DAM Policy requires you to identify, record, report and own. Profile mandatory : the metadata profile for exchange, built on DCAT and the UK Metadata Exchange Model. Locally mandated : extra fields your organisation requires for its own needs. Keep collecting them. Future adoption", flag: "New", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Does recording metadata give others access to our data?", kind: "qa", ref: "discovery-access", n: 0, t: "[Policy] Stated in the published policy or its guidance on GOV.UK. No. Describing an asset helps people find out that it exists and who owns it. Access to the data itself still depends on the law, agreements and controls that already apply. The policy does not create a duty to share. Even sensitive data can be described, so that people know whom to ask. Sources Data Asset Management Policy in government GDS DAM Policy FAQs, November 2026", flag: "New", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Can we keep richer metadata than the minimum?", kind: "qa", ref: "richer-metadata", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Yes. The policy sets a minimum. Keep any extra metadata you need, and keep meeting any higher standards that already apply to you, such as internal rules, regulation or security policies. Sources GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "How does a data catalogue relate to our information asset register?", kind: "qa", ref: "iar-catalogue", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. They overlap but do different jobs. An information asset register is mainly for governance: accountability, risk, security and compliance. A data catalogue helps people find, understand and use data, with richer details such as quality and lineage. A catalogue could replace a register only if it does the governance job as well. Avoid keeping the same details twice: agree one source for the shared fields and link the two. Sources GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Do we need a particular data catalogue product?", kind: "qa", ref: "catalogue-tool", n: 0, t: "[Policy] Stated in the published policy or its guidance on GOV.UK. No. The policy asks you to manage metadata about your assets in your data catalogue and report it to GDS. It does not name a product. GDS ran a catalogue pilot on Microsoft Purview because many organisations already use it, and would repeat the pilot with other tools if there is demand. Peers share how they use their tools at the Data Catalogue and Analysis Platform Working Group. Sources Data Asset Management Policy in government GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "What counts as a data quality action plan ""or equivalent""?", kind: "qa", ref: "dqap", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Every asset must have a data quality action plan or an equivalent. To count as equivalent, your own process must cover all seven steps of the GDS guide: Identify critical data Identify data quality rules Assess current data quality Prioritise improvements and set goals Find the root cause and act Report on data quality Measure again over time The policy does not require a particular document or tool. GDS is building a bank of examples. Sources Data Asset Management Policy i", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "This is a big task. Do we absorb it or set up a team?", kind: "qa", ref: "resourcing", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. GDS is not prescriptive about how you organise the work, because organisations differ so much. It will work through the challenges with lead coordinators in the DAM Policy Working Group, and share how others are approaching it. Sources GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Are the timings for prioritised support fixed?", kind: "qa", ref: "tranches", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. No, they are indicative. They are based on how complex and widely used each department's data was in the ESDA returns. If the timing does not suit your capacity, or you need closer support, raise it through your lead coordinator. Sources GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Can we get feedback on a test return?", kind: "qa", ref: "test-return", n: 0, t: "[Suggested practice] Written for this app, built on the policy. Helpful, not required. Yes. First run your list through Is my list ready to send? . It runs in your browser and finds the most common problems. Then ask for feedback through your lead coordinator or the contact form . Do not attach the file to the form.", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "How do we brief our arm's length bodies, and can GDS help?", kind: "qa", ref: "brief-albs", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. GDS is happy to support departments in conversations with their arm's length bodies, including answering questions about scope. Ask through the contact form. To brief them yourself, use the briefing outline : the ask, the scope, why it matters, how the return works for them and the support available. Every point links to a page here they can read afterwards. Sources GDS DAM Policy FAQs, November 2026", flag: "New", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "When are the returns due?", kind: "qa", ref: "later-returns", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. The first return, the Baseline Return, is due in January 2027. The next is due in October 2027. Aim to be ready by Friday 18 December 2026, before the Christmas break. The policy itself asks you to maintain and review your list every year. In time, GDS expects to replace these returns with more frequent updates taken straight from your catalogue. Sources Data Asset Management Policy in government GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Do arm's length bodies send their own return, or one with their department?", kind: "qa", ref: "alb-returns", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Arm's length bodies identify and record their own critical data assets using the return template. They send it to their parent department first, and the department forwards it to GDS. Departments coordinate and assure their arm's length bodies' returns, and send a combined return where that makes sense. Either one combined return or separate returns is fine, as long as the department knows about every one. In a combined return, fill in the arm's length body or agency column", flag: "Updated", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "When exactly is the Baseline Return due?", kind: "qa", ref: "deadline", n: 0, t: "[Programme plan] From the programme plan. Not yet written into the published policy. By the end of January 2027. The Chief Data Officer Council will issue the formal commission in December 2026. Aim to be ready by Friday 18 December 2026, before the Christmas break, so there is time to check your return. Sources DAM Policy coordinator meetings, September to November 2026", flag: "New", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Who sets the unique identifier, and what if an asset is renamed?", kind: "qa", ref: "identifier", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. You do. Use the stable identifier from your own data catalogue, or a local convention you document. There is no national format, and it can be up to 100 characters. If an asset is renamed, change its name but keep its identifier, so it is not counted twice. The template's guide allows the same identifier on more than one row only for an approved version or licence variant. Its built-in check does not yet allow that, so tell GDS if it blocks you. Sources DAM Policy Baseline", flag: "New", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Is there a naming convention, and how long can the text fields be?", kind: "qa", ref: "field-lengths", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. There is no naming convention for government. Use the name the asset is known by in your organisation or catalogue. The template sets these lengths: Unique identifier: up to 100 characters. Data asset name: up to 200 characters. Description: 20 to 2,000 characters. Say what the data is, what it covers, what it is for and why it matters. Legal gateway: up to 500 characters. Source or provenance: up to 1,000 characters. If text seems to be cut off when you enter it, tell GDS", flag: "New", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "What does 'mandatory if applicable' mean? Can we leave those fields blank?", kind: "qa", ref: "if-applicable", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Fill them in whenever they apply to the asset. Leave one blank only when it really does not apply. Five fields are like this: Arm's length body or agency Source or provenance Legal gateway or regulatory basis Catalogue or metadata reference: needed whenever you answer In catalogue Geospatial standard applied: choose Not applicable rather than leaving it blank The 13 mandatory fields always need an answer. Sources DAM Policy Baseline Return template, version 3 (data dictiona", flag: "New", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Will named people be contacted directly about our assets?", kind: "qa", ref: "contact-enquiries", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. No. The return has no contact name or email address for each asset, and asks only whether an owner and a steward are assigned. Questions about your return go through your lead coordinator. You can keep your own functional contact in your catalogue. Sources DAM Policy Baseline Return template, version 3 (data dictionary and user guide) GDS DAM Policy FAQs, November 2026", flag: "New", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Is the Performance Framework commission the same as the DAM return?", kind: "qa", ref: "performance-framework", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. No, but they are aligned and you should not have to do the work twice. The GDS Performance Framework is a quarterly commission. It looks at your organisation's data capability and maturity as a whole, and asks for counts, including of the critical data assets you manage internally. The DAM Policy return is about shared critical data assets, asset by asset, and how the policy is being put into practice for each one. Some questions deliberately match. GDS is looking at how ev", flag: "New", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "We are an arm's length body and nobody has contacted us. What do we do?", kind: "qa", ref: "alb-not-contacted", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Contact GDS through the contact form. GDS will help through the Chief Data Officer Council to connect you with your department. Your route for the return is your parent department's lead coordinator. Who coordinates the work inside your own organisation is for you to decide. The return uses version 3 of the template and is due in January 2027. Sources GDS DAM Policy FAQs, November 2026", flag: "New", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Does the return assess compliance or maturity?", kind: "qa", ref: "compliance-maturity", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Compliance with the DAM Policy. The Baseline Return shows which assets are in scope and how far they meet the data management requirements. Progress is reported to the Chief Data Officer Council and to ministers after each return. Data maturity is assessed separately, by the GDS Data Maturity Service. Sources GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Do we give the names of data owners and stewards?", kind: "qa", ref: "names", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. No. The return asks only whether each role has been assigned. Do not enter anyone's name. Keep names in your own catalogue or register. Sources GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "What evidence should we keep?", kind: "qa", ref: "evidence", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. You do not send evidence with the return. Be able to trace each answer back to the system it came from, such as your data catalogue or information asset register. Give each row a unique identifier, so later returns can show what is new or changed. Sources GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "How do we report something that is only partly in place?", kind: "qa", ref: "partial", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Choose the option in the template that matches where you really are. Use In development when work has started but is not finished, and Planned or No when it has not started. Do not overstate. For data quality, say whether you have a standard plan, a documented equivalent, or nothing in place yet. Sources GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "How much should we write in free-text fields?", kind: "qa", ref: "free-text", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Keep it short. Use free text only for context the options cannot give: exceptions, partial progress, dependencies, risks, next steps or a non-sensitive evidence reference. Never include personal data, sensitive information, detailed quality scores or rules. Sources GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "What goes in the legal gateway field?", kind: "qa", ref: "legal-gateway", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. The law or agreement that allows the data to be shared or made available, not the basis on which you first collected it. If more than one applies, give the main one if you know it. If there is no clear main one, leave the field blank. You do not need to review several data sharing agreements to fill it in. Recording legal gateways in your catalogue is still good practice. Sources GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "How do we answer the discoverability and interoperability field?", kind: "qa", ref: "discoverability", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. It asks whether information about the data standards the asset uses can be found, inside your organisation and across government, for example on data.gov.uk or a sector portal. In place : full details are available on every standard used. Partial : some details, but not complete. Not in place : no details are available. Sources GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Do we report data sets, data products or APIs?", kind: "qa", ref: "what-to-report", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Report the underlying source data set. Where a critical product, report or API draws on data sets, name those source data sets. You may add details of APIs if you already have them, but you do not need to look for them. If one data set is reached through several APIs, report the data set once. The policy defines a data asset as one or more data sets plus any data services, such as APIs, used to reach them. Sources Data Asset Management Policy in government GDS DAM Policy FA", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Will other departments see the metadata we send?", kind: "qa", ref: "who-sees", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Not for now. Returns go to GDS. Sharing metadata across government is being considered as part of the GDS discoverability service, and members will be able to help shape it. The policy says GDS is developing that service. Sources Data Asset Management Policy in government GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Which template version do we use, and how will changes be managed?", kind: "qa", ref: "template-changes", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Use version 3 of the Baseline Return template: it is the agreed template for the January 2027 return. A change log starts when the first returns arrive. Unique identifiers on each row let GDS see what is new or changed between returns. Sources GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "How does this relate to the National Data Library?", kind: "qa", ref: "ndl", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. The two work closely together to avoid duplication. The National Data Library is focused on developing data.gov.uk. The DAM Policy makes sure good data management practice is applied to government data, which makes it more valuable to initiatives like the library. Sources GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "How does this relate to HM Treasury's Strategic Asset Review?", kind: "qa", ref: "star", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. They ask different things. The Strategic Asset Review looks for assets of all kinds with high commercial potential. The DAM Policy is about critical data that is shared, and commercialisation is not its aim. Some assets may appear in both, but the returns will not be the same. Sources GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "How does this relate to the Metadata Exchange Model?", kind: "qa", ref: "mem", n: 0, t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. The metadata guidance recommends DCAT for describing data sets and data services. The UK Cross-Government Metadata Exchange Model is a practical way to apply DCAT, and can help you record and exchange metadata consistently. Sources Recording metadata to describe critical data assets GDS DAM Policy FAQs, November 2026", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "How do we build the policy into a new service or project?", kind: "qa", ref: "new-service", n: 0, t: "[Suggested practice] Written for this app, built on the policy. Helpful, not required. Treat it as part of the design, not a task at the end. During discovery, name the data the service will create, use or share. Before live, give each critical asset an owner, describe it in your catalogue and start a quality plan, so it joins your next return without extra work. See embedding it in change . This matches point 10 of the Technology Code of Practice, which asks teams to plan for data across its whole lifecycle. Sources Technology Code of Practice, point 10: make better use of data Data Asset Man", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Which standards should a new service, or one replacing a legacy system, adopt from the start?", kind: "qa", ref: "service-standards", n: 0, t: "[Suggested practice] Written for this app, built on the policy. Helpful, not required. Build these in as architecture principles from discovery: The DAM Policy , and its guidance on identifying critical data assets and recording metadata. The data ownership model , for named owners and stewards. The data quality action plan guide and the Government Data Quality Framework, for quality. DCAT , through the UK Cross-Government Metadata Exchange Model, for your catalogue. Point 10 of the Technology Code of Practice , for planning data across its lifecycle, including migration, retention and exit. T", flag: "New", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "How does the policy link to resilience data sharing?", kind: "qa", ref: "resilience", n: 0, t: "[Policy] Stated in the published policy or its guidance on GOV.UK. Defence, national security and resilience is one of the seven critical purposes. Data shared for resilience work can be a critical data asset if the other principles apply. Listing it records that it exists and who owns it. It does not change who may use it. Sources Identifying and recording critical data assets Data Asset Management Policy in government", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Answer", title: "Where do I find the guidance, templates and meeting materials?", kind: "qa", ref: "find-materials", n: 0, t: "[Suggested practice] Written for this app, built on the policy. Helpful, not required. Here. The resources page lists all the published guidance, templates and tools, and you can filter it by what you need. The coordinators' FAQ and meeting recordings are kept with the DAM Policy Working Group on the Knowledge Hub. If you cannot open something, tell us and we will send it another way.", flag: "", ic: Icon.QuestionMark, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1)},
  {type: "Example", title: "EX-001 A flood-warning data set, every field filled in", kind: "ex", ref: "EX-001", n: 0, t: "A live and historical river-level and flood-warning data set is described across all 24 fields of the version 3 template: publisher, provenance, owner and steward assigned, licence, update status, catalogue and quality plan references and the geospatial standards used. It serves purposes 1, 3 and 6.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-002 Moving an old return to the version 3 purposes: 1, 2 and 6", kind: "ex", ref: "EX-002", n: 0, t: "A return started under the earlier numbering lists purposes 1, 2 and 6. In version 3, public service delivery stays 1, developing and evaluating policy becomes 4, and the public interest stays 6.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-003 Moving an old return to the version 3 purposes: 3, 4 and 5", kind: "ex", ref: "EX-003", n: 0, t: "A return started under the earlier numbering lists purposes 3, 4 and 5. In version 3 these become official statistics (5), a legislative, legal or contractual requirement (2), and defence, national security and resilience (3).", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-026 Official statistics received unchanged from another body", kind: "ex", ref: "EX-026", n: 0, t: "A department receives official statistics produced by another public body and uses an unchanged copy in its own work. Keeping a local copy does not make it a new critical data asset.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-027 Official statistics the receiver has materially enriched", kind: "ex", ref: "EX-027", n: 0, t: "The receiving department materially changes or enriches the statistics and becomes accountable for a distinct asset. A critical purpose on its own is not enough.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-034 A pupil data asset with several legal gateways", kind: "ex", ref: "EX-034", n: 0, t: "A national pupil data asset has legal gateways that vary by component and by type of request. Copying every legal analysis into the return would give inconsistent detail.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-035 Metadata kept in several governed places, not one catalogue", kind: "ex", ref: "EX-035", n: 0, t: "A department has no single catalogue, but keeps authoritative metadata in its information asset register, published service records and research catalogues.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-036 An asset that is updated all the time", kind: "ex", ref: "EX-036", n: 0, t: "A longitudinal administrative data set has no releases that fit a version number. Its currency and time coverage are kept in fuller metadata.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-037 An asset governed by several usage bases", kind: "ex", ref: "EX-037", n: 0, t: "The same asset is covered by law, a data sharing agreement and a time-limited licence. A row for each arrangement would count the asset several times.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-038 A finance or workforce extract that matters only internally", kind: "ex", ref: "EX-038", n: 0, t: "An extract is vital inside the organisation but has no value elsewhere in government and no realistic reuse.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-039 One data set offered through several APIs", kind: "ex", ref: "EX-039", n: 0, t: "Several APIs give different routes into the same data set. More routes do not make more assets.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-040 A shared service run by several teams", kind: "ex", ref: "EX-040", n: 0, t: "Several organisations or directorates operate or look after a shared service, but the return needs one organisation that is accountable.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-041 One owner, several stewards", kind: "ex", ref: "EX-041", n: 0, t: "A data product has one senior accountable owner. Several stewards or technical custodians each look after part of it. More than one owner would blur who decides.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-042 Data brought in from outside still needs a local owner", kind: "ex", ref: "EX-042", n: 0, t: "Data received from another organisation needs someone accountable for the copy held, its compliance and its proper use. The sender still owns its own version unless agreed otherwise.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-043 Copying data does not move its ownership", kind: "ex", ref: "EX-043", n: 0, t: "A team copies part of a data product to work on it. The source owner's rules still apply, and unnecessary copies should be avoided.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-044 A derived product can have a new owner, but keeps the rules of its inputs", kind: "ex", ref: "EX-044", n: 0, t: "A product made from other data is given an owner. That does not remove the policies and permissions attached to the data it came from.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-045 The same data used by several organisations", kind: "ex", ref: "EX-045", n: 0, t: "The organisation that creates the data names an owner who sets the conditions for supply and use. Each organisation that receives it names a local owner for its copy, and the owners work together.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-046 A platform team as data custodian", kind: "ex", ref: "EX-046", n: 0, t: "Data sits on a managed platform. The platform team gives technical support, the business owner stays accountable and the steward manages the day-to-day.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-047 The owner is accountable for how published data is licensed", kind: "ex", ref: "EX-047", n: 0, t: "A department publishes data under a licence. The owner makes sure permitted uses are clear, compliance is watched and requests are handled. Stewards can run the licensing day to day.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-048 Information asset register and catalogue, side by side", kind: "ex", ref: "EX-048", n: 0, t: "The register records accountability, risk, security and compliance. The catalogue adds richer details for finding, accessing and reusing data, and can show ownership and classification taken from the register.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-049 When a catalogue can replace the register", kind: "ex", ref: "EX-049", n: 0, t: "A catalogue can replace an information asset register only if it also does the register's governance and assurance job.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-050 A quality process with a different name", kind: "ex", ref: "EX-050", n: 0, t: "A department uses its own quality process. It identifies critical data, sets rules, assesses quality, sets priorities, fixes root causes, reports and measures again.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-051 Work that has started but is not finished", kind: "ex", ref: "EX-051", n: 0, t: "A catalogue entry, role assignment, quality plan or discoverability route is being put in place. ""In development"" does not fit work that has not started.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-052 Keep free text short and not sensitive", kind: "ex", ref: "EX-052", n: 0, t: "Exceptions, dependencies, risks, next steps and evidence references can be summarised briefly. Long narrative, personal data and detailed quality rules belong in your own systems.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-058 An oversight body's quality programme, started with one asset", kind: "ex", ref: "EX-058", n: 0, t: "An arm's length body began with its most critical casework data: it set quality rules, used a repeatable assessment, gave actions owners and checked progress at its governance meetings. The organisation reports a large fall in errors in key reporting.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-059 Wrong case details after a system move", kind: "ex", ref: "EX-059", n: 0, t: "Case classifications were mapped wrongly when old data moved into a new system. The team traced it to the migration logic, corrected the records in bulk and reported assurance.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-060 Outcomes recorded inconsistently", kind: "ex", ref: "EX-060", n: 0, t: "Inconsistent outcomes had several causes: data pipelines, screen design and unclear guidance. Operational, analytical and technical staff worked together on targeted actions and a dashboard for senior oversight.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-061 Quality evidence that made the case for a new system", kind: "ex", ref: "EX-061", n: 0, t: "The business knew a system had problems but could not show them. A structured assessment and root-cause evidence supported a successful business case to replace it.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-062 A department and its agency pilot a quality framework", kind: "ex", ref: "EX-062", n: 0, t: "After an audit, a department set up ownership roles, a repeatable quality framework and a pilot with one of its agencies. Critical data, rules and tolerances are held centrally, measured daily and shown on dashboards for each role.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-063 Owner, steward and engineer in a quality model", kind: "ex", ref: "EX-063", n: 0, t: "The owner sets direction and escalates. The steward identifies critical data, writes rules, watches the measures and drives fixes. Engineers and custodians build the technical controls.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-074 Confirm roles without naming people", kind: "ex", ref: "EX-074", n: 0, t: "The return asks, Yes or No, whether an owner and a steward are assigned. Names, handovers and successors stay in your own records.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-077 One row per asset, not per recipient", kind: "ex", ref: "EX-077", n: 0, t: "Different agreements, recipients or criteria do not make different assets. Several purpose numbers go in one field, and recipient details stay in your own records.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-078 Critical because another organisation depends on it", kind: "ex", ref: "EX-078", n: 0, t: "The organisation that holds an asset may not see it as one of its most critical, but another public body depends on it for an essential purpose. That dependency is evidence of value across government.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-079 A stable repository reference instead of a catalogue number", kind: "ex", ref: "EX-079", n: 0, t: "Authoritative metadata exists but has no catalogue record number. A local identifier, record title or repository-and-entry reference works if it finds the record.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-080 A new release is not a new row", kind: "ex", ref: "EX-080", n: 0, t: "Assets that roll forward use one current update status, not a row for every release or period.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-004 A vehicle data set and the API that serves it", kind: "ex", ref: "EX-004", n: 0, t: "A vehicle data set supports public services and is offered through an open enquiry API. Which is reported?", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-005 Homelessness case data with credible future reuse", kind: "ex", ref: "EX-005", n: 0, t: "Case-management data is not shared yet, but could support benefits, health and justice work.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-006 Fraud intelligence enriched from company records", kind: "ex", ref: "EX-006", n: 0, t: "Company records are combined with departmental intelligence, matched, improved and risk-scored.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-007 A fraud risk score managed as its own product", kind: "ex", ref: "EX-007", n: 0, t: "A risk score is derived from several sources but has its own owner, lifecycle, quality measures and users.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-008 Safeguarding data shared only under strict controls", kind: "ex", ref: "EX-008", n: 0, t: "Personal safeguarding data with a lawful route, defined purpose and controls.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-009 Resettlement programme data", kind: "ex", ref: "EX-009", n: 0, t: "Programme data other public bodies could reuse, only for a defined purpose under an agreement.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-010 Mapping data that is critical but licence-restricted", kind: "ex", ref: "EX-010", n: 0, t: "A geospatial product with high public value, whose onward sharing is limited by its licence.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-011 Commercial reference data", kind: "ex", ref: "EX-011", n: 0, t: "Supplier terms limit reuse of reference data. Does that change reporting?", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-012 Open data that may not be critical", kind: "ex", ref: "EX-012", n: 0, t: "Publishing data openly meets the sharing test, but not the critical-purpose test.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-013 An arm's length body's data", kind: "ex", ref: "EX-013", n: 0, t: "How the department brings together coverage while keeping clear which body is accountable.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-014 Address data and the geospatial field", kind: "ex", ref: "EX-014", n: 0, t: "Which address and location standards to record, beyond the property reference number.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-015 Mapping licensed under the public sector agreement", kind: "ex", ref: "EX-015", n: 0, t: "Recording the licence holder and onward-sharing limits.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-016 A geospatial layer used exactly as supplied", kind: "ex", ref: "EX-016", n: 0, t: "A team uses an external layer as supplied and does not manage it.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-017 Keeping richer local geospatial metadata", kind: "ex", ref: "EX-017", n: 0, t: "Local fields beyond the minimum.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-018 Material above OFFICIAL", kind: "ex", ref: "EX-018", n: 0, t: "Testing the security gate with material classified above OFFICIAL.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-019 OFFICIAL-SENSITIVE operational data", kind: "ex", ref: "EX-019", n: 0, t: "Whether the sensitive marking ends the assessment.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-020 Data shared under an umbrella agreement", kind: "ex", ref: "EX-020", n: 0, t: "What the metadata must show when an umbrella agreement covers the sharing.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-021 Corporate data held under a commercial licence", kind: "ex", ref: "EX-021", n: 0, t: "Data an organisation owns versus data it only holds under supplier terms.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-022 A decision route through the four principles", kind: "ex", ref: "EX-022", n: 0, t: "Stop at the first clear no, and keep the reason.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-023 A decision route for sharing", kind: "ex", ref: "EX-023", n: 0, t: "Current sharing, open publication, potential sharing under controls, or private-sector use only.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-024 A decision route for third-party data", kind: "ex", ref: "EX-024", n: 0, t: "Used as supplied, a governed copy, materially enriched, or licence-restricted.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-025 A decision route for security classification", kind: "ex", ref: "EX-025", n: 0, t: "Which classifications stop the route, and which continue to the normal tests.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-053 A team says it has no critical data", kind: "ex", ref: "EX-053", n: 0, t: "How a coordinator re-tests the claim.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-054 Nobody is clearly accountable", kind: "ex", ref: "EX-054", n: 0, t: "Recording and escalating an ownership gap.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-055 No catalogue yet", kind: "ex", ref: "EX-055", n: 0, t: "An interim record of where metadata lives, and a plan for the gaps.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-056 Discovering legacy social care data without inventing evidence", kind: "ex", ref: "EX-056", n: 0, t: "Recording unknowns honestly in a bounded discovery.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-064 Transport services as candidates", kind: "ex", ref: "EX-064", n: 0, t: "Service importance alone does not settle scope.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-065 Systems of record, not every service view", kind: "ex", ref: "EX-065", n: 0, t: "Reporting coherent source assets rather than each service or system.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-066 Data that could support grant eligibility", kind: "ex", ref: "EX-066", n: 0, t: "Potential use by another organisation for eligibility checks.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-067 A department coordinating its agencies' returns", kind: "ex", ref: "EX-067", n: 0, t: "Agencies prepare their lists; the department coordinates.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-068 A local quality process that differs from the template", kind: "ex", ref: "EX-068", n: 0, t: "Meeting the intent of a quality plan in a different form.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-071 Weather data as a third-party example", kind: "ex", ref: "EX-071", n: 0, t: "Third-party origin, commercial terms and public-sector use.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-072 Mapping data as a third-party example", kind: "ex", ref: "EX-072", n: 0, t: "Third-party and commercial constraints.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-073 A local identifier when there is no catalogue number", kind: "ex", ref: "EX-073", n: 0, t: "A stable local key for the identifier field.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-075 Fields that apply only sometimes", kind: "ex", ref: "EX-075", n: 0, t: "When to fill the conditional fields.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Example", title: "EX-076 When a check rejects a true answer", kind: "ex", ref: "EX-076", n: 0, t: "Logging the problem rather than changing the answer.", flag: "New", ic: Icon.LevelsLayersItems, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1)},
  {type: "Glossary", title: "Arm's length body", kind: "glo", ref: "Arm's length body", n: 0, t: "An organisation that is part of government but works at a distance from its department, such as an executive agency.", flag: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "Baseline Return", kind: "glo", ref: "Baseline Return", n: 0, t: "The first list of critical data assets each organisation sends to GDS.", flag: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "Chief data officer", kind: "glo", ref: "Chief data officer", n: 0, t: "The most senior person in charge of data in an organisation. Responsible for putting the policy into practice there.", flag: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "Chief Data Officer Council", kind: "glo", ref: "Chief Data Officer Council", n: 0, t: "The group of chief data officers that oversees how the policy is put into practice across government.", flag: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "Critical data asset", kind: "glo", ref: "Critical data asset", n: 0, t: "A data asset that is OFFICIAL, serves at least one of seven critical purposes, has value across government through sharing, and that your organisation is accountable for. Called an Essential Shared Data Asset (ESDA) before the DAM Policy.", flag: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "Critical purpose", kind: "glo", ref: "Critical purpose", n: 0, t: "One of seven reasons that make shared data critical, numbered 1 to 7 in the guidance, such as delivering public services.", flag: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "CSV file", kind: "glo", ref: "CSV file", n: 0, t: "A simple file for table data that any spreadsheet program can open and save.", flag: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "DAM", kind: "glo", ref: "DAM", n: 0, t: "Data Asset Management, the government policy this app is about.", flag: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "Data asset", kind: "glo", ref: "Data asset", n: 0, t: "One or more data sets, plus any data services used to reach them.", flag: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "Data catalogue", kind: "glo", ref: "Data catalogue", n: 0, t: "A list that describes the data an organisation holds, so people can find it.", flag: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "Data custodian", kind: "glo", ref: "Data custodian", n: 0, t: "The team that runs the systems where data is kept, on behalf of the data owner.", flag: "New", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "Data owner", kind: "glo", ref: "Data owner", n: 0, t: "The person named as accountable for decisions about a data asset.", flag: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "Data protection officer", kind: "glo", ref: "Data protection officer", n: 0, t: "The person in an organisation who makes sure personal data is handled lawfully.", flag: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "Data quality action plan", kind: "glo", ref: "Data quality action plan", n: 0, t: "A plan for keeping a data asset accurate and complete enough to use. Often shortened to DQAP.", flag: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "Data service", kind: "glo", ref: "Data service", n: 0, t: "Something that gives controlled access to one or more data sets, such as an API.", flag: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "Data set", kind: "glo", ref: "Data set", n: 0, t: "A structured collection of data chosen to meet a defined need. It can be part of a larger system.", flag: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "Data steward", kind: "glo", ref: "Data steward", n: 0, t: "The person who looks after a set of data day to day.", flag: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "DCAT", kind: "glo", ref: "DCAT", n: 0, t: "Data Catalogue Vocabulary, an open standard for describing data sets and data services. The metadata guidance recommends it.", flag: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "ESDA", kind: "glo", ref: "ESDA", n: 0, t: "Essential Shared Data Asset, the earlier name for a critical data asset. The return asks for your reference from the ESDA exercise.", flag: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "GDS", kind: "glo", ref: "GDS", n: 0, t: "The Government Digital Service, which runs the Data Asset Management programme.", flag: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "Information asset owner", kind: "glo", ref: "Information asset owner", n: 0, t: "The person accountable for managing, securing and complying with rules about an information asset. The role continues alongside the data owner.", flag: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "Information asset register", kind: "glo", ref: "Information asset register", n: 0, t: "A governance record of information assets, their owners (information asset owners), risks and controls.", flag: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "Legal gateway", kind: "glo", ref: "Legal gateway", n: 0, t: "The law or agreement that allows data to be shared.", flag: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "Metadata", kind: "glo", ref: "Metadata", n: 0, t: "Information that describes data: what it is, who owns it, where it comes from and how it can be used.", flag: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "Metadata minimum", kind: "glo", ref: "Metadata minimum", n: 0, t: "The smallest set of details to record about each critical data asset. It is a floor, not a ceiling: keep any other fields you need.", flag: "New", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "OFFICIAL", kind: "glo", ref: "OFFICIAL", n: 0, t: "The lowest of the government's security classifications. Most government data is OFFICIAL.", flag: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "Performance Framework", kind: "glo", ref: "Performance Framework", n: 0, t: "A quarterly GDS commission on departments' digital and data capability. It asks for counts, not lists, of critical data assets.", flag: "New", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "Policy gap", kind: "glo", ref: "Policy gap", n: 0, t: "Something the policy expects that is not in place yet, such as an asset with no data owner. A gap is not a mistake: GDS accepts it and uses it to decide where to help.", flag: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "Scope principles", kind: "glo", ref: "Scope principles", n: 0, t: "The four DAM Policy principles that decide whether an asset is in scope: critical criterion, shared, accountable, and prioritise the source.", flag: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "System of record", kind: "glo", ref: "System of record", n: 0, t: "The system that holds the authoritative version of some data. Copies and services built on it point back to it.", flag: "New", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "Worked example", kind: "glo", ref: "Worked example", n: 0, t: "A real kind of data used to show how the policy applies: whether it is in scope and how to fill in the return.", flag: "New", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)},
  {type: "Glossary", title: "XG_CDA", kind: "glo", ref: "XG_CDA", n: 0, t: "The label GDS recommends for marking assets that are in scope of the DAM Policy in your data catalogue.", flag: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1)}
);
