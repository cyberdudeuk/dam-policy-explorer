// DAM Policy Explorer content. Generated by tools/powerapp.py from the web explorer's source. Do not edit by hand.
nfCW = Min(App.Width - 64, 2360);
nfCX = (App.Width - nfCW) / 2;
nfRW = Min(App.Width - 64, 1520);
nfRX = (App.Width - nfRW) / 2;
nfWide = App.Width >= 1800;
nfNavH = If(nfWide, 0, 120);
nfPad = Max(0, nfCX - 32);
nfCols = If(App.Width >= 2200, 3, App.Width >= 1280, 2, 1);
nfCols2 = If(App.Width >= 1800, 2, 1);
nfCompact = App.Width < 1280;
nfDesign = App.Width = 640 && App.Height = 1136;
nfShort = App.Height < 1100;
nfTiny = App.Width < 720;
nfTiles = nfCompact || (nfShort && !nfWide);
nfVersion = "1.2.0";
nfChecked = "2026-11-18";
nfSite = "https://cyberdudeuk.github.io/dam-policy-explorer/";
nfBaseVer = "1.1.0";
nfNotes = "Worked examples: 71 cases you can search and filter by topic, outcome and status, 35 of them agreed. From the community forum and coordinators' questions: a practical kit for data owners and stewards, a briefing outline for arm's length bodies, answers on the Performance Framework, the metadata minimum, standards for new services, and arm's length bodies nobody has contacted. Track and analyse: record where your return has got to, see what you sent and how ready each asset is, and the measures GDS will report. Assets you are not sure about are now included provisionally and flagged. Contact by Microsoft Form. Version 3 of the return template confirmed.";
nfPages = Table(
  {id: "policy", short: "The policy", title: "The policy in plain English", sec: 1, summ: "What the policy asks, who it applies to and who does what", n: 11, flag: "Updated"},
  {id: "return", short: "Your return", title: "Make your organisation’s data asset return", sec: 3, summ: "The twelve steps of the Baseline Return", n: 7, flag: ""},
  {id: "track", short: "Track your return", title: "Track your return, and see what it shows", sec: 3, summ: "What happens after you send it, and what it shows", n: 5, flag: ""},
  {id: "people", short: "Roles and journeys", title: "Roles and journeys", sec: 1, summ: "Who does what, by role", n: 10, flag: ""},
  {id: "capabilities", short: "Capabilities", title: "The capabilities behind the policy", sec: 1, summ: "The capabilities behind the policy", n: 8, flag: ""},
  {id: "embed", short: "Embed it", title: "Make the policy part of how you work", sec: 3, summ: "Make the policy part of how you work", n: 7, flag: "Updated"},
  {id: "resources", short: "Resources", title: "Resources", sec: 4, summ: "Templates, guidance and playbooks", n: 3, flag: ""},
  {id: "guide", short: "User guide", title: "User guide, and how to get the explorer in your organisation", sec: 5, summ: "How to use the explorer, and how to get it in your organisation", n: 10, flag: "New"},
  {id: "ask", short: "Ask a question", title: "Ask a question", sec: 5, summ: "How to ask, and what happens next", n: 3, flag: "Updated"},
  {id: "team", short: "For the GDS team", title: "Process returns and answer questions", sec: 6, summ: "Process returns and answer questions", n: 7, flag: ""},
  {id: "about", short: "About this app", title: "About the DAM Policy Explorer", sec: 5, summ: "Sources, method, versions and roadmap", n: 12, flag: "Updated"},
  {id: "accessibility", short: "Accessibility", title: "Accessibility and inclusion", sec: 5, summ: "Accessibility and inclusion statement", n: 6, flag: ""}
);
nfSections = Table(
  {pid: "policy", n: 1, h: "Overview", x: "<p>The Data Asset Management Policy asks government organisations to find, describe and look after the data they share with each other. GDS published it on 27 May 2026.</p> <p> This page explains the policy. It does not replace it. <a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Read the policy on GOV.UK</a>.</p>", flag: ""},
  {pid: "policy", n: 2, h: "Why it exists", x: "<p>Government relies on data that passes between organisations. When nobody knows what that data is, who owns it or how good it is, services and decisions suffer. The policy sets a minimum standard for quality, discoverability, interoperability and clear ownership. <b>[Policy]</b> </p>", flag: ""},
  {pid: "policy", n: 3, h: "Who it applies to", x: "<p><b>Who the policy applies to</b></p><p><b>Government departments</b></p><ul><li><b>Applies?:</b> <b>[Must]</b> </li></ul><p><b>Arm's length bodies: executive agencies, non-departmental public bodies, non-ministerial departments</b></p><ul><li><b>Applies?:</b> <b>[Must]</b> </li></ul><p><b>Public corporations</b></p><ul><li><b>Applies?:</b> <b>[Optional]</b> </li></ul><p><b>Local government</b></p><ul><li><b>Applies?:</b> <b>[Optional]</b> </li></ul><p><b>Devolved governments</b></p><ul><li><b>Applies?:</b> <b>[Use their own data sharing governance]</b> </li></ul> <p>Source: <a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy in government (GOV.UK)</a></p>", flag: ""},
  {pid: "policy", n: 4, h: "What you must do", x: "<ul><li><h3>Find and record your data assets</h3><p>Identify the data assets in scope, manage <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-metadata"">metadata</a> about them in your <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-data-catalogue"">data catalogue</a>, and report them to GDS.</p><p>Section 4 of the policy <b>[Policy]</b> </p></li><li><h3>Departments coordinate their arm's length bodies</h3><p>Send metadata on your own assets, and coordinate and assure the returns from your arm's length bodies.</p><p>Section 4 of the policy <b>[Policy]</b> </p></li><li><h3>Name an owner for every asset</h3><p>Every identified data asset must have a named <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-data-owner"">data owner</a>, accountable for decisions about it.</p><p>Section 5 of the policy <b>[Policy]</b> </p></li><li><h3>Plan for quality</h3><p>Every identified data asset must have a <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-dqap"">data quality action plan</a> or equivalent.</p><p>Section 6 of the policy <b>[Policy]</b> </p></li><li><h3>Keep it up to date</h3><p>Maintain what you send and review it every year.</p><p>Section 4 of the policy <b>[Policy]</b> </p></li><li><h3>Your chief data officer is responsible</h3><p>The chief data officer of each organisation in scope is responsible for putting the policy into practice there.</p><p>Section 8 of the policy <b>[Policy]</b> </p></li></ul>", flag: ""},
  {pid: "policy", n: 5, h: "What counts as a critical data asset", x: "<p>First, the data must be <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-official"">OFFICIAL</a>. SECRET and TOP SECRET data is not in scope. <b>[Policy]</b> </p> <p>Then all four DAM Policy scope principles must apply. <b>[GDS position]</b> </p> <ol> <li><b>It meets a critical criterion.</b> It supports at least one of seven critical purposes.</li> <li><b>It is shared.</b> It has value across government through reuse: shared under a data sharing agreement, published as open data, or could create value if shared.</li> <li><b>You are accountable for it.</b> You manage or control it, including others' data you have materially changed or enriched.</li> <li><b>It is the source.</b> Report the source data behind a critical extract, report or API.</li> </ol> <p><b>The seven critical purposes</b></p><ol><li>Delivering public services</li><li>A legislative, legal or contractual requirement</li><li>Defence, national security and resilience</li><li>Developing and evaluating policy</li><li>Official statistics</li><li>The public interest</li><li>Fraud and error</li></ol> <p><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/asset-test.html""> Test a possible asset</a></p> <p>Source: <a href=""https://www.gov.uk/government/publications/identify-and-record-critical-data-assets/identifying-and-recording-critical-data-assets"">Identifying and recording critical data assets (GOV.UK)</a>; GDS DAM Policy FAQs, November 2026</p>", flag: ""},
  {pid: "policy", n: 6, h: "What the policy does not do", x: "<ul><li>It does not make you share data.</li><li>It does not remove any legal obligation you already have.</li><li>It does not promise that data will be available, or of a given quality, beyond what is already agreed.</li></ul> <p>Source: <a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy in government (GOV.UK)</a></p>", flag: ""},
  {pid: "policy", n: 7, h: "Myths and facts", x: "<ul><li><p>Myth Listing data means we have to share it.</p><p>Fact No. The policy does not create a duty to share data or remove any legal obligation. <b>[Policy]</b> </p></li><li><p>Myth We have to report every data asset we hold.</p><p>Fact No. Only critical data assets, as the policy defines them, go in the return. <b>[GDS position]</b> </p></li><li><p>Myth Data owners replace information asset owners.</p><p>Fact No. Information asset owners keep their role. The data owner role adds to it. <b>[Policy]</b> </p></li><li><p>Myth We need to buy a particular catalogue product.</p><p>Fact No. The policy does not name a product. Use what you have. <b>[Policy]</b> </p></li><li><p>Myth The return needs the names of our data owners.</p><p>Fact No. It asks only whether each role is assigned. Keep names in your own records. <b>[GDS position]</b> </p></li><li><p>Myth The return is our data catalogue.</p><p>Fact No. The return asks for a smaller, separate set of details. Your full metadata stays in your own catalogue. <b>[GDS position]</b> </p></li><li><p>Myth If a field is not in the return, we can stop collecting it.</p><p>Fact No. The minimum is a floor, not a ceiling. Keep the fields your organisation needs. <b>[GDS position]</b> </p></li><li><p>Myth SECRET data has to be listed somewhere.</p><p>Fact No. Only OFFICIAL data is in scope. <b>[Policy]</b> </p></li><li><p>Myth Anything not fully in place means we fail.</p><p>Fact No. The first return sets a baseline to improve from. Report your real position, including what is planned or in development. <b>[GDS position]</b> </p></li></ul> <p>Source: <a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy in government (GOV.UK)</a>; GDS DAM Policy FAQs, November 2026</p>", flag: "Updated"},
  {pid: "policy", n: 8, h: "From requirement to capability", x: "<p>Each requirement rests on a capability your organisation needs. The <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/capabilities.html"">capabilities page</a> shows all 32 and links to a playbook for each.</p> <ol><li>Identify and report critical data assets (section 4)→<a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/cataloguing.html"">CR-05 Identify and scope critical data assets</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/governance.html"">CR-03 Central reporting, assurance and arm's length body coordination</a></li><li>Manage metadata in your data catalogue (section 4)→<a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/cataloguing.html"">CR-06 Data cataloguing and metadata management</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/cataloguing.html"">CR-11 Interoperability, data standards and identifiers</a></li><li>A named data owner for every asset (section 5)→<a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/governance.html"">CR-07 Data ownership and stewardship</a></li><li>A data quality action plan or equivalent (section 6)→<a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/quality.html"">CR-08 Data quality management through action plans</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/quality.html"">CR-09 Data quality issue management</a></li><li>Review every year (section 4)→<a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/governance.html"">CR-04 Performance measurement and annual review</a></li><li>The chief data officer is responsible (section 8)→<a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/governance.html"">CR-01 Accountable leadership and policy oversight</a></li></ol>", flag: ""},
  {pid: "policy", n: 9, h: "Who does what", x: "<p><b>Roles and responsibilities</b></p><p><b>Chief data officer</b></p><ul><li><b>What they do:</b> Responsible for putting the policy into practice in the organisation. Names a coordinator and signs off the return.</li><li><b>Where this comes from:</b> <b>[Policy]</b> <a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">source</a></li></ul><p><b>Coordinator</b></p><ul><li><b>What they do:</b> Runs the return day to day: gathers the list, works with owners and stewards, checks the returns from arm's length bodies.</li><li><b>Where this comes from:</b> <b>[Programme plan]</b> </li></ul><p><b>Data owner</b></p><ul><li><b>What they do:</b> Named for each asset and accountable for decisions about it, including its quality plan.</li><li><b>Where this comes from:</b> <b>[Policy]</b> <a href=""https://www.gov.uk/government/publications/data-ownership-in-government/data-ownership-model"">source</a></li></ul><p><b>Data steward</b></p><ul><li><b>What they do:</b> Looks after the data day to day and fills in its details.</li><li><b>Where this comes from:</b> <b>[Suggested practice]</b> </li></ul><p><b>Department</b></p><ul><li><b>What they do:</b> Sends its own return, and coordinates and assures the returns from its arm's length bodies.</li><li><b>Where this comes from:</b> <b>[Policy]</b> <a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">source</a></li></ul><p><b>Chief Data Officer Council</b></p><ul><li><b>What they do:</b> Oversees how the policy is put into practice across government.</li><li><b>Where this comes from:</b> <b>[Policy]</b> <a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">source</a></li></ul><p><b>Minister for Digital Government and Data</b></p><ul><li><b>What they do:</b> Writes to ministers each year on progress.</li><li><b>Where this comes from:</b> <b>[Policy]</b> <a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">source</a></li></ul><p><b>GDS</b></p><ul><li><b>What they do:</b> Publishes the guidance, receives the returns, offers support targeted by maturity, and is developing a service to make asset metadata discoverable.</li><li><b>Where this comes from:</b> <b>[Policy]</b> <a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">source</a></li></ul>", flag: ""},
  {pid: "policy", n: 10, h: "The guidance that goes with it", x: "<ul><li><a href=""https://www.gov.uk/government/publications/identify-and-record-critical-data-assets/identifying-and-recording-critical-data-assets"">Identifying and recording critical data assets</a></li><li><a href=""https://www.gov.uk/government/publications/record-metadata-to-describe-critical-data-assets/recording-metadata-to-describe-critical-data-assets"">Recording metadata to describe critical data assets</a></li><li><a href=""https://www.gov.uk/government/publications/data-ownership-in-government/data-ownership-model"">Data ownership model</a></li><li><a href=""https://www.gov.uk/government/publications/implement-a-data-quality-action-plan/data-quality-action-plan-implementation-guide"">Data quality action plan: implementation guide</a></li><li><a href=""https://www.gov.uk/government/publications/implement-a-data-quality-action-plan/data-quality-issues-framework"">Data quality issues framework</a></li><li><a href=""https://www.gov.uk/government/publications/the-government-data-quality-framework"">The Government Data Quality Framework</a></li></ul>", flag: ""},
  {pid: "policy", n: 11, h: "What GDS offers", x: "<ul><li>Published guidance and standards, including the data quality action plan guide and the data quality issues framework.</li><li>Support targeted at organisations' different levels of data maturity and resources, starting with assets that are proven to be reused.</li><li>A service, being developed, to make data asset metadata easy to find across government.</li></ul> <p>Source: <a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy in government (GOV.UK)</a></p>", flag: ""},
  {pid: "return", n: 1, h: "Overview", x: "Make your organisation’s data asset return <p>Four parts and twelve steps, from getting ready to sending your list to GDS (the Government Digital Service). Each step says who does it, what you need and what you end up with.</p> <p> <b>When:</b> GDS plans to collect the first return, called the Baseline Return, in January 2027. Aim to be ready by Friday 18 December 2026, before the Christmas break.</p> <p>The January date comes from the programme plan. It is not yet written in the published policy, so check with us before you rely on it.</p> <p> <b>Help:</b> <a href=""https://forms.cloud.microsoft/e/SLBvuPX7jK"">use our contact form</a>.</p>", flag: ""},
  {pid: "return", n: 2, h: "What do I need to do?", x: "<p>Four parts, in order. Choose a step to open it. At the end of each step there is a link to the next one.</p> <ol><li><h3>1. Get ready</h3><ul><li>1. Name who is in charge</li><li>2. Agree who owns your data</li></ul></li><li><h3>2. Make your list</h3><ul><li>3. Start a list of possible assets</li><li>4. Check each one against the scope principles</li><li>5. Agree the list across your organisation</li><li>6. Name an owner and a steward for each asset</li><li>7. Fill in the 24 details</li><li>8. Link a data quality plan</li></ul></li><li><h3>3. Check and send</h3><ul><li>9. Check the returns from organisations that report to you</li><li>10. Sign off and send</li></ul></li><li><h3>4. Keep it up to date</h3><ul><li>11. Keep it current</li><li>12. Share what you learned</li></ul></li></ol>", flag: ""},
  {pid: "return", n: 3, h: "The twelve steps", x: "<h3>Get ready</h3><ol><li><p><b>1. Name who is in charge</b></p> <p>Your takes charge of the return. They name a coordinator and give them time to do the work.</p><p><b>Who does this</b></p><p>Your chief data officer leads. This is the most senior person in charge of data. The coordinator does the day-to-day work.</p><p><b>What you need</b></p><p><p>Your organisation chart, and a list of the organisations that report to your department (often called ).</p></p><p><b>What you end up with</b></p><p>A person in charge, a coordinator, and a list of everyone who needs to take part.</p> <p>Based on: <a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy (opens GOV.UK)</a></p><p>Next: 2. Agree who owns your data →</p></li><li><p><b>2. Agree who owns your data</b></p> <p>Agree how you will decide who owns each set of data. Then take it to your board (the senior group that runs your organisation).</p><p><b>Who does this</b></p><p>Your chief data officer, with your senior information risk owner (the person responsible for information risk).</p><p><b>What you need</b></p><p><p>The <a href=""https://www.gov.uk/government/publications/data-ownership-in-government/data-ownership-model"">data ownership model (opens GOV.UK)</a>.</p></p><p><b>What you end up with</b></p><p>An agreed way of naming owners. Where two people seem responsible for the same data, one of them is chosen.</p> <p>Based on: <a href=""https://www.gov.uk/government/publications/data-ownership-in-government/data-ownership-model"">Data ownership model (opens GOV.UK)</a></p><p>Next: 3. Start a list of possible assets →</p></li></ol><h3>Make your list</h3><ol><li><p><b>3. Start a list of possible assets</b></p> <p>Gather what you already know about. You do not need to start from nothing.</p><p><b>Who does this</b></p><p>Your coordinator.</p><p><b>What you need</b></p><p><p>Use any lists you already have. GDS has made a starter list for each group of organisations: <a href=""https://forms.cloud.microsoft/e/SLBvuPX7jK"">ask us for yours</a>. You may also have a list of your information, a or data sharing agreements. Include data you get from others, and data that suppliers hold for you.</p></p><p><b>What you end up with</b></p><p>A list of possible assets to test in the next step.</p> <p>Based on: <a href=""https://www.gov.uk/government/publications/identify-and-record-critical-data-assets/identifying-and-recording-critical-data-assets"">Identifying and recording critical data assets (opens GOV.UK)</a></p><p>Next: 4. Check each one against the scope principles →</p></li><li><p><b>4. Check each one against the scope principles</b></p> <p>An asset goes in the return only if it is <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-official"">OFFICIAL</a> and all four DAM Policy scope principles apply. Write down your answer to each one. The <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/asset-test.html"">asset test</a> walks you through them.</p><p><b>Who does this</b></p><p>Your coordinator, with the people who know each set of data.</p><p><b>What you need</b></p><p><p><b>First, it is OFFICIAL.</b> OFFICIAL with markings such as sensitive counts. SECRET and TOP SECRET do not go in.</p><p>Then the four principles:</p><ol><li><b>It meets a critical criterion.</b> It supports at least one of seven critical purposes, numbered 1 to 7: <ol><li>delivering public services</li><li>a legal, legislative or contractual requirement</li><li>defence, national security and resilience</li><li>developing and evaluating policy</li><li>official statistics</li><li>the public interest</li><li>fraud and error</li></ol></li><li><b>It is shared.</b> It has value across government through reuse: it is shared with a public sector organisation under a data sharing agreement, published as open data, or could create value if shared. For the Baseline Return, start with assets that are already shared or published.</li><li><b>You are accountable for it.</b> Your organisation manages or controls it. Data from someone else counts only if you have materially changed or enriched it.</li><li><b>It is the source.</b> If an extract, report, API or other product is critical, report the source data behind it, even if the source itself is never shared. Report a product separately only if it is managed and owned in its own right.</li></ol><p>For official statistics, include the data behind them (the administrative data, surveys and censuses), not the published figures.</p></p><p><b>What you end up with</b></p><p>An answer to each test, for each possible asset. Anything with a “no” goes on your list of assets left out, with the reason. In the workbook, the security marking (column M) shows the OFFICIAL check and the critical purpose numbers (column J) show the first principle.</p> <p>Based on: <a href=""https://www.gov.uk/government/publications/identify-and-record-critical-data-assets/identifying-and-recording-critical-data-assets"">Identifying and recording critical data assets (opens GOV.UK)</a>, <a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy (opens GOV.UK)</a> and the GDS DAM Policy FAQs (November 2026).</p><p>Next: 5. Agree the list across your organisation →</p></li><li><p><b>5. Agree the list across your organisation</b></p> <p>Check the list with each part of your organisation.</p><p><b>Who does this</b></p><p>Your coordinator, with your (the person who makes sure personal data is handled lawfully).</p><p><b>What you need</b></p><p><p>The list from step 4.</p></p><p><b>What you end up with</b></p><p>An agreed list. Your data protection officer confirms that listing an asset does not create any new sharing or use of the data.</p> <p>Based on: <a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy (opens GOV.UK)</a></p><p>Next: 6. Name an owner and a steward for each asset →</p></li><li><p><b>6. Name an owner and a steward for each asset</b></p> <p>Each asset needs an owner and a . The owner agrees in writing. The steward looks after the data day to day.</p><p><b>Who does this</b></p><p>Data owners, with your coordinator.</p><p><b>What you need</b></p><p><p>Who each asset goes to and comes from.</p></p><p><b>What you end up with</b></p><p>An owner and a steward for each asset. Keep their names in your own records. The return only asks whether each one is assigned, Yes or No. It does not record names or email addresses.</p> <p>Based on: <a href=""https://www.gov.uk/government/publications/data-ownership-in-government/data-ownership-model"">Data ownership model (opens GOV.UK)</a></p><p>Next: 7. Fill in the 24 details →</p></li><li><p><b>7. Fill in the 24 details</b></p> <p>Describe each asset in plain English in the version 3 Baseline Return workbook. It asks for 24 details. Some must always be filled in, some only when they apply.</p><p><b>Who does this</b></p><p>Stewards, and whoever manages your <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-data-catalogue"">data catalogue</a>.</p><p><b>What you need</b></p><p><p>Your data catalogue, if you have one. This is a list that describes your data. You can copy details from it rather than typing them again.</p></p><p><b>What you end up with</b></p><p>The 24 details for each asset. Where the workbook has a list of answers, choose from it. See all 24 details.</p> <p>Based on: <a href=""https://www.gov.uk/government/publications/record-metadata-to-describe-critical-data-assets/recording-metadata-to-describe-critical-data-assets"">Recording metadata to describe critical data assets (opens GOV.UK)</a> and the version 3 Baseline Return workbook.</p><p>Next: 8. Link a data quality plan →</p></li><li><p><b>8. Link a data quality plan</b></p> <p>Each asset needs a plan to keep its data good enough to use. It also needs a date to look at it again.</p><p><b>Who does this</b></p><p>Data owners.</p><p><b>What you need</b></p><p><p>The <a href=""https://www.gov.uk/government/publications/implement-a-data-quality-action-plan/data-quality-action-plan-implementation-guide"">data quality action plan guide (opens GOV.UK)</a>. You may already have tools, processes or resources you can use.</p></p><p><b>What you end up with</b></p><p>The status of each asset’s quality plan (column T) and, if you have it, where the evidence is kept (column U). A gap is accepted, but the asset is not counted as ready until a plan is in place.</p> <p>Based on: <a href=""https://www.gov.uk/government/publications/implement-a-data-quality-action-plan/data-quality-action-plan-implementation-guide"">Data quality action plan guide (opens GOV.UK)</a></p><p>Next: 9. Check the returns from organisations that report to you →</p></li></ol><h3>Check and send</h3><ol><li><p><b>9. Check the returns from organisations that report to you</b></p> <p>Departments only: check what the organisations that report to you have done before everything goes to GDS.</p><p><b>Who does this</b></p><p>Your department’s coordinator.</p><p><b>What you need</b></p><p><p>The returns from each organisation that reports to your department.</p></p><p><b>What you end up with</b></p><p>One view of what is ready, what has gaps and what still needs fixing.</p> <p>Based on: <a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy (opens GOV.UK)</a></p><p>Next: 10. Sign off and send →</p></li><li><p><b>10. Sign off and send</b></p> <p>Your chief data officer signs off the return. Your coordinator fills in the Baseline Return workbook (version 3) and emails it to the team.</p><p><b>Who does this</b></p><p>Your chief data officer and your coordinator.</p><p><b>What you need</b></p><p><p>Your finished list, and the version 3 workbook the team sends you. Use the list check below to find common problems first.</p></p><p><b>What you end up with</b></p><p>A signed-off return, emailed to the team’s shared mailbox. The team gives you the address. You will get a reference number for your return.</p> <p>Based on: <a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy (opens GOV.UK)</a></p><p>Next: 11. Keep it current →</p></li></ol><h3>Keep it up to date</h3><ol><li><p><b>11. Keep it current</b></p> <p>Review your list and its details at least once a year.</p><p><b>Who does this</b></p><p>Data owners and stewards.</p><p><b>What you need</b></p><p><p>This year’s return.</p></p><p><b>What you end up with</b></p><p>An up-to-date list. The workbook does not record the review, so note the date in your own records. Next year, start from this year’s list rather than from nothing.</p> <p>Based on: <a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy (opens GOV.UK)</a></p><p>Next: 12. Share what you learned →</p></li><li><p><b>12. Share what you learned</b></p> <p>Tell GDS how it went and pass on what worked to other organisations.</p><p><b>Who does this</b></p><p>Your chief data officer and coordinator.</p><p><b>What you need</b></p><p><p>Your notes on what was hard and what helped.</p></p><p><b>What you end up with</b></p><p>Lessons that make the next return easier for everyone.</p> <p>Based on: <a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy (opens GOV.UK)</a></p><p>That was the last step. Next: what happens after you send it →</p></li></ol>", flag: ""},
  {pid: "return", n: 4, h: "Is my list ready to send?", x: "<p>This finds the most common problems, so your return can be accepted first time.</p> <p>The check follows the version 3 workbook. First save the workbook’s return sheet as a CSV file.</p> <p>The file check needs JavaScript, which is switched off or blocked in your browser. You can still use the list of checks below to go through your file by hand.</p> <p><b>What the check looks for</b></p><p>Must fix</p><ul><li>The file has all 24 columns of the version 3 template.</li><li>The 13 details that must be filled in are filled in.</li><li>Text fits the length the template allows.</li><li>Yes or No questions say Yes or No.</li><li>The security marking is OFFICIAL or OFFICIAL-SENSITIVE. SECRET and TOP SECRET data does not go in.</li><li>Critical purposes are numbers from 1 to 7, each used once.</li><li>Answers chosen from a list use one of the list’s values, where we have the list.</li><li>An asset recorded “In catalogue” gives its catalogue reference.</li><li>Geospatial standards come from the list, and “Not applicable” stands alone.</li><li>No asset is marked “Out of scope”.</li><li>There are no email addresses, in the return or in your list of assets left out. The return does not record people’s names or contact details.</li><li>The template’s worked example has been deleted.</li><li>No quote mark is left open, which would join rows together.</li></ul><p>We will ask</p><ul><li>An identifier used more than once, written in any mix of capitals. This is allowed only for an approved version or licence variant.</li><li>In your list of assets left out (our suggestion): which test each one failed, and why.</li></ul><p>Policy gap These are accepted. They are not mistakes: they show us where to help.</p><ul><li>No <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-data-owner"">data owner</a> or no <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-data-steward"">data steward</a> assigned yet.</li><li>The asset is not in a data catalogue yet.</li><li>A gap in data quality assurance.</li></ul><p>Tips</p><ul><li>Recommended details are filled in: sharing status, version and discoverability.</li><li>The security marking is written exactly as OFFICIAL or OFFICIAL-SENSITIVE.</li><li>Asset names spell out abbreviations, and no two assets have almost the same name.</li></ul><p>What the check cannot do: it cannot tell whether a detail marked “Fill in if it applies” applies to your asset. For sharing status, access rights, licence, quality status and discoverability, it checks that you answered, but not your answer, because we do not yet have the workbook’s full lists.</p> <p><b>The 24 details, and a blank template</b></p> <p>The return is the version 3 Baseline Return workbook, with one row for each asset. The team sends you the workbook. To use the check on this page, save its return sheet as a CSV file, or start from the blank CSV template below, which has the same 24 headings. If you leave any assets out, we suggest listing them in a second file with the test each one failed and why. This list is our suggestion, not part of the workbook. Write roles, such as “data owner”, not people’s names.</p> <p><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/templates/return-template.csv""> Download the blank list template (CSV)</a> <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/templates/left-out-template.csv""> Download the blank template for assets left out (CSV)</a></p> <p>Keep the heading row of each template exactly as it is.</p> <p>The 24 details, in the workbook’s order (columns A to X), in seven groups. 13 must be filled in, 5 when they apply, 3 are recommended and 3 are optional.</p> <h3>Asset identity</h3><ul> <li><p>A <b>Unique identifier</b> Must be filled in</p><p>Your own reference for the asset. Up to 100 characters. Use it once, unless the row is an approved version or licence variant.</p></li> <li><p>B <b>Data asset name</b> Must be filled in</p><p>A short name people will recognise. Spell out abbreviations. Up to 200 characters.</p></li> <li><p>C <b>Description</b> Must be filled in</p><p>What the data is, in plain English. Between 20 and 2,000 characters.</p></li> </ul> <h3>Organisation and provenance</h3><ul> <li><p>D <b>Owning department / publisher</b> Must be filled in</p><p>The one organisation accountable for the asset. Up to 200 characters.</p></li> <li><p>E <b>ALB / agency</b> Fill in if it applies</p><p>The arm’s length body or agency, if there is one. Up to 200 characters.</p></li> <li><p>F <b>Source / provenance</b> Fill in if it applies</p><p>Where the data comes from. You can summarise several sources in one statement. Up to 1,000 characters.</p></li> </ul> <h3>Accountability</h3><ul> <li><p>G <b>Data owner assigned?</b> Must be filled in</p><p>Yes or No. Do not write the owner’s name. “No” is accepted and recorded as a policy gap.</p></li> <li><p>H <b>Data steward assigned?</b> Must be filled in</p><p>Yes or No. Do not write the steward’s name. “No” is accepted and recorded as a policy gap.</p></li> <li><p>I <b>Stewardship model</b> Optional</p><p>Central, Federated, Distributed, Shared service or Other.</p></li> </ul> <h3>Scope and classification</h3><ul> <li><p>J <b>Critical purpose number(s)</b> Must be filled in</p><p>The numbers of the purposes it serves, from 1 to 7, separated by commas, for example “1, 4”. Use the numbers from the workbook’s list.</p></li> <li><p>K <b>Primary sharing status</b> Recommended</p><p>Choose from the workbook’s list. An asset marked “Out of scope” does not go in the return.</p></li> <li><p>L <b><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-legal-gateway"">Legal gateway</a> / regulatory basis</b> Fill in if it applies</p><p>The law or rule that allows the sharing, if there is one. You can summarise several. Up to 500 characters.</p></li> <li><p>M <b>Security classification / marking</b> Must be filled in</p><p>OFFICIAL or OFFICIAL-SENSITIVE, written exactly like that. SECRET and TOP SECRET data does not go in.</p></li> <li><p>N <b>Contains personal data?</b> Must be filled in</p><p>Yes or No.</p></li> <li><p>O <b>Source-asset access rights</b> Must be filled in</p><p>Choose one category from the workbook’s list.</p></li> </ul> <h3>Licence and version</h3><ul> <li><p>P <b>Primary licence / usage basis</b> Must be filled in</p><p>Choose from the workbook’s list. If no one basis is the main one, choose “Multiple / varies”.</p></li> <li><p>Q <b>Asset version / update status</b> Recommended</p><p>The current version, or how often it is updated. Up to 100 characters.</p></li> </ul> <h3>Data management</h3><ul> <li><p>R <b><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-metadata"">Metadata</a> recorded in catalogue?</b> Must be filled in</p><p>In catalogue, Planned or Not in catalogue. “Not in catalogue” is accepted and recorded as a policy gap.</p></li> <li><p>S <b>Catalogue / metadata reference</b> Fill in if it applies</p><p>The catalogue reference. Needed when the answer to R is “In catalogue”. Up to 250 characters.</p></li> <li><p>T <b>DQ assurance / action plan status</b> Must be filled in</p><p>Choose from the workbook’s list. A “Gap” is accepted, but the asset is not counted as ready until a quality plan is in place. The check looks for an answer that starts with the word “Gap”.</p></li> <li><p>U <b>Quality evidence reference</b> Optional</p><p>Where the evidence of quality checks is kept. Up to 250 characters.</p></li> <li><p>V <b>Discoverability / interoperability status</b> Recommended</p><p>Choose from the workbook’s list.</p></li> </ul> <h3>Standards and continuity</h3><ul> <li><p>W <b>Geospatial standard applied</b> Fill in if it applies</p><p>UPRN (Unique Property Reference Number), USRN (Unique Street Reference Number), GEMINI (the UK standard for describing geographic data), Other or Not applicable. You can list several, separated by commas. “Not applicable” goes on its own.</p></li> <li><p>X <b>Previous ESDA return reference</b> Optional</p><p>Your reference from the earlier Essential Shared Data Assets (ESDA) return, if the asset was in it. Up to 100 characters.</p></li> </ul> <p>Based on: <a href=""https://www.gov.uk/government/publications/record-metadata-to-describe-critical-data-assets/recording-metadata-to-describe-critical-data-assets"">Recording metadata to describe critical data assets (opens GOV.UK)</a> and the version 3 Baseline Return workbook.</p>", flag: ""},
  {pid: "return", n: 5, h: "What happens after I send it?", x: "<ol><li><h3>We receive it</h3><p>You get a reference number. We keep your original file exactly as you sent it.</p></li><li><h3>We check it</h3><p>Automatic checks first, then a person looks at anything unclear.</p></li><li><h3>We ask once, if we need to</h3><p>If something needs changing, we send one message listing everything.</p></li><li><h3>It joins the register</h3><p>Your assets join one cross-government register, with a record of where each came from.</p></li><li><h3>We use it to help</h3><p>The register shows where support is needed most.</p></li></ol> <p><b>An honest gap is not a mistake.</b> If your return says, for example, that an asset has no data quality plan yet, we accept it. It shows us where to offer support. We only ask you to change things that are wrong or unclear.</p>", flag: ""},
  {pid: "return", n: 6, h: "Where can I get help?", x: "<p><a href=""https://forms.cloud.microsoft/e/SLBvuPX7jK"">Use our contact form</a>. Tell us which step your question is about. We will add useful answers to our published answers, without your name or your organisation’s name.</p> <p>The form is on GitHub, so what you write can be seen by others. Do not include personal or sensitive information.</p> <p>If you need this information in a different format, such as large print, audio or Easy Read, use the same form and tell us what you need.</p>", flag: ""},
  {pid: "return", n: 7, h: "What do the words mean?", x: "<p><b>Show the words and what they mean</b></p> <p><b>Critical data asset</b></p><p>A set of data that goes to, or comes from, another part of government, and that important work depends on.</p> <p><b>Baseline Return</b></p><p>The first list of critical data assets each organisation sends to GDS.</p> <p><b>OFFICIAL</b></p><p>The lowest level of the government’s security classifications. Most government data is OFFICIAL.</p> <p><b>Data owner</b></p><p>The person who is responsible for a set of data and decides how it is used.</p> <p><b>Data steward</b></p><p>The person who looks after a set of data day to day.</p> <p><b>Arm’s length body</b></p><p>An organisation that is part of government but works at a distance from its department, such as an agency.</p> <p><b>Data quality action plan</b></p><p>A plan for keeping a set of data accurate and complete enough to use.</p> <p><b>CSV file</b></p><p>A simple file for table data that any spreadsheet program can open and save.</p> <p><b>DAM</b></p><p>Data Asset Management, the government policy this return is part of.</p> <p><b>Data catalogue</b></p><p>A list that describes the data an organisation holds, so people can find it.</p> <p><b>Data protection officer</b></p><p>The person in an organisation who makes sure personal data is handled lawfully.</p> <p><b>Policy gap</b></p><p>Something the policy expects that is not in place yet, such as an asset with no data owner. A policy gap is not a mistake. We accept it and use it to decide where to help.</p> <p><b>ESDA</b></p><p>Essential Shared Data Assets, an earlier government list of shared data. Column X asks for your reference from it.</p> <p><b>GDS</b></p><p>The Government Digital Service, which runs the Data Asset Management programme.</p> <p><b>All the published guidance</b></p><ul> <li><a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy (opens GOV.UK)</a></li> <li><a href=""https://www.gov.uk/government/publications/identify-and-record-critical-data-assets/identifying-and-recording-critical-data-assets"">Identifying and recording critical data assets (opens GOV.UK)</a></li> <li><a href=""https://www.gov.uk/government/publications/record-metadata-to-describe-critical-data-assets/recording-metadata-to-describe-critical-data-assets"">Recording metadata to describe critical data assets (opens GOV.UK)</a></li> <li><a href=""https://www.gov.uk/government/publications/implement-a-data-quality-action-plan/data-quality-action-plan-implementation-guide"">Data quality action plan guide (opens GOV.UK)</a></li> <li><a href=""https://www.gov.uk/government/publications/data-ownership-in-government/data-ownership-model"">Data ownership model (opens GOV.UK)</a></li> </ul>", flag: ""},
  {pid: "track", n: 1, h: "Overview", x: "<p>For coordinators and chief data officers: where your return has got to, what you sent, and what the policy's measures will show across government.</p> <p> <b>Your information stays with you.</b> Everything on this page is saved or read in your own browser. Nothing is uploaded or sent to anyone.</p>", flag: ""},
  {pid: "track", n: 2, h: "Where your return has got to", x: "<p>Record each stage as it happens, so you and your chief data officer can see it at a glance. GDS tells you each step by email to your coordinator.</p>", flag: ""},
  {pid: "track", n: 3, h: "What you sent", x: "<p>Open the CSV copy of the version 3 workbook you sent (in Excel, choose <b>Save as</b>, then <b>CSV</b>). The page shows what is in it and how ready each asset is, using the same checks GDS uses first.</p>", flag: ""},
  {pid: "track", n: 4, h: "Across government", x: "<p>When returns arrive, GDS will report these measures to the Chief Data Officer Council and to ministers. No returns have arrived yet: the Baseline Return is due in January 2027, so nothing is shown here until then. <b>[Programme plan]</b> </p> <p><b>Planned cross-government measures</b></p><p><b>Returns received</b></p><ul><li><b>What it shows:</b> Returns received against the organisations expected to send one.</li><li><b>Broken down by:</b> Department and arm's length body</li><li><b>Available:</b> <b>[After the Baseline Return]</b> </li></ul><p><b>Critical data assets reported</b></p><ul><li><b>What it shows:</b> Number of assets in returns.</li><li><b>Broken down by:</b> Sector, critical purpose</li><li><b>Available:</b> <b>[After the Baseline Return]</b> </li></ul><p><b>Owner and steward assigned</b></p><ul><li><b>What it shows:</b> Share of assets with a <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-data-owner"">data owner</a> and a <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-data-steward"">data steward</a> assigned.</li><li><b>Broken down by:</b> Organisation group</li><li><b>Available:</b> <b>[After the Baseline Return]</b> </li></ul><p><b>In a data catalogue</b></p><ul><li><b>What it shows:</b> Share of assets recorded in a catalogue, planned or not yet.</li><li><b>Broken down by:</b> Organisation group</li><li><b>Available:</b> <b>[After the Baseline Return]</b> </li></ul><p><b>Quality plan in place</b></p><ul><li><b>What it shows:</b> Share of assets with a <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-dqap"">data quality action plan</a> or documented equivalent, in development or not yet.</li><li><b>Broken down by:</b> Organisation group</li><li><b>Available:</b> <b>[After the Baseline Return]</b> </li></ul><p><b>Discoverability of standards</b></p><ul><li><b>What it shows:</b> In place, partial or not in place.</li><li><b>Broken down by:</b> Organisation group</li><li><b>Available:</b> <b>[After the Baseline Return]</b> </li></ul><p><b>Policy gaps</b></p><ul><li><b>What it shows:</b> The most common gaps, to target support.</li><li><b>Broken down by:</b> Theme</li><li><b>Available:</b> <b>[After the Baseline Return]</b> </li></ul> <p>To protect organisations, no group of fewer than five organisations will be shown on its own.</p>", flag: ""},
  {pid: "track", n: 5, h: "Coming next: your organisation's live view in Teams", x: "<p>The next release will show each organisation its own return, status and measures, live, inside this app in Microsoft Teams. Return data will be kept in SharePoint, and Power BI will show each organisation only its own data, after you sign in with your work account. <b>[Suggested practice]</b> </p>", flag: ""},
  {pid: "people", n: 1, h: "Overview", x: "<p>Who takes part in the DAM Policy, what each person needs, and the route through this app and the playbooks that fits their role.</p> <p>The roles and user stories come from the <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/personas.html"">DAM capability playbooks</a>, and the questions from the GDS question register. They still need testing with real users. <b>[Suggested practice]</b> </p>", flag: ""},
  {pid: "people", n: 2, h: "All journeys at a glance", x: "<p>Each role moves through the same five stages. Choose a link to go to that step.</p> <p><b>Journey map: roles by stage</b></p><p><b>Lead policy coordinator</b></p><ul><li><b>Learn:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/policy.html"">The policy in plain English</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-principles"">The four scope principles</a></li></ul></li><li><b>Prepare:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-1"">Name who is in charge, set up arm's length body contacts</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-3"">Build the candidate list</a></li></ul></li><li><b>Do:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/asset-test.html"">Test each asset</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-6"">Confirm owners and fill in the details</a></li></ul></li><li><b>Report:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#check"">Check the list</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-9"">Assure arm's length body returns, sign off and send</a></li></ul></li><li><b>Improve:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-11"">Schedule the annual review</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-12"">Share what you learned</a></li></ul></li></ul><p><b>Chief data officer</b></p><ul><li><b>Learn:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/policy.html#must"">What you must do</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/policy.html#roles"">Who does what</a></li></ul></li><li><b>Prepare:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-1"">Name your coordinator</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-2"">Agree how owners are named</a></li></ul></li><li><b>Do:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-resourcing"">Resourcing: what GDS expects</a></li></ul></li><li><b>Report:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-10"">Sign off the return</a></li></ul></li><li><b>Improve:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/embed.html#bau"">Make it business as usual</a></li></ul></li></ul><p><b>Data owner</b></p><ul><li><b>Learn:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-iao"">Data owner and information asset owner</a></li></ul></li><li><b>Prepare:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-6"">Accept the role</a></li></ul></li><li><b>Do:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-8"">Agree a quality plan</a></li></ul></li><li><b>Report:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-partial"">Partial progress: report it honestly</a></li></ul></li><li><b>Improve:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-11"">Review every year</a></li></ul></li></ul><p><b>Data steward</b></p><ul><li><b>Learn:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-minimum-metadata"">Mandatory metadata</a></li></ul></li><li><b>Prepare:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-iar-catalogue"">Catalogue or register: one source</a></li></ul></li><li><b>Do:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-7"">Fill in the details</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-8"">Write quality rules and targets</a></li></ul></li><li><b>Report:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-free-text"">Keep free text short</a></li></ul></li><li><b>Improve:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-11"">Keep it current</a></li></ul></li></ul><p><b>Catalogue manager or data custodian</b></p><ul><li><b>Learn:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-mem"">DCAT and the Metadata Exchange Model</a></li></ul></li><li><b>Prepare:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-own-definition"">Label in-scope assets XG_CDA</a></li></ul></li><li><b>Do:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-catalogue-tool"">Do we need a particular product?</a></li></ul></li><li><b>Report:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-discoverability"">Discoverability field</a></li></ul></li><li><b>Improve:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-later-returns"">Toward catalogue-led reporting</a></li></ul></li></ul><p><b>Data quality lead or analyst</b></p><ul><li><b>Learn:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-dqap"">What counts as an equivalent plan</a></li></ul></li><li><b>Prepare:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/resources.html"">Data quality issues framework</a></li></ul></li><li><b>Do:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-8"">Link a quality plan to each asset</a></li></ul></li><li><b>Report:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-partial"">Report partial plans honestly</a></li></ul></li><li><b>Improve:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/embed.html#cycle"">Keep quality in the yearly cycle</a></li></ul></li></ul><p><b>Programme or project lead</b></p><ul><li><b>Learn:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/embed.html#change"">Build it in from the start</a></li></ul></li><li><b>Prepare:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/embed.html#change"">Discovery: list the data</a></li></ul></li><li><b>Do:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/asset-test.html"">Test each new asset</a></li></ul></li><li><b>Report:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/embed.html#change"">Make sure it joins the next return</a></li></ul></li><li><b>Improve:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/embed.html#bau"">Hand over to business as usual</a></li></ul></li></ul><p><b>Commercial or technology lead</b></p><ul><li><b>Learn:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-catalogue-tool"">No particular product is required</a></li></ul></li><li><b>Prepare:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-13"">Tool requirements, in the playbooks</a></li></ul></li><li><b>Do:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-13"">Prove it with your own data</a></li></ul></li><li><b>Report:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-20"">Supplier-held critical data</a></li></ul></li><li><b>Improve:</b> <ul><li><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-32"">Test the exit every year</a></li></ul></li></ul>", flag: ""},
  {pid: "people", n: 3, h: "Lead policy coordinator", x: "<p>Coordinates adoption day to day, collates and assures the return, and represents the organisation at the Working Group.</p> <h3>Context</h3><p>Works across many teams, often alongside another role. Needs one route from start to return, and templates to reuse.</p><h3>Goals</h3><ul><li>Get the Baseline Return right first time</li><li>Avoid retyping information that already exists</li><li>Keep arm's length bodies in step</li></ul> <h3>User stories</h3><ul><li>As a lead policy coordinator, I need one ordered route from mobilising to an assured return, so that nothing is missed and nothing is done twice.</li><li>As a lead policy coordinator, I need templates that match what GDS asks for, so that the return is collation, not reconstruction.</li></ul> <h3>What gets in the way</h3><ul><li>Requests arrive from several directions with different deadlines</li><li>Owners change and nobody updates the record</li></ul> <p> <b>Success looks like:</b> An assured return goes in on time, built from catalogue records rather than retyped.</p> <h3>Journey</h3><ol><li>1. Learn<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/policy.html"">The policy in plain English</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-principles"">The four scope principles</a></li></ul></li><li>2. Prepare<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-1"">Name who is in charge, set up arm's length body contacts</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-3"">Build the candidate list</a></li></ul></li><li>3. Do<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/asset-test.html"">Test each asset</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-6"">Confirm owners and fill in the details</a></li></ul></li><li>4. Report<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#check"">Check the list</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-9"">Assure arm's length body returns, sign off and send</a></li></ul></li><li>5. Improve<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-11"">Schedule the annual review</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-12"">Share what you learned</a></li></ul></li></ol> <h3>What people in this role asked us</h3><ul><li>Do arm's length bodies and agencies send one combined return with their department, or their own? <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-alb-returns"">Answer</a></li><li>Can GDS give feedback on our test return before we send the real one? <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-test-return"">Answer</a></li><li>What is the scope and timing of later returns, after the first one? <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-later-returns"">Answer</a></li><li>How should we fill in the <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-legal-gateway"">legal gateway</a> field? <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-legal-gateway"">Answer</a></li><li>Materials are hard to find: the Knowledge Hub is hard to navigate and some recordings cannot be viewed. <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-find-materials"">Answer</a></li></ul> <h3>Capabilities to build</h3><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/governance.html"">CR-03 Central reporting, assurance and arm's length body coordination</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/cataloguing.html"">CR-05 Identify and scope critical data assets</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/cataloguing.html"">CR-06 Data cataloguing and metadata management</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/governance.html"">CR-04 Performance measurement and annual review</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-21"">CR-21 Data skills, capability and literacy</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-25"">CR-25 Integration with programmes, spend control and assurance</a></p> <p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/personas.html#p-coo"">Full route and learning journey in the playbooks</a></p>", flag: ""},
  {pid: "people", n: 4, h: "Chief data officer", x: "<p>Accountable for adopting the policy across the organisation and, in a department, its arm's length bodies.</p> <h3>Context</h3><p>Has little time, decides on resourcing and reports progress to the Chief Data Officer Council. Wants summaries first, detail on request.</p><h3>Goals</h3><ul><li>Adopt the policy once, without the three capabilities duplicating effort</li><li>Know the organisation's position at any time</li><li>Show credible progress to the CDO Council</li></ul> <h3>User stories</h3><ul><li>As a chief data officer, I need to see what the policy requires and who does what, so that I can assign the work with confidence.</li><li>As a chief data officer, I need a short, current view of progress, so that I can unblock problems before the return is due.</li></ul> <h3>What gets in the way</h3><ul><li>Governance, cataloguing and quality teams record the same facts in different places</li><li>Evidence is assembled in a rush at the deadline</li></ul> <p> <b>Success looks like:</b> Every <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-critical-data-asset"">critical data asset</a> has a named owner, a current catalogue record and a quality plan, and the return goes in on time.</p> <h3>Journey</h3><ol><li>1. Learn<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/policy.html#must"">What you must do</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/policy.html#roles"">Who does what</a></li></ul></li><li>2. Prepare<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-1"">Name your coordinator</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-2"">Agree how owners are named</a></li></ul></li><li>3. Do<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-resourcing"">Resourcing: what GDS expects</a></li></ul></li><li>4. Report<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-10"">Sign off the return</a></li></ul></li><li>5. Improve<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/embed.html#bau"">Make it business as usual</a></li></ul></li></ol> <h3>What people in this role asked us</h3><ul><li>Who should our coordinator be, and who is accountable? <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-who-accountable"">Answer</a></li><li>The criteria in the return template read differently from the published policy. Which do we follow? <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-principles"">Answer</a></li></ul> <h3>Capabilities to build</h3><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/governance.html"">CR-01 Accountable leadership and policy oversight</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-02"">CR-02 Data strategy and prioritisation by reuse value</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/governance.html"">CR-03 Central reporting, assurance and arm's length body coordination</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/governance.html"">CR-04 Performance measurement and annual review</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-23"">CR-23 Maturity assessment and continuous improvement</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-24"">CR-24 Investment, business cases and value</a></p> <p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/personas.html#p-cdo"">Full route and learning journey in the playbooks</a></p>", flag: ""},
  {pid: "people", n: 5, h: "Data owner", x: "<p>The senior leader accountable for the meaning, content, quality and management of one or more critical data assets.</p> <h3>Context</h3><p>Data ownership is one of several responsibilities. Makes decisions and signs off; others do the day-to-day work.</p><h3>Goals</h3><ul><li>Understand exactly what they are accountable for</li><li>Make decisions quickly with the right evidence</li><li>Name a successor so the asset is never orphaned</li></ul> <h3>User stories</h3><ul><li>As a <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-data-owner"">data owner</a>, I need a clear list of the decisions that are mine, so that I can sign off with confidence.</li><li>As a data owner, I need to see how good my data is and what it should not be used for, so that I can accept or reject risks knowingly.</li></ul> <h3>What gets in the way</h3><ul><li>Unclear difference between data owner and information asset owner</li><li>Asked to sign things without the context</li></ul> <p> <b>Success looks like:</b> Can explain the assets' purpose, quality and risks, and a successor is named.</p> <h3>Journey</h3><ol><li>1. Learn<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-iao"">Data owner and information asset owner</a></li></ul></li><li>2. Prepare<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-6"">Accept the role</a></li></ul></li><li>3. Do<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-8"">Agree a quality plan</a></li></ul></li><li>4. Report<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-partial"">Partial progress: report it honestly</a></li></ul></li><li>5. Improve<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-11"">Review every year</a></li></ul></li></ol> <h3>What people in this role asked us</h3><ul><li>Where do the boundaries sit between a data set, a data asset, a product, an API and a service? <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-what-to-report"">Answer</a></li><li>What counts as a <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-dqap"">data quality action plan</a> or equivalent, and where is the framework? <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-dqap"">Answer</a></li></ul> <h3>Capabilities to build</h3><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/governance.html"">CR-07 Data ownership and stewardship</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/quality.html"">CR-08 Data quality management through action plans</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-19"">CR-19 Data risk management</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-27"">CR-27 Ownership transition and handover to business as usual</a></p> <p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/personas.html#p-own"">Full route and learning journey in the playbooks</a></p>", flag: ""},
  {pid: "people", n: 6, h: "Data steward", x: "<p>Runs critical data assets day to day: their standards, access, <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-metadata"">metadata</a> and quality processes.</p> <h3>Context</h3><p>Does the detailed work and keeps the records current. Needs step-by-step methods and templates.</p><h3>Goals</h3><ul><li>Keep the catalogue record and quality plan current without heroics</li><li>Find problems before users do</li><li>Hand over cleanly when moving on</li></ul> <h3>User stories</h3><ul><li>As a <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-data-steward"">data steward</a>, I need step-by-step instructions with templates, so that I can do the work consistently across assets.</li><li>As a data steward, I need one place to record each fact once, so that the catalogue, the quality plan and the register always agree.</li></ul> <h3>What gets in the way</h3><ul><li>The same owner and review date recorded in three places</li><li>Quality rules kept only in one tool</li></ul> <p> <b>Success looks like:</b> Every asset stewarded has a current record, rules with targets, and a quality statement users understand.</p> <h3>Journey</h3><ol><li>1. Learn<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-minimum-metadata"">Mandatory metadata</a></li></ul></li><li>2. Prepare<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-iar-catalogue"">Catalogue or register: one source</a></li></ul></li><li>3. Do<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-7"">Fill in the details</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-8"">Write quality rules and targets</a></li></ul></li><li>4. Report<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-free-text"">Keep free text short</a></li></ul></li><li>5. Improve<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-11"">Keep it current</a></li></ul></li></ol> <h3>What people in this role asked us</h3><ul><li>What is the minimum metadata we must record, and which standards set it? <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-minimum-metadata"">Answer</a></li><li>What counts as a data quality action plan or equivalent, and where is the framework? <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-dqap"">Answer</a></li></ul> <h3>Capabilities to build</h3><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/cataloguing.html"">CR-06 Data cataloguing and metadata management</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/quality.html"">CR-08 Data quality management through action plans</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/quality.html"">CR-09 Data quality issue management</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/cataloguing.html"">CR-11 Interoperability, data standards and identifiers</a></p> <p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/personas.html#p-stw"">Full route and learning journey in the playbooks</a></p>", flag: ""},
  {pid: "people", n: 7, h: "Catalogue manager or data custodian", x: "<p>Runs the catalogue and the systems behind it, so records can be found, harvested and kept accurate.</p> <h3>Context</h3><p>Works with tools and standards. Needs to know what any catalogue must expose, whatever the product.</p><h3>Goals</h3><ul><li>Records that machines can harvest, not only people</li><li>Conform to the cross-government metadata standard</li><li>Avoid lock-in to one product</li></ul> <h3>User stories</h3><ul><li>As a catalogue manager or data custodian, I need the exact metadata properties and how they map to the standard, so that records conform first time.</li><li>As a catalogue manager or data custodian, I need to know what the discoverability service will expect, so that we do not rebuild the feed later.</li></ul> <h3>What gets in the way</h3><ul><li>Guidance and model do not list the same properties</li><li>Internal-only links break outside the organisation</li></ul> <p> <b>Success looks like:</b> Every critical data asset record is complete, conforms to the standard and can be harvested as DCAT.</p> <h3>Journey</h3><ol><li>1. Learn<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-mem"">DCAT and the Metadata Exchange Model</a></li></ul></li><li>2. Prepare<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-own-definition"">Label in-scope assets XG_CDA</a></li></ul></li><li>3. Do<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-catalogue-tool"">Do we need a particular product?</a></li></ul></li><li>4. Report<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-discoverability"">Discoverability field</a></li></ul></li><li>5. Improve<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-later-returns"">Toward catalogue-led reporting</a></li></ul></li></ol> <h3>What people in this role asked us</h3><ul><li>What is the minimum metadata we must record, and which standards set it? <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-minimum-metadata"">Answer</a></li><li>Do we need a particular catalogue product, and how do others publish metadata or tag it in their tools? <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-catalogue-tool"">Answer</a></li><li>Who will see our return, and will the metadata be published? <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-who-sees"">Answer</a></li></ul> <h3>Capabilities to build</h3><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/cataloguing.html"">CR-06 Data cataloguing and metadata management</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/cataloguing.html"">CR-11 Interoperability, data standards and identifiers</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-12"">CR-12 Data architecture and data services</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-13"">CR-13 Catalogue and quality tooling</a></p> <p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/personas.html#p-cat"">Full route and learning journey in the playbooks</a></p>", flag: ""},
  {pid: "people", n: 8, h: "Data quality lead or analyst", x: "<p>Brings methods and tools for measuring and improving quality across many assets.</p> <h3>Context</h3><p>Supports several stewards. Needs a consistent scoring method and tools that work without installing anything.</p><h3>Goals</h3><ul><li>Score issues the same way across assets</li><li>Automate measurement across assets</li><li>Show quality fairly for every group the data describes</li></ul> <h3>User stories</h3><ul><li>As a data quality lead or analyst, I need the government scoring method and tools that apply it, so that priorities are consistent and defensible.</li><li>As a data quality lead or analyst, I need checks that break results down by group, so that poor quality for some people is not averaged away.</li></ul> <h3>What gets in the way</h3><ul><li>Every team scores issues differently</li><li>Quality reported as one average</li></ul> <p> <b>Success looks like:</b> Every critical data asset has scored issues, automated checks and quality reported by group where lawful.</p> <h3>Journey</h3><ol><li>1. Learn<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-dqap"">What counts as an equivalent plan</a></li></ul></li><li>2. Prepare<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/resources.html"">Data quality issues framework</a></li></ul></li><li>3. Do<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-8"">Link a quality plan to each asset</a></li></ul></li><li>4. Report<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-partial"">Report partial plans honestly</a></li></ul></li><li>5. Improve<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/embed.html#cycle"">Keep quality in the yearly cycle</a></li></ul></li></ol> <h3>What people in this role asked us</h3><ul><li>What counts as a data quality action plan or equivalent, and where is the framework? <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-dqap"">Answer</a></li></ul> <h3>Capabilities to build</h3><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/quality.html"">CR-08 Data quality management through action plans</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/quality.html"">CR-09 Data quality issue management</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-30"">CR-30 Equality and inclusion in data</a></p> <p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/personas.html#p-dql"">Full route and learning journey in the playbooks</a></p>", flag: ""},
  {pid: "people", n: 9, h: "Programme or project lead", x: "<p>Leads a change programme or project that creates, changes, migrates or retires critical data assets.</p> <h3>Context</h3><p>The programme has its own governance, gates, budget and suppliers. Data asset management can feel like someone else's job until a gate review, migration or handover exposes the gaps.</p><h3>Goals</h3><ul><li>Pass assurance gates without late data surprises</li><li>Hand over assets with owners and quality plans in place</li><li>Avoid creating the next legacy system</li></ul> <h3>User stories</h3><ul><li>As a programme or project lead, I need to know which DAM duties apply to my programme and when, so that they are planned and funded from the business case.</li><li>As a programme or project lead, I need clear data roles inside my programme team, so that nobody assumes someone else is doing it.</li></ul> <h3>What gets in the way</h3><ul><li>Data owners sit outside the programme and are hard to reach</li><li>Migration quality problems surface only at cutover</li></ul> <p> <b>Success looks like:</b> Every critical asset the programme touches has an owner, a catalogue entry and a quality plan before the programme closes.</p> <h3>Journey</h3><ol><li>1. Learn<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/embed.html#change"">Build it in from the start</a></li></ul></li><li>2. Prepare<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/embed.html#change"">Discovery: list the data</a></li></ul></li><li>3. Do<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/asset-test.html"">Test each new asset</a></li></ul></li><li>4. Report<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/embed.html#change"">Make sure it joins the next return</a></li></ul></li><li>5. Improve<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/embed.html#bau"">Hand over to business as usual</a></li></ul></li></ol> <h3>What people in this role asked us</h3><ul><li>How do we build the policy into a new digital service or transformation project from the start? <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-new-service"">Answer</a></li><li>How does the policy link to crisis and resilience data sharing? <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-resilience"">Answer</a></li></ul> <h3>Capabilities to build</h3><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-24"">CR-24 Investment, business cases and value</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-25"">CR-25 Integration with programmes, spend control and assurance</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-26"">CR-26 Legacy migration and decommissioning</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-27"">CR-27 Ownership transition and handover to business as usual</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-29"">CR-29 Benefits realisation and evaluation</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-32"">CR-32 Avoiding future legacy: open standards, portability and exit</a></p> <p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/personas.html#p-prg"">Full route and learning journey in the playbooks</a></p>", flag: ""},
  {pid: "people", n: 10, h: "Commercial or technology lead", x: "<p>Chooses, buys or builds the tools that catalogue, check and govern critical data, and writes the contracts that keep the data yours.</p> <h3>Context</h3><p>Asked to find a catalogue, quality or master data tool quickly, often with a supplier's suite already on the table.</p><h3>Goals</h3><ul><li>Buy what the DAM Policy actually needs</li><li>Prove a tool works with our data before signing</li><li>Keep the option to leave</li></ul> <h3>User stories</h3><ul><li>As a commercial or technology lead, I need ready-made requirements for each kind of tool, with priorities, so that I can run a request for information without starting from a blank page.</li><li>As a commercial or technology lead, I need contract clauses that protect our data, so that we are not locked in when the contract ends.</li></ul> <h3>What gets in the way</h3><ul><li>Supplier demonstrations use their data, not ours</li><li>Bundled suites make it hard to price or leave one part</li></ul> <p> <b>Success looks like:</b> The tool chosen meets every Must requirement in a proof of concept with your own data, and the contract includes export, exit and data processing terms.</p> <h3>Journey</h3><ol><li>1. Learn<ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-catalogue-tool"">No particular product is required</a></li></ul></li><li>2. Prepare<ul><li><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-13"">Tool requirements, in the playbooks</a></li></ul></li><li>3. Do<ul><li><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-13"">Prove it with your own data</a></li></ul></li><li>4. Report<ul><li><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-20"">Supplier-held critical data</a></li></ul></li><li>5. Improve<ul><li><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-32"">Test the exit every year</a></li></ul></li></ol> <h3>What people in this role asked us</h3><ul><li>Do we need a particular catalogue product, and how do others publish metadata or tag it in their tools? <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-catalogue-tool"">Answer</a></li></ul> <h3>Capabilities to build</h3><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-13"">CR-13 Catalogue and quality tooling</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-20"">CR-20 Third-party and supplier data</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-32"">CR-32 Avoiding future legacy: open standards, portability and exit</a></p> <p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/personas.html#p-buy"">Full route and learning journey in the playbooks</a></p>", flag: ""},
  {pid: "capabilities", n: 1, h: "Overview", x: "<p>The policy names a few things you must do. Doing them well rests on 32 capabilities, from leadership and strategy to tooling, risk and handover. Find the ones that matter to you, and go straight to the playbook for each.</p> <p>The capability model and playbooks are the <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/"">DAM capability playbooks</a>, a prototype. They are not government guidance. Where they repeat GOV.UK, GOV.UK is the authority. <b>[Suggested practice]</b> </p> <p><b>Explicit</b></p><p>The policy names it as a requirement or responsibility.</p><p><b>Implicit</b></p><p>The policy depends on it to meet a requirement, but does not name it.</p><p><b>Inferred</b></p><p>Not in the policy text. The playbooks' judgement from good practice and related guidance.</p>", flag: ""},
  {pid: "capabilities", n: 2, h: "Where to start", x: "<p>Start with the core capabilities the policy names. They are the ones your first return depends on.</p> <ol><li>Identify and report critical data assets (section 4)→<a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/cataloguing.html"">CR-05</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/governance.html"">CR-03</a>→<a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/cataloguing.html"">Cataloguing playbook</a></li><li>Manage <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-metadata"">metadata</a> in your <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-data-catalogue"">data catalogue</a> (section 4)→<a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/cataloguing.html"">CR-06</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/cataloguing.html"">CR-11</a>→<a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/cataloguing.html"">Cataloguing playbook</a></li><li>A named <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-data-owner"">data owner</a> for every asset (section 5)→<a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/governance.html"">CR-07</a>→<a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/governance.html"">Governance playbook</a></li><li>A <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-dqap"">data quality action plan</a> or equivalent (section 6)→<a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/quality.html"">CR-08</a> <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/quality.html"">CR-09</a>→<a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/quality.html"">Quality playbook</a></li><li>Review every year (section 4)→<a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/governance.html"">CR-04</a>→<a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/governance.html"">Governance playbook</a></li><li>The chief data officer is responsible (section 8)→<a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/governance.html"">CR-01</a>→<a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/governance.html"">Governance playbook</a></li></ol>", flag: ""},
  {pid: "capabilities", n: 3, h: "Direction and oversight", x: "<ul><li>CR-01<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/governance.html"">Accountable leadership and policy oversight</a></h3><p>Explicit · for Chief data officer</p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-01"">In the capability model</a></p></li><li>CR-02<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-02"">Data strategy and prioritisation by reuse value</a></h3><p>Implicit · for Chief data officer</p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-02"">In the capability model</a></p></li><li>CR-03<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/governance.html"">Central reporting, assurance and arm's length body coordination</a></h3><p>Explicit · for Lead policy coordinator, Chief data officer</p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-03"">In the capability model</a></p></li><li>CR-04<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/governance.html"">Performance measurement and annual review</a></h3><p>Explicit · for Lead policy coordinator, Chief data officer</p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-04"">In the capability model</a></p></li></ul>", flag: ""},
  {pid: "capabilities", n: 4, h: "Core DAM capabilities", x: "<ul><li>CR-05<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/cataloguing.html"">Identify and scope critical data assets</a></h3><p>Explicit · for Lead policy coordinator</p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-05"">In the capability model</a></p></li><li>CR-06<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/cataloguing.html"">Data cataloguing and metadata management</a></h3><p>Explicit · for Lead policy coordinator, <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-data-steward"">Data steward</a>, Catalogue manager or data custodian</p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-06"">In the capability model</a></p></li><li>CR-07<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/governance.html"">Data ownership and stewardship</a></h3><p>Explicit · for Data owner</p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-07"">In the capability model</a></p></li><li>CR-08<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/quality.html"">Data quality management through action plans</a></h3><p>Explicit · for Data owner, Data steward, Data quality lead or analyst</p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-08"">In the capability model</a></p></li><li>CR-09<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/quality.html"">Data quality issue management</a></h3><p>Implicit · for Data steward, Data quality lead or analyst</p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-09"">In the capability model</a></p></li></ul>", flag: ""},
  {pid: "capabilities", n: 5, h: "Data management enablers", x: "<ul><li>CR-10<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-10"">Data life cycle management</a></h3><p>Explicit </p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-10"">In the capability model</a></p></li><li>CR-11<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/cataloguing.html"">Interoperability, data standards and identifiers</a></h3><p>Explicit · for Data steward, Catalogue manager or data custodian</p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-11"">In the capability model</a></p></li><li>CR-12<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-12"">Data architecture and data services</a></h3><p>Implicit · for Catalogue manager or data custodian</p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-12"">In the capability model</a></p></li><li>CR-13<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-13"">Catalogue and quality tooling</a></h3><p>Implicit · for Catalogue manager or data custodian, Commercial or technology lead</p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-13"">In the capability model</a></p></li><li>CR-14<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-14"">Reference data, master data and authoritative sources</a></h3><p>Implicit </p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-14"">In the capability model</a></p></li><li>CR-15<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-15"">Records, retention and disposal</a></h3><p>Inferred </p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-15"">In the capability model</a></p></li></ul>", flag: ""},
  {pid: "capabilities", n: 6, h: "Protection, ethics and trust", x: "<ul><li>CR-16<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-16"">Security classification and protective controls</a></h3><p>Explicit </p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-16"">In the capability model</a></p></li><li>CR-17<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-17"">Data protection and lawful sharing</a></h3><p>Explicit </p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-17"">In the capability model</a></p></li><li>CR-18<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-18"">AI readiness and data and AI ethics</a></h3><p>Explicit </p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-18"">In the capability model</a></p></li><li>CR-19<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-19"">Data risk management</a></h3><p>Explicit · for Data owner</p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-19"">In the capability model</a></p></li><li>CR-20<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-20"">Third-party and supplier data</a></h3><p>Implicit · for Commercial or technology lead</p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-20"">In the capability model</a></p></li><li>CR-30<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-30"">Equality and inclusion in data</a></h3><p>Inferred · for Data quality lead or analyst</p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-30"">In the capability model</a></p></li><li>CR-31<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-31"">Cyber resilience and incident response for data assets</a></h3><p>Implicit </p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-31"">In the capability model</a></p></li></ul>", flag: ""},
  {pid: "capabilities", n: 7, h: "People and culture", x: "<ul><li>CR-21<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-21"">Data skills, capability and literacy</a></h3><p>Implicit · for Lead policy coordinator</p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-21"">In the capability model</a></p></li><li>CR-22<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-22"">Data culture and engagement with users</a></h3><p>Implicit </p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-22"">In the capability model</a></p></li><li>CR-23<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-23"">Maturity assessment and continuous improvement</a></h3><p>Implicit · for Chief data officer</p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-23"">In the capability model</a></p></li></ul>", flag: ""},
  {pid: "capabilities", n: 8, h: "Delivery, change and value", x: "<ul><li>CR-24<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-24"">Investment, business cases and value</a></h3><p>Explicit · for Chief data officer, Programme or project lead</p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-24"">In the capability model</a></p></li><li>CR-25<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-25"">Integration with programmes, spend control and assurance</a></h3><p>Inferred · for Lead policy coordinator, Programme or project lead</p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-25"">In the capability model</a></p></li><li>CR-26<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-26"">Legacy migration and decommissioning</a></h3><p>Inferred · for Programme or project lead</p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-26"">In the capability model</a></p></li><li>CR-27<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-27"">Ownership transition and handover to business as usual</a></h3><p>Implicit · for Data owner, Programme or project lead</p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-27"">In the capability model</a></p></li><li>CR-28<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/together.html"">Cross-boundary collaboration</a></h3><p>Explicit </p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-28"">In the capability model</a></p></li><li>CR-29<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-29"">Benefits realisation and evaluation</a></h3><p>Inferred · for Programme or project lead</p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-29"">In the capability model</a></p></li><li>CR-32<h3><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-32"">Avoiding future legacy: open standards, portability and exit</a></h3><p>Inferred · for Programme or project lead, Commercial or technology lead</p><p><a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capability-model.html#CR-32"">In the capability model</a></p></li></ul>", flag: ""},
  {pid: "embed", n: 1, h: "Overview", x: "<p>The return is one moment in the year. The policy works when knowing, owning and looking after your shared data becomes normal, both in day-to-day business and whenever something changes.</p>", flag: ""},
  {pid: "embed", n: 2, h: "The yearly cycle", x: "<p>Each stage comes from a requirement in the policy. <b>[Policy]</b> </p> <ol><li>1<b>Identify</b>Test possible assets against the scope principles.</li><li>2<b>Record</b>Describe each asset in your catalogue.</li><li>3<b>Own</b>Name an owner, and a steward to look after it.</li><li>4<b>Assure quality</b>Keep a quality plan, and act on the issues it finds.</li><li>5<b>Report</b>Send your return to GDS.</li><li>6<b>Review</b>Look at the whole list again at least once a year.</li></ol> <p>Source: <a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy in government (GOV.UK)</a></p>", flag: ""},
  {pid: "embed", n: 3, h: "In business as usual", x: "<p>Ways organisations can keep the policy working after the first return. <b>[Suggested practice]</b> </p> <ul><li><h3>Put it in role descriptions</h3><p>Write <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-data-owner"">data owner</a> and steward duties into the roles that hold them, so they survive people moving on.</p></li><li><h3>Use your existing governance</h3><p>Take the asset list and quality plans to the board or committee that already oversees information risk.</p></li><li><h3>Fix a yearly date</h3><p>Pick a month for the annual review and put it in the business plan, ahead of the return.</p></li><li><h3>Keep the catalogue as the source</h3><p>Update the catalogue first and fill the return from it, so you never keep two lists.</p></li><li><h3>Track gaps, not just answers</h3><p>Keep a short list of policy gaps, such as assets with no owner, and review progress quarterly.</p></li></ul>", flag: ""},
  {pid: "embed", n: 4, h: "In change: projects and new services", x: "<p>Build it in from the start, so a new service's data joins your list without extra work. This follows the Service Standard's delivery phases and point 10 of the Technology Code of Practice, which asks teams to plan for data across its lifecycle. <b>[Suggested practice]</b> </p> <ol><li>Discovery<p>List the data the service will create, use or share with other organisations. Note which critical purposes it serves.</p></li><li>Alpha<p>Run each likely asset through the asset test. Agree who will own it. Check the legal basis for any sharing.</p></li><li>Beta<p>Describe each asset in your catalogue using the core <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-metadata"">metadata</a>. Start its <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-dqap"">data quality action plan</a>.</p></li><li>Live<p>Make sure the assets are in your organisation's next return, and hand ownership to the business, not the project.</p></li><li>Retirement<p>When the service closes, update or remove its assets from your list and your catalogue.</p></li></ol> <p>Source: <a href=""https://www.gov.uk/guidance/make-better-use-of-data"">Technology Code of Practice, point 10: make better use of data (GOV.UK)</a>; <a href=""https://www.gov.uk/service-manual/service-standard"">Service Standard (GOV.UK)</a></p>", flag: ""},
  {pid: "embed", n: 5, h: "Practical kit for data owners and stewards", x: "<p>Coordinators asked for practical help, not more policy. Use these as they are, or adapt them to your organisation. <b>[Suggested practice]</b> </p> <h3> Data owner: what to do first</h3><ol> <li>Accept the role in writing, and name a successor so the asset is never left without an owner.</li> <li>Know each asset: what it is for, who relies on it, and what it must not be used for.</li> <li>Agree quality targets with your steward, and approve the asset's quality plan.</li> <li>Decide which risks you accept, and record them on the risk register you already use.</li> <li>Before each return, check the asset's details in your catalogue are current.</li></ol> <h3> Data steward: what to do first</h3><ol> <li>Complete the catalogue record, and record each fact once, in one place.</li> <li>Write the quality rules and targets with the owner, and measure where you start.</li> <li>Fix problems where they start, not where they show up.</li> <li>Log issues using the data quality issues framework, and tell the owner what needs a decision.</li> <li>Keep a short handover note, so the next steward can carry on.</li></ol> <h3> Questions for the owner to ask each quarter</h3><ul> <li>Who relies on this data now, and for what?</li><li>Has anything changed: the system, a supplier, the law, the people?</li> <li>Are the known quality issues getting better?</li><li>Who would I call if it failed tomorrow?</li><li>Is my named successor still right?</li></ul> <h3> Owner and steward conversation (30 minutes, each quarter)</h3><ol> <li>What changed since last time.</li><li>Quality against targets, and the top issues.</li><li>Decisions the owner needs to make, including risks to accept.</li> <li>Requests to share or reuse the data.</li><li>Anything for the next return.</li></ol> <p><b>What works elsewhere:</b> one department found most stewards are not data specialists. It builds steward tasks into moments when they already deal with the data team, such as adding the data behind published analysis to the catalogue, rather than asking for separate work. <b>[Suggested practice]</b> </p> <p>Source: <a href=""https://www.gov.uk/government/publications/data-ownership-in-government/data-ownership-model"">Data ownership model (GOV.UK)</a>; <a href=""https://www.gov.uk/government/publications/implement-a-data-quality-action-plan/data-quality-action-plan-implementation-guide"">Data quality action plan: implementation guide (GOV.UK)</a>; <a href=""https://www.gov.uk/government/publications/implement-a-data-quality-action-plan/data-quality-issues-framework"">Data quality issues framework (GOV.UK)</a></p> <p>More: the <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/governance.html"">data governance playbook</a> and the <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/people.html#p-own"">data owner</a> and <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/people.html#p-stw"">data steward</a> journeys. GDS is also developing training for data owners.</p>", flag: "New"},
  {pid: "embed", n: 6, h: "Briefing your arm's length bodies", x: "<p>An outline for a 45-minute introduction, with a page here for each point that people can read afterwards. GDS is happy to support departments in these conversations: ask through the <a href=""https://forms.cloud.microsoft/e/SLBvuPX7jK"">contact form</a>. <b>[Suggested practice]</b> </p> <ol> <li>The ask (5 minutes)<p>Find, record and report your critical data assets, each with an owner and a quality plan. <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/policy.html#must"">What you must do</a></p></li> <li>The scope (10 minutes)<p><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-official"">OFFICIAL</a>, and the four scope principles. <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/asset-test.html"">Asset test</a></p></li> <li>Why it matters (5 minutes)<p>Government relies on data that passes between organisations. <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/policy.html#why"">Why it exists</a></p></li> <li>How your return works (10 minutes)<p>Version 3 of the template, through your department, due in January 2027. <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-alb-returns"">Arm's length bodies and the return</a></p></li> <li>Support, and questions (15 minutes)<p>This explorer, the playbooks and GDS. <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html"">Questions and answers</a></p></li> </ol>", flag: "New"},
  {pid: "embed", n: 7, h: "Build the capability behind it", x: "<p>The return shows where your organisation's data management needs to grow: catalogues, ownership, metadata and quality. Start with the gaps the return reveals, and use the published guidance for each one.</p> <ul><li><a href=""https://www.gov.uk/government/publications/data-ownership-in-government/data-ownership-model"">Ownership: the data ownership model</a></li><li><a href=""https://www.gov.uk/government/publications/record-metadata-to-describe-critical-data-assets/recording-metadata-to-describe-critical-data-assets"">Metadata: recording metadata for critical data assets</a></li><li><a href=""https://www.gov.uk/government/publications/implement-a-data-quality-action-plan/data-quality-action-plan-implementation-guide"">Quality: the data quality action plan guide</a></li><li><a href=""https://www.gov.uk/government/publications/the-government-data-quality-framework"">Quality culture: the Government Data Quality Framework</a></li></ul>", flag: ""},
  {pid: "resources", n: 1, h: "Overview", x: "<p>All the published guidance, templates and tools for the policy, in one list.</p>", flag: ""},
  {pid: "resources", n: 2, h: "Guidance, templates and tools", x: "<p>16 resources</p> <ul><li><h3><a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy in government</a></h3><p>The policy itself: who it applies to and what you must do.</p><p>Guidance · for Coordinators, Chief data officers, Data owners <b>[Policy]</b> </p></li><li><h3><a href=""https://www.gov.uk/government/publications/identify-and-record-critical-data-assets/identifying-and-recording-critical-data-assets"">Identifying and recording critical data assets</a></h3><p>How to identify critical data assets, and the seven critical purposes.</p><p>Guidance · for Coordinators, Data owners <b>[Policy]</b> </p></li><li><h3><a href=""https://www.gov.uk/government/publications/record-metadata-to-describe-critical-data-assets/recording-metadata-to-describe-critical-data-assets"">Recording metadata to describe critical data assets</a></h3><p>The core <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-metadata"">metadata</a> to record for each asset.</p><p>Guidance · for Coordinators, Data stewards <b>[Policy]</b> </p></li><li><h3><a href=""https://www.gov.uk/government/publications/data-ownership-in-government/data-ownership-model"">Data ownership model</a></h3><p>How to name data owners, and how they relate to information asset owners.</p><p>Guidance · for Chief data officers, Data owners <b>[Policy]</b> </p></li><li><h3><a href=""https://www.gov.uk/government/publications/implement-a-data-quality-action-plan/data-quality-action-plan-implementation-guide"">Data quality action plan: implementation guide</a></h3><p>Seven steps to a <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-dqap"">data quality action plan</a>, with templates.</p><p>Guidance · for Data owners, Data stewards <b>[Policy]</b> </p></li><li><h3><a href=""https://www.gov.uk/government/publications/implement-a-data-quality-action-plan/data-quality-issues-framework"">Data quality issues framework</a></h3><p>How to find, describe and prioritise data quality issues.</p><p>Guidance · for Data owners, Data stewards <b>[Policy]</b> </p></li><li><h3><a href=""https://www.gov.uk/government/publications/the-government-data-quality-framework"">The Government Data Quality Framework</a></h3><p>Principles and practices for data quality in government.</p><p>Guidance · for Data owners, Chief data officers <b>[Policy]</b> </p></li><li><h3><a href=""https://www.gov.uk/guidance/make-better-use-of-data"">Technology Code of Practice, point 10: make better use of data</a></h3><p>How technology projects should plan for data across its lifecycle.</p><p>Guidance · for Project and service teams <b>[Policy]</b> </p></li><li><h3><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/templates/return-template.csv"">Return workbook column list (CSV)</a></h3><p>The 24 column headings in the version 3 layout. The team sends you the full workbook.</p><p>Template · for Coordinators, Data stewards <b>[Suggested practice]</b> </p></li><li><h3><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/templates/left-out-template.csv"">Assets left out (CSV)</a></h3><p>Record what you tested and left out, with the reason.</p><p>Template · for Coordinators <b>[Suggested practice]</b> </p></li><li><h3><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/templates/question-log-template.csv"">Question log (CSV)</a></h3><p>Keep track of questions you raise with GDS and the answers.</p><p>Template · for Coordinators <b>[Suggested practice]</b> </p></li><li><h3><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/templates/return-log-template.csv"">Return log (CSV)</a></h3><p>Track returns from the organisations that report to you.</p><p>Template · for Coordinators <b>[Suggested practice]</b> </p></li><li><h3><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/asset-test.html"">Asset test</a></h3><p>Check a possible asset against the scope principles, one question at a time.</p><p>Tool · for Coordinators, Data owners <b>[Suggested practice]</b> </p></li><li><h3><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#check"">Is my list ready to send?</a></h3><p>Check your workbook in your browser before you send it. Nothing is uploaded.</p><p>Tool · for Coordinators, Data stewards <b>[Suggested practice]</b> </p></li><li><h3><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html"">Your return, step by step</a></h3><p>Twelve steps, with progress saved on your device.</p><p>Tool · for Coordinators <b>[Suggested practice]</b> </p></li><li><h3><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/embed.html"">Embedding the policy</a></h3><p>Make it part of business as usual and of every change project.</p><p>Tool · for Chief data officers, Project and service teams <b>[Suggested practice]</b> </p></li></ul>", flag: ""},
  {pid: "resources", n: 3, h: "Meetings and recordings", x: "<p>The coordinators' FAQ and meeting recordings are kept with the DAM Policy Coordinators Working Group on the Knowledge Hub. If you cannot open something, <a href=""https://forms.cloud.microsoft/e/SLBvuPX7jK"">tell us through the contact form</a> and we will send it another way.</p>", flag: ""},
  {pid: "guide", n: 1, h: "Overview", x: "<p>How to use the explorer, and every way to open it: in a browser on any device, installed like an app, in Microsoft Teams, Outlook and the Microsoft 365 app, in Copilot, or on your intranet.</p>", flag: "New"},
  {pid: "guide", n: 2, h: "Quick start for coordinators", x: "<ol><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/policy.html""><b>Read the policy in plain English</b></a>Five minutes on what the policy asks and who does what.</li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/asset-test.html""><b>Test your possible assets</b></a>Five questions per asset. Anything you are not sure about is included and flagged.</li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html""><b>Work through your return</b></a>Twelve steps. Mark each one done; your progress is kept on your device.</li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#check""><b>Check your list before you send it</b></a>Open the CSV of your workbook. It is read in your browser and never uploaded.</li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/track.html""><b>Track it, and see what it shows</b></a>Record each stage, and see how ready each asset is.</li></ol> <p>Stuck? Type your question in <b>Ask a question</b> at the top of any page, or browse <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html"">questions and answers</a>.</p>", flag: "New"},
  {pid: "guide", n: 3, h: "Tours and tutorials", x: "<p>Each tutorial opens the right page and walks you through it, one step at a time. You can stop at any point with <b>Close the tour</b> or the Escape key. Pages with a tour also have a <b>Take a short tour of this page</b> link under their title.</p> <ul> <li><h3>Find your way around</h3><p>The search box, menu, display settings, your path and your progress. One minute.</p></li> <li><h3>Test whether an asset is in scope</h3><p>The five questions, what happens when you are not sure, and how to export your list of assets left out.</p></li> <li><h3>Check your list before you send it</h3><p>Open your workbook as a CSV, read the result, and track the twelve steps.</p></li> <li><h3>Track your return and see what it shows</h3><p>Record the stage, open what you sent, and see the measures GDS will report.</p></li> <li><h3>Find an answer and share it</h3><p>Search, filter by topic, read the labels, and copy a link to an answer for Teams or email.</p></li> </ul>", flag: "New"},
  {pid: "guide", n: 4, h: "Finding your way around", x: "<ul> <li><b>The menu</b> at the top takes you between sections. On a narrow screen it folds behind the <b>Menu</b> button.</li> <li><b>Page contents</b>, on the left, lists the sections of the page you are on. Hide or show it with its switch.</li> <li><b>What to do next</b>, at the end of each page, suggests the next step and related pages.</li> <li><b>Tooltips</b>: point at, or tab to, menu items, buttons, labels and words with a dotted underline to see what they mean or do. Press Escape to hide one. Every word is also in the <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html"">glossary</a>.</li> <li><b>Labels on answers</b> tell you how far to rely on them: Policy, GDS position, Suggested practice, Programme plan or Open.</li> <li><b>Display</b>, at the top, changes colours (including high contrast), text size, spacing, animation and link underlining.</li> </ul>", flag: "New"},
  {pid: "guide", n: 5, h: "On any device, in a web browser", x: "<p>Open <b>https://cyberdudeuk.github.io/dam-policy-explorer/</b> in Edge, Chrome, Safari or Firefox, on a computer, tablet or phone. You do not need an account or to sign in. Bookmark it, or install it:</p> <p><b>How to install the explorer like an app</b></p><p><b>Windows or Mac, Edge</b></p><ul><li><b>How to install it:</b> Open the page, then <b>Settings and more</b> (…) › <b>Apps</b> › <b>Install this site as an app</b>.</li></ul><p><b>Windows, Mac or Chromebook, Chrome</b></p><ul><li><b>How to install it:</b> Open the page, then the install icon in the address bar, or <b>Menu</b> › <b>Cast, save and share</b> › <b>Install page as app</b>.</li></ul><p><b>iPhone or iPad</b></p><ul><li><b>How to install it:</b> Open the page in Safari, then <b>Share</b> › <b>Add to Home Screen</b>.</li></ul><p><b>Android</b></p><ul><li><b>How to install it:</b> Open the page in Chrome, then <b>Menu</b> › <b>Add to home screen</b> or <b>Install app</b>.</li></ul> <p>Once installed, the pages you have opened also work without a connection.</p>", flag: "New"},
  {pid: "guide", n: 6, h: "In Microsoft Teams", x: "<h3>As a tab in a channel, today, with no administrator</h3> <ol><li>In the channel, select <b>+</b> (Add a tab).</li><li>Choose <b>Website</b>.</li><li>Name it ""DAM Policy Explorer"" and paste <b>https://cyberdudeuk.github.io/dam-policy-explorer/</b>.</li><li>Select <b>Save</b>. Everyone in the channel can now open it.</li></ol> <h3>As an app in the Teams sidebar, in Outlook and in the Microsoft 365 app</h3> <p>The app adds Home, Your return, Track and Ask tabs, follows your Teams theme (including high contrast) and works on Teams desktop, web and mobile. Your Teams administrator adds it once for your organisation (see for IT administrators). Then:</p> <ol><li>In Teams, select <b>Apps</b>, then <b>Built for your org</b>.</li><li>Choose <b>DAM Policy Explorer</b>, then <b>Add</b>.</li><li>Right-click its icon in the sidebar and choose <b>Pin</b>. It also appears in Outlook and the Microsoft 365 app under <b>Apps</b>.</li></ol>", flag: "New"},
  {pid: "guide", n: 7, h: "In Microsoft 365 Copilot", x: "<p>Where your organisation has Microsoft 365 Copilot and allows agents, the <b>DAM Policy assistant</b> comes with the app. Open Copilot Chat in Teams or at m365.cloud.microsoft, choose the assistant from the list of agents, and ask your question. It answers only from GOV.UK, this explorer and the capability playbooks, and shows where each answer comes from. It is an AI tool: check important answers against the source it gives.</p>", flag: "New"},
  {pid: "guide", n: 8, h: "On your intranet or SharePoint", x: "<ul> <li><b>Link to it</b> from a news post, a Quick links web part or your data pages: <b>https://cyberdudeuk.github.io/dam-policy-explorer/</b>.</li> <li><b>Embed a page</b> using SharePoint's <b>Embed</b> web part. A SharePoint administrator may first need to allow <b>cyberdudeuk.github.io</b> under the site's <b>HTML Field Security</b> settings.</li> <li><b>Link to one answer</b>: open it on the questions page and choose <b>Copy a link to this answer</b>.</li> </ul>", flag: "New"},
  {pid: "guide", n: 9, h: "For IT administrators: add it for your organisation", x: "<h3>Microsoft Teams, Outlook and the Microsoft 365 app</h3> <p><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/downloads/dam-policy-explorer-teams.zip""> Download the Microsoft 365 app package (.zip)</a></p> <ol> <li>Download the app package from this page.</li> <li>In the <b>Teams admin centre</b>, go to <b>Teams apps</b> › <b>Manage apps</b> › <b>Actions</b> › <b>Upload new app</b>, and upload the package.</li> <li>Check it is allowed in your app permission policies. To pin it for a group of people, add it to a <b>setup policy</b>.</li> <li>For the Copilot assistant, allow the app under <b>Integrated apps</b> in the Microsoft 365 admin centre. People need Microsoft 365 Copilot licences to use it.</li> </ol> <h3>What the app does and does not do</h3> <ul> <li>It is a set of web pages at <b>cyberdudeuk.github.io</b>. Allow that address through your web filter.</li> <li>No sign-in, no cookies, no tracking and no server storing anything about users. Settings, progress and tested assets stay in each person's browser.</li> <li>Files people check, such as a return workbook, are read in their browser and never uploaded.</li> <li>The pages use a strict content security policy: no inline scripts, and nothing loaded from other sites.</li> <li>The app asks Teams for no permissions to read user data. It only follows the Teams theme.</li> <li>Every release passes automated accessibility, security and content checks before it is published.</li> </ul> <p>The source code, checks and change history are public. <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/about.html#transparency"">How it was made</a>.</p>", flag: "New"},
  {pid: "guide", n: 10, h: "Getting help", x: "<p>Use the <a href=""https://forms.cloud.microsoft/e/SLBvuPX7jK"">contact form</a> for questions, problems or suggestions. For questions about your own return, speak to your organisation's lead DAM Policy coordinator.</p>", flag: "New"},
  {pid: "ask", n: 1, h: "Overview", x: "<p>Type a question in your own words. The explorer finds the best answers from everything it holds: questions and answers, the glossary, roles and capabilities.</p>", flag: ""},
  {pid: "ask", n: 2, h: "Answers", x: "<p>Ask a question, or try one of these:</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/ask.html?q=Do arm's length bodies send their own return?"">Do arm's length bodies send their own return?</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/ask.html?q=What goes in the legal gateway field?"">What goes in the legal gateway field?</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/ask.html?q=Do we report APIs or data sets?"">Do we report APIs or data sets?</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/ask.html?q=What counts as an equivalent quality plan?"">What counts as an equivalent quality plan?</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/ask.html?q=When is the next return due?"">When is the next return due?</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/ask.html?q=Do data owners replace information asset owners?"">Do data owners replace information asset owners?</a></li></ul>", flag: ""},
  {pid: "ask", n: 3, h: "Ask the DAM Policy assistant in Copilot", x: "<p>If your organisation uses Microsoft 365 Copilot, the <b>DAM Policy assistant</b> answers in conversation, in Teams and in Copilot Chat. It uses only GOV.UK, this explorer (which includes every answer in the GDS FAQs) and the capability playbooks, and it shows its sources. It is an AI tool: check important answers against the source it gives. <b>[Suggested practice]</b> </p> <p>How the search on this page works: it matches the words in your question, and common alternatives such as ALB for arm's length body, against the explorer's content and ranks the closest matches. It is not generative AI and does not make up answers.</p>", flag: "Updated"},
  {pid: "team", n: 1, h: "Overview", x: "Process returns and answer questions <p>For the GDS team: how a return travels from the mailbox to the register, and how to give clear, consistent answers.</p> <p> This page describes how our team works and the processing we propose. It is not published guidance.</p>", flag: ""},
  {pid: "team", n: 2, h: "What do you need to do?", x: "<ul> <li>A return has arrived: check it</li> <li>Someone has asked a question: answer it</li> <li>See every step of the process</li> <li>See what still needs deciding</li> </ul>", flag: ""},
  {pid: "team", n: 3, h: "How does a return move through the team?", x: "<p>Proposed design, not yet built The same process at four levels of detail, from a summary to every decision. Start with the summary and go deeper only if you need to.</p> <h3>From returns to action, in five stages</h3> <ol><li><h3>Collect</h3><p>Organisations send their returns. We keep each original file exactly as it arrived.</p></li><li><h3>Assure</h3><p>We check every return. Where something needs correcting, we ask the organisation to correct it.</p></li><li><h3>Consolidate</h3><p>Accepted returns go into one cross-government register of critical data assets.</p></li><li><h3>Understand</h3><p>Quick measures first, then a fuller dashboard, show where things stand.</p></li><li><h3>Act</h3><p>We use what we learn to decide where support is needed most.</p></li></ol> <h4> Evidence we can trust</h4><p>The original return, every correction, every checking result and every decision is kept and can be traced.</p> <h4> One register</h4><p>The register is the bridge between the returns we receive and the analysis across government.</p> <h4> Insight we can act on</h4><p>We can see where ownership, stewardship, catalogues, quality plans and sharing need support.</p> <ul><li>Security</li><li>Audit trail</li><li>Where data came from (lineage)</li><li>Version control</li><li>Records management</li></ul> <h3>Every step, from the organisation to the dashboard</h3> <p>Read from top to bottom. Each column is a lane: who or what does the work. Choose any step to see what happens there. From its details you can open the job or the decision behind it.</p> <p><b>Using the map with a keyboard</b></p><ul> <li>Tab moves from step to step. Enter or Space opens a step’s details.</li> <li>The down arrow follows the first arrow out of a step. The right arrow follows the second, such as a decision’s other answer. The up arrow goes back.</li> <li>The text version under the map has every step and where it goes next.</li></ul> <p><b>Who works in each lane</b></p><ul><li><b>Organisation sending the return</b>: The organisation’s coordinator</li><li><b>Team mailbox</b>: The team’s shared mailbox (Outlook)</li><li><b>Receiving and logging</b>: Automated (Power Automate)</li><li><b>Safe storage</b>: A restricted SharePoint library</li><li><b>Checking</b>: Automated (Power Automate and Office Scripts)</li><li><b>Review and questions</b>: The GDS team</li><li><b>The register</b>: The cross-government register of critical data assets</li><li><b>Measures and action</b>: Quick measures and the analytics dashboard</li></ul> <ul><li>Done by a person</li><li>Automated</li><li>Decision (angled ends)</li><li>Something to fix</li><li>Accepted</li><li>Storage (round ends)</li><li>The register (thick border)</li><li>Measures and dashboard</li><li>Main path</li><li>Exception path (dashed)</li></ul> <p>The map needs JavaScript. The text version below has the same steps.</p> <p> Choose a step on the map to see what happens there, where it comes from and where it goes next.</p> <ul><li>Security</li><li>Audit trail</li><li>Where data came from (lineage)</li><li>Version control</li><li>Records management</li></ul> <p><b>Text version of the map</b></p><ol><li><b>P01 Fill in the Baseline Return</b> (Organisation sending the return). The organisation fills in the Baseline Return workbook (version 3). The Baseline Return is the first list of critical data assets each organisation sends. Next: Send the return.</li><li><b>P02 Send the return</b> (Organisation sending the return). The organisation emails the finished workbook to the team’s shared mailbox. Next: Email and workbook arrive.</li><li><b>P03 Email and workbook arrive</b> (Team mailbox). The email and its attached workbook (an XLSX file) arrive in the shared mailbox. Next: Give it a reference number.</li><li><b>P04 Give it a reference number</b> (Receiving and logging). Each return gets its own submission reference, with the sender, the time it arrived and the email’s ID. Next: Keep the original.</li><li><b>P05 Keep the original</b> (Receiving and logging). The original file is saved exactly as it arrived. Nobody changes it. Next: Restricted library.</li><li><b>DS01 Restricted library</b> (Safe storage). Originals are kept in a restricted SharePoint library (Microsoft’s shared document store). Next: Record the details.</li><li><b>P06 Record the details</b> (Receiving and logging). The return’s details are recorded and its status is set to “received”. Next: Check the workbook.</li><li><b>SP01 Check the workbook</b> (Checking). Checks that the file opens, is the approved version 3 and has the expected layout. Next: Is the workbook valid?.</li><li><b>D01 Is the workbook valid?</b> (Checking). Is this the approved version 3 workbook, laid out as expected? Next: Check each asset (if yes); Log the issue (if no).</li><li><b>SP02 Check each asset</b> (Checking). Checks every asset in the return: required details, allowed answers, purposes and links between answers. Next: Anything blocking or unclear?.</li><li><b>D02 Anything blocking or unclear?</b> (Checking). Is there a mistake, or something unclear, that stops us using the return? Next: Log the issue (if yes); Accept the return (if no).</li><li><b>P07 Log the issue</b> (Review and questions). The issue is written in the checking log, so nothing is lost. Next: A person reviews it.</li><li><b>P08 A person reviews it</b> (Review and questions). A team member looks at the issue and decides what to do. Next: Does it need correcting?.</li><li><b>D03 Does it need correcting?</b> (Review and questions). Does the organisation need to change something, or can we accept it as it is? Next: Ask for a correction (if yes); Accept the return (if no).</li><li><b>P09 Ask for a correction</b> (Review and questions). We email the coordinator to ask for a correction. They send a corrected return, which starts again at the mailbox. Next: Email and workbook arrive (if corrected return).</li><li><b>P10 Accept the return</b> (Review and questions). The return is accepted. We keep the original, the checked version, the checking log and our decision. Next: Add to the register.</li><li><b>SP03 Add to the register</b> (The register). Each accepted asset is added to the register, or updates its earlier entry, keeping a record of where it came from. Next: The register.</li><li><b>DS02 The register</b> (The register). One managed register of critical data assets across government. Every entry shows where it came from. Next: Work out quick measures; Update the dashboard.</li><li><b>SP04 Work out quick measures</b> (Measures and action). Quick measures from the register, available straight away. Next: Quick measures.</li><li><b>SP05 Update the dashboard</b> (Measures and action). Updates the fuller analysis behind the dashboard. Next: Dashboard.</li><li><b>O01 Quick measures</b> (Measures and action). For example: how many assets, and how many have an owner, a steward and a quality plan. Next: Decide where to help.</li><li><b>O02 Dashboard</b> (Measures and action). Views for senior leaders and for each department. Next: Decide where to help.</li><li><b>P11 Decide where to help</b> (Measures and action). Find where the policy is not yet met, who needs most support and what patterns there are across government. Next: the end.</li></ol> <p><b>What the register holds</b></p><p>One entry for each asset, as each organisation reported it:</p><ul><li>Organisation</li><li>Lasting asset reference</li><li>Submission reference</li><li>Return version</li><li>Reporting cycle</li><li>The 24 details from the version 3 workbook</li><li>The original file</li><li>Checking result</li><li>Review decision</li><li>Where each value came from</li></ul><p>Each value can be traced from what was sent, to what was checked, to what we accepted.</p> <h3>The seven jobs, step by step</h3> <p>Each job is a step on the map, opened up. The design notes call these workflows. and are the proposed tools.</p> <p>WF01 · Receiving and logging</p><h3>Receive the return</h3><p> : Outlook shared mailbox and Power Automate</p><ol><li>An email arrives in the shared mailbox</li><li>Is it a data asset return?</li><li>Is a workbook (XLSX file) attached?</li><li>Record the email’s ID, the sender and the time it arrived</li><li>Give the return a submission reference</li></ol><p> <b>Result:</b> A submission record</p><p>WF02 · Safe storage</p><h3>Keep the original and record it</h3><p> : Power Automate and a restricted SharePoint library</p><ol><li>Save the original file exactly as it arrived</li><li>Store it in the restricted library</li><li>Record its details</li><li>Set its status to “received”</li></ol><p> <b>Result:</b> The original, kept safe, and its record</p><p>WF03 · Checking</p><h3>Check the workbook</h3><p> : Power Automate and Office Scripts</p><ol><li>Does the file open?</li><li>Is it the approved version 3 workbook?</li><li>Is the layout as expected?</li><li>Are all the required columns there?</li><li>Has the worked example been removed?</li><li>Has anything else in the layout been changed?</li></ol><p> <b>Result:</b> Pass, or an issue for the team to review</p><p>WF04 · Checking</p><h3>Check each asset</h3><p> : Power Automate and Office Scripts</p><ol><li>For each asset in the return</li><li>Are the required details filled in?</li><li>Are the answers from the allowed lists?</li><li>Check the answers on the seven critical purposes</li><li>Do linked answers agree with each other?</li><li>Is the asset’s identity clear?</li><li>Record its position on owner, steward, catalogue, being findable, quality plan, sharing, classification, origin and location data</li></ol><p> <b>Result:</b> For each asset: pass, policy gap or error</p><p>WF05 · The register</p><h3>Add to the register</h3><p> : The register workbook</p><ol><li>Take the accepted assets from the return</li><li>Match the organisation to its register reference</li><li>Match each asset to its lasting asset reference</li><li>Is it new? Add it. Is this a new return or version? Update it</li><li>Keep the record of its source, its checks and our decision</li></ol><p> <b>Result:</b> An up-to-date register entry for each asset</p><p>WF06 · Measures and action</p><h3>Work out quick measures</h3><p> : Excel</p><ol><li>Number of critical data assets</li><li>Share with a data quality plan or equivalent</li><li>Share with an owner</li><li>Share with a steward</li><li>Share in a <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-data-catalogue"">data catalogue</a></li><li>Share that can be found by others</li><li>Sharing between organisations</li><li>Purposes served</li><li>Where each return has got to</li></ol><p> <b>Result:</b> Quick measures, before the full dashboard is needed</p><p>WF07 · Measures and action</p><h3>Update the dashboard</h3><p> : The analytics dashboard for the Data Asset Management (DAM) Policy</p><ol><li>Senior leaders’ view: overall standards, purposes, sharing and how many organisations have replied</li><li>Department view: quality plans, sharing, assets by purpose, gaps against the standards and priorities</li></ol><p> <b>Result:</b> A view of where things stand, to decide where to help</p> <p><b>Build it in Visio</b></p> <p> has a template. Use it. Draw it landscape, left to right, on A3, with the same IDs, so the drawing can be checked against this page.</p> <h4>Lanes</h4><p><b>1</b></p><ul><li><b>Heading:</b> Organisation sending the return</li><li><b>Who or what:</b> The organisation’s coordinator</li></ul><p><b>2</b></p><ul><li><b>Heading:</b> Team mailbox</li><li><b>Who or what:</b> The team’s shared mailbox (Outlook)</li></ul><p><b>3</b></p><ul><li><b>Heading:</b> Receiving and logging</li><li><b>Who or what:</b> Automated (Power Automate)</li></ul><p><b>4</b></p><ul><li><b>Heading:</b> Safe storage</li><li><b>Who or what:</b> A restricted SharePoint library</li></ul><p><b>5</b></p><ul><li><b>Heading:</b> Checking</li><li><b>Who or what:</b> Automated (Power Automate and Office Scripts)</li></ul><p><b>6</b></p><ul><li><b>Heading:</b> Review and questions</li><li><b>Who or what:</b> The GDS team</li></ul><p><b>7</b></p><ul><li><b>Heading:</b> The register</li><li><b>Who or what:</b> The cross-government register of critical data assets</li></ul><p><b>8</b></p><ul><li><b>Heading:</b> Measures and action</li><li><b>Who or what:</b> Quick measures and the analytics dashboard</li></ul> <h4>Shapes</h4><p><b><code>P01</code></b></p><ul><li><b>Visio shape:</b> Process</li><li><b>Label:</b> Fill in the Baseline Return</li><li><b>Lane:</b> Organisation sending the return</li><li><b>Workflow page:</b> –</li></ul><p><b><code>P02</code></b></p><ul><li><b>Visio shape:</b> Process</li><li><b>Label:</b> Send the return</li><li><b>Lane:</b> Organisation sending the return</li><li><b>Workflow page:</b> –</li></ul><p><b><code>P03</code></b></p><ul><li><b>Visio shape:</b> Process</li><li><b>Label:</b> Email and workbook arrive</li><li><b>Lane:</b> Team mailbox</li><li><b>Workflow page:</b> WF01</li></ul><p><b><code>P04</code></b></p><ul><li><b>Visio shape:</b> Process</li><li><b>Label:</b> Give it a reference number</li><li><b>Lane:</b> Receiving and logging</li><li><b>Workflow page:</b> WF01</li></ul><p><b><code>P05</code></b></p><ul><li><b>Visio shape:</b> Process</li><li><b>Label:</b> Keep the original</li><li><b>Lane:</b> Receiving and logging</li><li><b>Workflow page:</b> WF02</li></ul><p><b><code>DS01</code></b></p><ul><li><b>Visio shape:</b> Data store</li><li><b>Label:</b> Restricted library</li><li><b>Lane:</b> Safe storage</li><li><b>Workflow page:</b> WF02</li></ul><p><b><code>P06</code></b></p><ul><li><b>Visio shape:</b> Process</li><li><b>Label:</b> Record the details</li><li><b>Lane:</b> Receiving and logging</li><li><b>Workflow page:</b> WF02</li></ul><p><b><code>SP01</code></b></p><ul><li><b>Visio shape:</b> Predefined process</li><li><b>Label:</b> Check the workbook</li><li><b>Lane:</b> Checking</li><li><b>Workflow page:</b> WF03</li></ul><p><b><code>D01</code></b></p><ul><li><b>Visio shape:</b> Decision</li><li><b>Label:</b> Is the workbook valid?</li><li><b>Lane:</b> Checking</li><li><b>Workflow page:</b> WF03</li></ul><p><b><code>SP02</code></b></p><ul><li><b>Visio shape:</b> Predefined process</li><li><b>Label:</b> Check each asset</li><li><b>Lane:</b> Checking</li><li><b>Workflow page:</b> WF04</li></ul><p><b><code>D02</code></b></p><ul><li><b>Visio shape:</b> Decision</li><li><b>Label:</b> Anything blocking or unclear?</li><li><b>Lane:</b> Checking</li><li><b>Workflow page:</b> WF04</li></ul><p><b><code>P07</code></b></p><ul><li><b>Visio shape:</b> Process</li><li><b>Label:</b> Log the issue</li><li><b>Lane:</b> Review and questions</li><li><b>Workflow page:</b> –</li></ul><p><b><code>P08</code></b></p><ul><li><b>Visio shape:</b> Process</li><li><b>Label:</b> A person reviews it</li><li><b>Lane:</b> Review and questions</li><li><b>Workflow page:</b> –</li></ul><p><b><code>D03</code></b></p><ul><li><b>Visio shape:</b> Decision</li><li><b>Label:</b> Does it need correcting?</li><li><b>Lane:</b> Review and questions</li><li><b>Workflow page:</b> –</li></ul><p><b><code>P09</code></b></p><ul><li><b>Visio shape:</b> Process</li><li><b>Label:</b> Ask for a correction</li><li><b>Lane:</b> Review and questions</li><li><b>Workflow page:</b> –</li></ul><p><b><code>P10</code></b></p><ul><li><b>Visio shape:</b> Process</li><li><b>Label:</b> Accept the return</li><li><b>Lane:</b> Review and questions</li><li><b>Workflow page:</b> –</li></ul><p><b><code>SP03</code></b></p><ul><li><b>Visio shape:</b> Predefined process</li><li><b>Label:</b> Add to the register</li><li><b>Lane:</b> The register</li><li><b>Workflow page:</b> WF05</li></ul><p><b><code>DS02</code></b></p><ul><li><b>Visio shape:</b> Data store</li><li><b>Label:</b> The register</li><li><b>Lane:</b> The register</li><li><b>Workflow page:</b> WF05</li></ul><p><b><code>SP04</code></b></p><ul><li><b>Visio shape:</b> Predefined process</li><li><b>Label:</b> Work out quick measures</li><li><b>Lane:</b> Measures and action</li><li><b>Workflow page:</b> WF06</li></ul><p><b><code>SP05</code></b></p><ul><li><b>Visio shape:</b> Predefined process</li><li><b>Label:</b> Update the dashboard</li><li><b>Lane:</b> Measures and action</li><li><b>Workflow page:</b> WF07</li></ul><p><b><code>O01</code></b></p><ul><li><b>Visio shape:</b> Document</li><li><b>Label:</b> Quick measures</li><li><b>Lane:</b> Measures and action</li><li><b>Workflow page:</b> WF06</li></ul><p><b><code>O02</code></b></p><ul><li><b>Visio shape:</b> Display</li><li><b>Label:</b> Dashboard</li><li><b>Lane:</b> Measures and action</li><li><b>Workflow page:</b> WF07</li></ul><p><b><code>P11</code></b></p><ul><li><b>Visio shape:</b> Process</li><li><b>Label:</b> Decide where to help</li><li><b>Lane:</b> Measures and action</li><li><b>Workflow page:</b> –</li></ul> <h4>Connectors</h4><pre>P01 → P02 P02 → P03 P03 → P04 P04 → P05 P05 → DS01 DS01 → P06 P06 → SP01 SP01 → D01 D01 → SP02 [Yes] D01 → P07 [No] SP02 → D02 D02 → P07 [Yes] D02 → P10 [No] P07 → P08 P08 → D03 D03 → P09 [Yes] D03 → P10 [No] P09 → P03 [Corrected return] P10 → SP03 SP03 → DS02 DS02 → SP04 DS02 → SP05 SP04 → O01 SP05 → O02 O01 → P11 O02 → P11</pre> <h4>Colours</h4><ul><li>Done by a person: #D9EAF7</li><li>Automated (Power Automate): #E4DFEC</li><li>Decision: #FFF2CC</li><li>Error or correction: #FCE4D6</li><li>Accepted: #E2F0D9</li><li>The register: #A9D18E with a dark green 3 pt border</li><li>Measures and dashboard: #DDEBF7</li><li>Controls: #E7E6E6</li></ul> <h4>Shape data for every step</h4><p>: process ID, process name, owner, system, automated or not, input, output, where failures go, evidence produced, data classification, status and version.</p> <p>Give each workflow its own page, linked from its shape, with a link back to the end-to-end page.</p> <p><b>Mermaid version you can render</b></p> <p> is another way to draw the same map. Paste this into any Mermaid editor. Our tests check that it draws without errors.</p> <pre>flowchart TB subgraph L1[""Organisation sending the return""] P01[""P01: Fill in the Baseline Return""] P02[""P02: Send the return""] end subgraph L2[""Team mailbox""] P03[""P03: Email and workbook arrive""] end subgraph L3[""Receiving and logging""] P04[""P04: Give it a reference number""] P05[""P05: Keep the original""] P06[""P06: Record the details""] end subgraph L4[""Safe storage""] DS01[(""DS01: Restricted library"")] end subgraph L5[""Checking""] SP01[[""SP01: Check the workbook""]] D01{""D01: Is the workbook valid?""} SP02[[""SP02: Check each asset""]] D02{""D02: Anything blocking or unclear?""} end subgraph L6[""Review and questions""] P07[""P07: Log the issue""] P08[""P08: A person reviews it""] D03{""D03: Does it need correcting?""} P09[""P09: Ask for a correction""] P10[""P10: Accept the return""] end subgraph L7[""The register""] SP03[[""SP03: Add to the register""]] DS02[(""DS02: The register"")] end subgraph L8[""Measures and action""] SP04[[""SP04: Work out quick measures""]] SP05[[""SP05: Update the dashboard""]] O01[/""O01: Quick measures""/] O02[/""O02: Dashboard""/] P11[""P11: Decide where to help""] end P01 --&gt; P02 P02 --&gt; P03 P03 --&gt; P04 P04 --&gt; P05 P05 --&gt; DS01 DS01 --&gt; P06 P06 --&gt; SP01 SP01 --&gt; D01 D01 --&gt;|Yes| SP02 D01 --&gt;|No| P07 SP02 --&gt; D02 D02 --&gt;|Yes| P07 D02 --&gt;|No| P10 P07 --&gt; P08 P08 --&gt; D03 D03 --&gt;|Yes| P09 D03 --&gt;|No| P10 P09 --&gt;|Corrected return| P03 P10 --&gt; SP03 SP03 --&gt; DS02 DS02 --&gt; SP04 DS02 --&gt; SP05 SP04 --&gt; O01 SP05 --&gt; O02 O01 --&gt; P11 O02 --&gt; P11 classDef fhuman fill:#D9EAF7,color:#1B1B1B class P01,P02,P08 fhuman classDef fauto fill:#E4DFEC,color:#1B1B1B class P03,P04,P05,P06,SP01,SP02 fauto classDef fdecision fill:#FFF2CC,color:#1B1B1B class D01,D02,D03 fdecision classDef ferror fill:#FCE4D6,color:#1B1B1B class P07,P09 ferror classDef faccept fill:#E2F0D9,color:#1B1B1B class P10,SP03,P11 faccept classDef fregister fill:#A9D18E,stroke:#2E6B1F,stroke-width:3px,color:#1B1B1B class DS02 fregister classDef fstore fill:#E7E6E6,color:#1B1B1B class DS01 fstore classDef finsight fill:#DDEBF7,color:#1B1B1B class SP04,SP05,O01,O02 finsight </pre> <h3>The five decisions, and where each answer leads</h3> <p>D01</p><h3>Is the workbook valid?</h3><p>Is this the approved version 3 workbook, laid out as expected?</p><ul><li><b>Yes</b>Go on to check each asset (WF04)</li><li><b>No</b>Log the issue and pass it to a person to review</li></ul><p>D02</p><h3>Is anything blocking or unclear?</h3><p>After checking each asset: is there a mistake, or something unclear, that stops us using the return?</p><ul><li><b>No</b>Accept the return</li><li><b>Yes</b>Log the issue and pass it to a person to review</li></ul><p>D03</p><h3>Does it need correcting?</h3><p>Having looked at the issue: does the organisation need to change something?</p><ul><li><b>No</b>Accept the return as it is</li><li><b>Yes</b>Email the coordinator to ask for a correction. The corrected return starts again at the mailbox</li></ul><p>R04</p><h3>Pass, policy gap or error? (each asset)</h3><p>What did checking this asset find?</p><ul><li><b>Pass</b>It meets the checks. It goes into the register.</li><li><b>Policy gap</b>An honest answer that shows the policy is not yet met, such as “no quality plan yet”. It goes into the register and shows up in the measures, so we can offer support. It is not an error.</li><li><b>Error</b>A mistake or something unclear. It goes to a person to review and may need a correction.</li></ul><p>A policy gap moves forward. Only an error goes sideways for correction.</p><p>R05</p><h3>New entry or update? (adding to the register)</h3><p>Is this asset already in the register?</p><ul><li><b>No, it is a new asset</b>Add it as a new entry</li><li><b>Yes, and this is a new return or version</b>Update the entry, keeping the record of its source, its checks and our decision</li></ul>", flag: ""},
  {pid: "team", n: 4, h: "How do I answer a question?", x: "<p>Every answer follows the same seven steps, so organisations get the same answer whoever they ask.</p> <ol><li><b>Answer first.</b> Start with the answer, in one or two sentences, using the words the person used.</li><li><b>Say where it comes from.</b> Name the document and the part of it. If two documents disagree, the policy comes first, then the guidance on identifying and recording assets, then the other guidance, then our own playbooks.</li><li><b>Say how sure we are.</b> Use one of the five labels below. Never present a suggestion as if it were agreed.</li><li><b>Give the other reading.</b> If the text could mean something else, say so, and say why we chose this reading.</li><li><b>Say what to note down.</b> Tell them what to record in their return about the reading they used, so their return can be checked against our answer.</li><li><b>Get a second check.</b> If the answer is anything other than published guidance or an agreed decision, a second team member checks it before it is sent.</li><li><b>Publish it.</b> Add the answer, reworded so no person or organisation can be identified, to our published answers. The question is only finished when the answer is published.</li></ol> <h3>How sure is the answer?</h3> <p><b>Published guidance</b></p><p>The policy or the guidance says this.</p><p><b>Agreed decision</b></p><p>A named person decided this, on a known date.</p><p><b>Our suggested reading</b></p><p>Our best reading of unclear text. Not agreed yet.</p><p><b>Working definition</b></p><p>A meaning we use for now, until there is an agreed one.</p><p><b>Not decided</b></p><p>Nobody can answer this yet. Say who will decide.</p> <p><b>Write a reply that follows these steps</b></p> <h3>Your reply</h3> <p><b>The full path of a question, from arriving to published</b></p><ol><li>Log every question once, however it arrived, with who asked, their organisation, the topic and the date.</li><li>Sort it by topic, and look for an answer we have already given before writing a new one.</li><li>Answer from the documents, in order: the policy, the identifying guidance, the other guidance, then our playbooks.</li><li>Where the documents say nothing or disagree, write a suggested reading, mark it as suggested, and write down the case against it.</li><li>Get a second check from another team member.</li><li>If the answer affects other organisations, send it to the person who owns the decision. Tell the person asking that we are waiting for a decision.</li><li>Reply, following the answer standard.</li><li>Publish the answer where people will find it.</li><li>When guidance changes, reopen every answer that relied on the part that changed.</li></ol>", flag: ""},
  {pid: "team", n: 5, h: "How do I check a return?", x: "<p>Check a return, then write one message to the organisation: what must change, what we need to ask, and the policy gaps we have recorded.</p> <p>The file check needs JavaScript, which is switched off or blocked in your browser. You can still use the list of checks below to go through your file by hand.</p> <p><b>What the check looks for</b></p><p>Must fix</p><ul><li>The file has all 24 columns of the version 3 template.</li><li>The 13 details that must be filled in are filled in.</li><li>Text fits the length the template allows.</li><li>Yes or No questions say Yes or No.</li><li>The security marking is <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-official"">OFFICIAL</a> or OFFICIAL-SENSITIVE. SECRET and TOP SECRET data does not go in.</li><li>Critical purposes are numbers from 1 to 7, each used once.</li><li>Answers chosen from a list use one of the list’s values, where we have the list.</li><li>An asset recorded “In catalogue” gives its catalogue reference.</li><li>Geospatial standards come from the list, and “Not applicable” stands alone.</li><li>No asset is marked “Out of scope”.</li><li>There are no email addresses, in the return or in your list of assets left out. The return does not record people’s names or contact details.</li><li>The template’s worked example has been deleted.</li><li>No quote mark is left open, which would join rows together.</li></ul><p>We will ask</p><ul><li>An identifier used more than once, written in any mix of capitals. This is allowed only for an approved version or licence variant.</li><li>In your list of assets left out (our suggestion): which test each one failed, and why.</li></ul><p>Policy gap These are accepted. They are not mistakes: they show us where to help.</p><ul><li>No <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-data-owner"">data owner</a> or no <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-data-steward"">data steward</a> assigned yet.</li><li>The asset is not in a data catalogue yet.</li><li>A gap in data quality assurance.</li></ul><p>Tips</p><ul><li>Recommended details are filled in: sharing status, version and discoverability.</li><li>The security marking is written exactly as OFFICIAL or OFFICIAL-SENSITIVE.</li><li>Asset names spell out abbreviations, and no two assets have almost the same name.</li></ul><p>What the check cannot do: it cannot tell whether a detail marked “Fill in if it applies” applies to your asset. For sharing status, access rights, licence, quality status and discoverability, it checks that you answered, but not your answer, because we do not yet have the workbook’s full lists.</p> <p><b>All 11 steps for processing a return by hand</b></p><ol><li><b>Log it and say thank you.</b> Record the file, who sent it, their organisation and the date, and give it a reference number. Reply to say it has arrived. Keep the original file unchanged.</li><li><b>Check who sent it.</b> Match it to the organisation and its group. Note if the organisation has changed its name or merged.</li><li><b>Check the file.</b> Use the file check above. It finds missing columns, wrong values and anything above OFFICIAL-SENSITIVE.</li><li><b>Check each asset.</b> Look at the security marking and the critical purposes, whether an owner and a steward are assigned, the quality plan status and the plain-English names.</li><li><b>Compare with what we already know.</b> Compare the return with the starter list we made for the organisation. Note anything on our list that is missing from the return.</li><li><b>Look for assets that should be there.</b> Other organisations may say they get data from this one. If that data is not in the return, ask about it. Leaving an asset out avoids work, so it can happen without anyone meaning to.</li><li><b>Ask once.</b> Send one email with all the questions, clear enough to be answered in one reply. The file check above writes it for you.</li><li><b>Accept it.</b> Accept the return and mark its assets as confirmed by the organisation.</li><li><b>Check the group is complete.</b> For each department, check every organisation in its group has sent a return or is recorded as left out.</li><li><b>Add up the figures.</b> Work out how many organisations have sent a return, and how complete the returns are. Only report a middle value (median) for a type of organisation when three or more of them answered.</li><li><b>Pass on what we learned.</b> Turn repeated questions into published answers, and fix the template where it confused people.</li></ol>", flag: ""},
  {pid: "team", n: 6, h: "What do we keep a record of?", x: "<p>Log every question and every return, so nothing is lost and we can see how quickly we respond.</p> <p><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/templates/question-log-template.csv""> Download the question log template (CSV)</a> <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/templates/return-log-template.csv""> Download the return log template (CSV)</a></p> <p><b>What to record, and why</b></p> <p><b>For each question:</b> the date it arrived, how it arrived, who asked and their organisation, the topic, the answer, how sure we are, who checked it, the date we replied and the date we published it.</p> <p><b>For each return:</b> the date it arrived, the organisation, the file name, what the check found, the questions we sent and when, and the date we accepted it.</p> <p>These let us measure how long people wait for a reply and how many rounds of questions a return needs.</p>", flag: ""},
  {pid: "team", n: 7, h: "What still needs deciding?", x: "<ul> <li>Whether to build the proposed automation, and who will run it.</li> <li>When the return template and its checks are frozen. The proposed date was 31 October 2026, which has passed without a recorded decision.</li> <li>The final list of organisations that must send a return. Until it is agreed, we cannot say a group is complete.</li> <li>Whether each organisation should only be able to edit its own return in the shared workspace.</li> <li>Fixes to the version 3 workbook before January. Our review found nine defects and three other points. For example, its guide says 9 details are required but 13 are marked mandatory, and part of the sheet still offers SECRET and TOP SECRET.</li> </ul> <p><b>Settled on 13 November 2026:</b> returns use the version 3 workbook, which the team’s intake toolkit already uses. The check on this site now follows it.</p>", flag: ""},
  {pid: "about", n: 1, h: "Overview", x: "<p>A one-stop shop for the Data Asset Management Policy, made for DAM Policy coordinators and usable by anyone.</p>", flag: ""},
  {pid: "about", n: 2, h: "Why we made it", x: "<p>Coordinators told us the policy material was spread across GOV.UK, the Knowledge Hub, slide decks, recordings and email, and that some of it was hard to find or read. They asked for simpler, clearer answers in one place. This app brings it together and says where every answer comes from.</p>", flag: ""},
  {pid: "about", n: 3, h: "How we work", x: "<p>We follow the <a href=""https://www.gov.uk/service-manual/service-standard"">Service Standard</a>, the <a href=""https://gds-way.digital.cabinet-office.gov.uk/"">GDS Way</a> and the <a href=""https://www.gov.uk/guidance/content-design/writing-for-gov-uk"">GOV.UK guidance on writing</a>. That means we start from users' needs, write in plain English, make every page work without JavaScript, test with assistive technology and publish what we change.</p>", flag: ""},
  {pid: "about", n: 4, h: "Where you can use it", x: "<ul> <li><h3>Any web browser</h3><p>Current versions of Edge, Chrome, Safari and Firefox, on computers, tablets and phones. Pages work without JavaScript.</p></li> <li><h3>Microsoft Teams</h3><p>As a personal app in the Teams sidebar, on desktop, web and mobile. Its colours follow your Teams theme, including high contrast. You can also pin it in a channel as a website tab.</p></li> <li><h3>Outlook and the Microsoft 365 app</h3><p>The same app opens in Outlook and the Microsoft 365 app, once your administrator has made it available.</p></li> <li><h3>Installed, and offline</h3><p>Install it from your browser's menu, like an app. After your first visit, the pages you have opened work without a connection.</p></li> <li><h3>SharePoint and intranets</h3><p>Link to it, or embed a page using SharePoint's embed web part, where your organisation allows it.</p></li> <li><h3>Print and PDF</h3><p>Every page prints cleanly, with hidden sections opened and link addresses shown.</p></li> </ul>", flag: ""},
  {pid: "about", n: 5, h: "What we learned from similar services", x: "<p>We looked at how other governments and regulators help people put a data policy into practice, and used what works.</p> <ul><li><a href=""https://design-system.service.gov.uk/patterns/step-by-step-navigation/"">GOV.UK step-by-step navigation</a>The six-stage journey shown on every main page, and the twelve steps of the return.</li><li><a href=""https://design-system.service.gov.uk/patterns/question-pages/"">GOV.UK question pages: one thing per page</a>The asset test asks one thing at a time and explains each result.</li><li><a href=""https://ico.org.uk/for-organisations/data-sharing-information-hub/"">ICO data sharing information hub</a>Entry points by audience, myths and facts, checklists and templates in one place.</li><li><a href=""https://data.nsw.gov.au/node/337"">NSW Government Data Governance Toolkit</a>Guidance that works at any level of maturity, with a clear statement of what is required and what is advice.</li><li><a href=""https://www.finance.gov.au/sites/default/files/2026-02/data-sharing-for-data-custodians-fact-sheet.docx"">Australian DATA Scheme: data sharing for data custodians</a>Step-by-step decisions that leave a record: the asset test's downloadable list of assets left out.</li><li><a href=""https://fedscoop.com/?p=91490"">US Federal CDO Council implementation guidance</a>Written for the people who implement the policy, not from a policy view: plain answers, routes by role.</li></ul>", flag: ""},
  {pid: "about", n: 6, h: "Transparency: how it was made", x: "<ul> <li><b>Sources.</b> Facts about the policy come only from GOV.UK. Answers from GDS that are not yet published are labelled with the date they were given. Suggested practice is labelled as such.</li> <li><b>Needs.</b> The questions this app answers come from the GDS question register. Names and organisations are removed.</li> <li><b>Contact form.</b> Messages go to a Microsoft Form that only GDS can see. Your email address is asked for only if you want a reply, and is used only to reply.</li> <li><b>Use of AI.</b> Built with the help of an AI assistant (Claude, made by Anthropic), which also drew the icons and illustrations. A person is responsible for the content.</li> <li><b>Checks.</b> Every build is tested for accessibility (WCAG 2.2 AA) at phone, tablet and desktop widths, in light, dark and high contrast, and for broken links and out-of-date wording.</li> </ul> <h3>Sources</h3><ul><li><a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy in government</a></li><li><a href=""https://www.gov.uk/government/publications/identify-and-record-critical-data-assets/identifying-and-recording-critical-data-assets"">Identifying and recording critical data assets</a></li><li><a href=""https://www.gov.uk/government/publications/record-metadata-to-describe-critical-data-assets/recording-metadata-to-describe-critical-data-assets"">Recording metadata to describe critical data assets</a></li><li><a href=""https://www.gov.uk/government/publications/data-ownership-in-government/data-ownership-model"">Data ownership model</a></li><li><a href=""https://www.gov.uk/government/publications/implement-a-data-quality-action-plan/data-quality-action-plan-implementation-guide"">Data quality action plan: implementation guide</a></li><li><a href=""https://www.gov.uk/government/publications/implement-a-data-quality-action-plan/data-quality-issues-framework"">Data quality issues framework</a></li><li><a href=""https://www.gov.uk/government/publications/the-government-data-quality-framework"">The Government Data Quality Framework</a></li><li><a href=""https://www.gov.uk/guidance/make-better-use-of-data"">Technology Code of Practice, point 10: make better use of data</a></li><li><a href=""https://www.gov.uk/service-manual/service-standard"">Service Standard</a></li></ul>", flag: ""},
  {pid: "about", n: 7, h: "Privacy", x: "<p>There are no cookies, no tracking and no analytics. Your display settings, your progress through the return and your list of tested assets are saved only in your own browser, on this device. Files you check are read by your browser and are never uploaded. To remove everything, choose <b>Reset to standard</b> in Display settings and clear the list on the asset test page.</p>", flag: ""},
  {pid: "about", n: 8, h: "Self-check", x: "<p>Each time it opens, the app checks itself and reports here.</p> <p>The self-check needs JavaScript.</p>", flag: ""},
  {pid: "about", n: 9, h: "Updates", x: "<p>New or changed answers, including changes to the GDS FAQs, reach you, Teams and the Copilot assistant through a new release of this explorer, recorded under What changed. We re-read the GOV.UK sources and the question register at least every 30 days. If a page has not been checked for longer than that, it shows a warning at the top. Sources were last checked on 18 November 2026.</p>", flag: "Updated"},
  {pid: "about", n: 10, h: "Roadmap", x: "<ul><li> <b>[Now]</b> Publish agreed answers on asset boundaries, the <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-legal-gateway"">legal gateway</a> field and quality plan evidence as soon as they are agreed.</li><li> <b>[Now]</b> Worked examples and decision routes for hard cases (third-party data, restricted data, potential reuse), once the working group has agreed them.</li><li> <b>[Now]</b> User research with coordinators on the explorer, including people who use assistive technology.</li><li> <b>[Next]</b> Host the explorer inside Teams for everyone in the coordinators' group.</li><li> <b>[Next]</b> Show each organisation's return status once returns arrive, with their agreement.</li><li> <b>[Later]</b> Welsh language version, and Easy Read summaries of the main pages.</li></ul>", flag: "Updated"},
  {pid: "about", n: 11, h: "What changed", x: "<ul><li>18 November 2026 <b>Version 1.2.0.</b> Worked examples: 71 cases you can search and filter by topic, outcome and status, 35 of them agreed. From the community forum and coordinators' questions: a practical kit for data owners and stewards, a briefing outline for arm's length bodies, answers on the Performance Framework, the <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-metadata"">metadata</a> minimum, standards for new services, and arm's length bodies nobody has contacted. Track and analyse: record where your return has got to, see what you sent and how ready each asset is, and the measures GDS will report. Assets you are not sure about are now included provisionally and flagged. Contact by Microsoft Form. Version 3 of the return template confirmed.</li><li>18 November 2026 <b>Version 1.1.0.</b> The explorer: home for coordinators, the policy in plain English, asset test, questions and answers built from forum questions, embedding in business as usual and change, resources, glossary with definitions on hover, display settings, and Teams theme support.</li><li>13 November 2026 <b>Version 1.0.0.</b> Return steps, list check and the GDS team pages (earlier build, now part of the explorer).</li></ul>", flag: "Updated"},
  {pid: "about", n: 12, h: "Contact", x: "<p><a href=""https://forms.cloud.microsoft/e/SLBvuPX7jK"">Use our contact form</a> to ask a question, report a problem or suggest a change. It is a Microsoft Form: you do not need to sign in, and only GDS sees what you send. Give a work email address only if you want a reply.</p>", flag: ""},
  {pid: "accessibility", n: 1, h: "Overview", x: "<p>We want everyone to be able to use this app, whatever their needs, device or way of working.</p>", flag: ""},
  {pid: "accessibility", n: 2, h: "Using this app", x: "<ul> <li>Change colours (including high contrast), text size, spacing and animation in <b>Display settings</b> at the top of every page.</li> <li>Zoom up to 400% without anything being cut off or needing sideways scrolling.</li> <li>Use the whole app with a keyboard, a screen reader, voice control or a switch.</li> <li>Read every page with JavaScript turned off. Only the interactive tools need it.</li> <li>Point at, or tab to, any word with a dotted underline to see what it means.</li> <li>Print any page: hidden sections open when you print.</li> </ul>", flag: ""},
  {pid: "accessibility", n: 3, h: "Inclusion", x: "<ul> <li>We write in plain English, test our pages for reading age, and explain every specialist term.</li> <li>We make no assumptions about where people work, their size of organisation or their maturity with data. Small <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-arms-length-body"">arm's length bodies</a> are as much our users as large departments.</li> <li>Answers do not depend on knowing who to ask. Everything we tell one coordinator, we publish for all.</li> <li>The app works on slow connections and older devices: there are no web fonts, no tracking and no large downloads.</li> </ul>", flag: ""},
  {pid: "accessibility", n: 4, h: "How accessible it is", x: "<p>This app aims to meet the <a href=""https://www.w3.org/TR/WCAG22/"">Web Content Accessibility Guidelines version 2.2</a> to level AA. Every build is checked with an automated tool (axe-core) at three screen widths and in light, dark and high contrast. Automated tools find only some problems, so we will also test with people who use assistive technology.</p> <h3>Known issues</h3> <ul> <li>The contact form is a Microsoft Form. If it does not work with your assistive technology, ask your organisation's DAM Policy coordinator to pass your message on.</li> <li>Links to GOV.UK open in a new tab, because the app may be running inside Microsoft Teams. Each such link says so.</li> <li>We have not yet tested with users of assistive technology. This is on our <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/about.html#roadmap"">roadmap</a>.</li> </ul>", flag: ""},
  {pid: "accessibility", n: 5, h: "Tell us about a problem", x: "<p>If something does not work for you, <a href=""https://forms.cloud.microsoft/e/SLBvuPX7jK"">use our contact form</a>. Tell us the page and what happened.</p>", flag: ""},
  {pid: "accessibility", n: 6, h: "Enforcement", x: "<p>The Equality and Human Rights Commission is responsible for enforcing the Public Sector Bodies (Websites and Mobile Applications) (No. 2) Accessibility Regulations 2018. If you are not happy with how we respond to your complaint, contact the <a href=""https://www.equalityadvisoryservice.com/"">Equality Advisory and Support Service</a>.</p> <p>This statement was prepared on 18 November 2026.</p>", flag: ""}
);
nfQA = Table(
  {id: "scope-orgs", topic: "Scope and critical data assets", prov: "Policy", q: "Which organisations does the policy apply to?", x: "<p><b>[Policy]</b> Stated in the published policy or its guidance on GOV.UK.</p><p>All UK government departments and their arm's length bodies: executive agencies, non-departmental public bodies and non-ministerial departments. It is optional for public corporations and for local government. The devolved governments use their own data sharing governance, though the principles are useful to anyone.</p><p><b>Sources</b></p><ul><li><a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy in government</a></li><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[Policy] Stated in the published policy or its guidance on GOV.UK. All UK government departments and their arm's length bodies: executive agencies, non-departmental public bodies and non-ministerial departments. It is optional for public corporations and for local government. The devolved governments use their own data sharing governance, though the principles are useful to anyone. Sources Data Asset Management Policy in government GDS DAM Policy FAQs, November 2026", col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1), flag: ""},
  {id: "principles", topic: "Scope and critical data assets", prov: "GDS position", q: "Exactly what is in scope? (the four scope principles)", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>An asset is in scope only if it is OFFICIAL and all four principles apply together:</p><ol><li><b>It meets a critical criterion</b>: it supports at least one of the seven critical purposes.</li><li><b>It is shared</b>: it has value across government through reuse. It is shared with a public sector organisation under a data sharing agreement, published as open data, or could create value if shared.</li><li><b>You are accountable for it</b>: your organisation manages or controls it, including data from others that you have materially changed or enriched.</li><li><b>It is the source</b>: if an extract, report, API or product is critical, report the source data behind it. Report a product separately only if it is managed and owned in its own right.</li></ol><p>The principles were developed with the DAM Policy Working Group. They put the published guidance into practice, so use them where the template's wording seems to differ. Worked scenarios are being added.</p><p><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/asset-test.html"">Test an asset against the principles</a>.</p><p><b>Sources</b></p><ul><li><a href=""https://www.gov.uk/government/publications/identify-and-record-critical-data-assets/identifying-and-recording-critical-data-assets"">Identifying and recording critical data assets</a></li><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. An asset is in scope only if it is OFFICIAL and all four principles apply together: It meets a critical criterion : it supports at least one of the seven critical purposes. It is shared : it has value across government through reuse. It is shared with a public sector organisation under a data sharing agreement, published as open data, or could create value if shared. You are accountable for it : your organisation manages or controls it, including data from others that you h", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {id: "shared-only", topic: "Scope and critical data assets", prov: "GDS position", q: "Does data we only use inside our organisation count?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>Not on its own. The policy is about data with value across government. Some data is critical inside your organisation, such as some workforce and finance data, but has no value across government, so it is out of scope. An extract of it that is shared for analysis may be in scope.</p><p>GDS recommends labelling assets that are in scope as <code>XG_CDA</code> in your data catalogue, so they are easy to tell apart.</p><p><b>Sources</b></p><ul><li><a href=""https://www.gov.uk/government/publications/identify-and-record-critical-data-assets/identifying-and-recording-critical-data-assets"">Identifying and recording critical data assets</a></li><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Not on its own. The policy is about data with value across government. Some data is critical inside your organisation, such as some workforce and finance data, but has no value across government, so it is out of scope. An extract of it that is shared for analysis may be in scope. GDS recommends labelling assets that are in scope as XG_CDA in your data catalogue, so they are easy to tell apart. Sources Identifying and recording critical data assets GDS DAM Policy FAQs, Novem", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {id: "potential-value", topic: "Scope and critical data assets", prov: "GDS position", q: "How do we judge if data could create value if shared?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>It is a judgement, so be practical and do not hold up your return. For the Baseline Return, start with assets already shared under a data sharing agreement or published as open data. If you have time, add assets that could create value if they were easier to find and use. Signs of that include data that:</p><ul><li>supports needs that many organisations have</li><li>is about common things such as people, places, organisations, businesses or services</li><li>another organisation has asked for</li><li>matters nationally, regionally or across sectors</li></ul><p>More guidance will follow after January 2027, ready for the October 2027 return.</p><p><b>Sources</b></p><ul><li><a href=""https://www.gov.uk/government/publications/identify-and-record-critical-data-assets/identifying-and-recording-critical-data-assets"">Identifying and recording critical data assets</a></li><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. It is a judgement, so be practical and do not hold up your return. For the Baseline Return, start with assets already shared under a data sharing agreement or published as open data. If you have time, add assets that could create value if they were easier to find and use. Signs of that include data that: supports needs that many organisations have is about common things such as people, places, organisations, businesses or services another organisation has asked for matters", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {id: "official-stats", topic: "Scope and critical data assets", prov: "Policy", q: "Are official statistics, or our extracts of another department's statistics, in scope?", x: "<p><b>[Policy]</b> Stated in the published policy or its guidance on GOV.UK.</p><p>Do not list published official statistics themselves. List the data behind them: the administrative data, surveys and censuses. That data is listed by the organisation that is accountable for it.</p><p>An extract you take from another department is yours to list only if you have materially changed or enriched it. Otherwise the source belongs to the other department.</p><p><b>Sources</b></p><ul><li><a href=""https://www.gov.uk/government/publications/identify-and-record-critical-data-assets/identifying-and-recording-critical-data-assets"">Identifying and recording critical data assets</a></li><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[Policy] Stated in the published policy or its guidance on GOV.UK. Do not list published official statistics themselves. List the data behind them: the administrative data, surveys and censuses. That data is listed by the organisation that is accountable for it. An extract you take from another department is yours to list only if you have materially changed or enriched it. Otherwise the source belongs to the other department. Sources Identifying and recording critical data assets GDS DAM Policy FAQs, November 2026", col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1), flag: ""},
  {id: "classified", topic: "Scope and critical data assets", prov: "Policy", q: "Do we report SECRET or TOP SECRET data?", x: "<p><b>[Policy]</b> Stated in the published policy or its guidance on GOV.UK.</p><p>No. Only OFFICIAL data is in scope, including OFFICIAL with markings and descriptors such as sensitive. SECRET and TOP SECRET data is excluded.</p><p>Listing an asset does not force you to share it. The policy does not create a duty to share data or remove any legal obligation.</p><p><b>Sources</b></p><ul><li><a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy in government</a></li><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[Policy] Stated in the published policy or its guidance on GOV.UK. No. Only OFFICIAL data is in scope, including OFFICIAL with markings and descriptors such as sensitive. SECRET and TOP SECRET data is excluded. Listing an asset does not force you to share it. The policy does not create a duty to share data or remove any legal obligation. Sources Data Asset Management Policy in government GDS DAM Policy FAQs, November 2026", col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1), flag: ""},
  {id: "esda", topic: "Scope and critical data assets", prov: "GDS position", q: "How do Essential Shared Data Assets (ESDAs) relate to critical data assets?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>The DAM Policy grew out of the Essential Shared Data Assets policy. The name changed to critical data asset, but the definition is the same. The ESDA exercise was a test using a sample of assets. The DAM Policy applies across all of government.</p><p><b>Sources</b></p><ul><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. The DAM Policy grew out of the Essential Shared Data Assets policy. The name changed to critical data asset, but the definition is the same. The ESDA exercise was a test using a sample of assets. The DAM Policy applies across all of government. Sources GDS DAM Policy FAQs, November 2026", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {id: "internal-shared", topic: "Scope and critical data assets", prov: "Open", q: "Are there two kinds of critical data asset, internal and shared?", x: "<p><b>[Open]</b> Still being decided. The answer says what to do meanwhile.</p><p>For the DAM Policy there is one kind: a critical data asset is OFFICIAL, meets a critical criterion, is shared or has value across government, is yours to account for, and is the source. That is what goes in your return.</p><p>Other exercises, such as the Performance Framework, also ask about data that is critical only inside your organisation. Keep your own list of those if it helps, and label the ones in scope of the DAM Policy <code>XG_CDA</code> so the two are never confused. Agreed wording for the two terms has been asked for and is not settled yet.</p><p><b>Sources</b></p><ul><li><a href=""https://www.gov.uk/government/publications/implement-a-data-quality-action-plan/data-quality-issues-framework"">Data quality issues framework</a></li><li>GDS DAM Policy FAQs, November 2026</li><li>GDS reply to coordinators on the Performance Framework commission, October 2026</li></ul>", t: "[Open] Still being decided. The answer says what to do meanwhile. For the DAM Policy there is one kind: a critical data asset is OFFICIAL, meets a critical criterion, is shared or has value across government, is yours to account for, and is the source. That is what goes in your return. Other exercises, such as the Performance Framework, also ask about data that is critical only inside your organisation. Keep your own list of those if it helps, and label the ones in scope of the DAM Policy XG_CDA so the two are never confused. Agreed wording for the two terms has been asked for and is not settl", col: RGBA(163,38,26,1), tint: RGBA(251,233,231,1), flag: "New"},
  {id: "purpose-fit", topic: "Scope and critical data assets", prov: "GDS position", q: "Does our kind of data fit one of the seven critical purposes?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>Judge by what the data does, not what it is called. For example, biosecurity or biosurveillance data fits national security and resilience where it supports resilience, emergency response or critical functions, as long as it is OFFICIAL. You can give more than one purpose number for an asset.</p><p>Use the purposes and numbering in version 3 of the template, which match the published guidance.</p><p><b>Sources</b></p><ul><li><a href=""https://www.gov.uk/government/publications/implement-a-data-quality-action-plan/data-quality-issues-framework"">Data quality issues framework</a></li><li>DAM Policy Baseline Return template, version 3 (data dictionary and user guide)</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Judge by what the data does, not what it is called. For example, biosecurity or biosurveillance data fits national security and resilience where it supports resilience, emergency response or critical functions, as long as it is OFFICIAL. You can give more than one purpose number for an asset. Use the purposes and numbering in version 3 of the template, which match the published guidance. Sources Data quality issues framework DAM Policy Baseline Return template, version 3 (d", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: "New"},
  {id: "open-scenarios", topic: "Scope and critical data assets", prov: "Open", q: "Which hard cases are still being decided?", x: "<p><b>[Open]</b> Still being decided. The answer says what to do meanwhile.</p><p>GDS is still agreeing how these cases should be handled, and will publish worked examples:</p><ul><li>Third-party data you have enriched, and commercially licensed data</li><li>Assets owned jointly by more than one organisation</li><li>Data sets, scores or predictions produced by AI</li><li>Data held in archived or legacy systems</li><li>Routine exchanges under umbrella agreements</li><li>Dependencies in a data supply chain</li></ul><p>Meanwhile, test each asset against the four scope principles. If you are still not sure, include it in your return and flag it, as the <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/asset-test.html"">asset test</a> does. Tell GDS about the case through the contact form, so it can be covered by an example.</p><p><b>Sources</b></p><ul><li><a href=""https://www.gov.uk/government/publications/implement-a-data-quality-action-plan/data-quality-issues-framework"">Data quality issues framework</a></li><li>GDS interpretation register, August 2026</li><li>DAM Policy coordinator meetings, September to November 2026</li></ul>", t: "[Open] Still being decided. The answer says what to do meanwhile. GDS is still agreeing how these cases should be handled, and will publish worked examples: Third-party data you have enriched, and commercially licensed data Assets owned jointly by more than one organisation Data sets, scores or predictions produced by AI Data held in archived or legacy systems Routine exchanges under umbrella agreements Dependencies in a data supply chain Meanwhile, test each asset against the four scope principles. If you are still not sure, include it in your return and flag it, as the asset test does. Tell", col: RGBA(163,38,26,1), tint: RGBA(251,233,231,1), flag: "New"},
  {id: "machinery", topic: "Scope and critical data assets", prov: "Open", q: "A team is moving to another department. Who returns its assets?", x: "<p><b>[Open]</b> Still being decided. The answer says what to do meanwhile.</p><p>The department that receives the team, because it becomes accountable for the data. Keep each asset's unique identifier when it moves, so it can be traced from one return to the next. How follow-up questions are routed during a move is still being agreed. Meanwhile, tell GDS about the move through your lead coordinator.</p><p><b>Sources</b></p><ul><li><a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy in government</a></li><li>DAM Policy coordinator meetings, September to November 2026</li></ul>", t: "[Open] Still being decided. The answer says what to do meanwhile. The department that receives the team, because it becomes accountable for the data. Keep each asset's unique identifier when it moves, so it can be traced from one return to the next. How follow-up questions are routed during a move is still being agreed. Meanwhile, tell GDS about the move through your lead coordinator. Sources Data Asset Management Policy in government DAM Policy coordinator meetings, September to November 2026", col: RGBA(163,38,26,1), tint: RGBA(251,233,231,1), flag: "New"},
  {id: "own-definition", topic: "Scope and critical data assets", prov: "GDS position", q: "We already have our own definition of critical data assets. What do we do?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>Keep it for your own purposes. The DAM Policy definition covers data with value across government, so some assets you treat as critical will not be in scope. How you manage both is up to you. To keep catalogues consistent across government, label the ones in scope of the policy <code>XG_CDA</code>.</p><p><b>Sources</b></p><ul><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Keep it for your own purposes. The DAM Policy definition covers data with value across government, so some assets you treat as critical will not be in scope. How you manage both is up to you. To keep catalogues consistent across government, label the ones in scope of the policy XG_CDA . Sources GDS DAM Policy FAQs, November 2026", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {id: "not-identified", topic: "Scope and critical data assets", prov: "GDS position", q: "We have not formally identified our critical data assets yet. What now?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>Make a reasonable effort to identify and report them in line with the policy and guidance. The first return sets a baseline to improve from. If you cannot meet a deadline, tell GDS through your lead coordinator.</p><p><b>Sources</b></p><ul><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Make a reasonable effort to identify and report them in line with the policy and guidance. The first return sets a baseline to improve from. If you cannot meet a deadline, tell GDS through your lead coordinator. Sources GDS DAM Policy FAQs, November 2026", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {id: "only-cdas", topic: "Scope and critical data assets", prov: "GDS position", q: "Do we report all our data assets, or only critical ones?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>Only critical data assets as the policy defines them. You can catalogue anything else for your own purposes, but it does not go in the return.</p><p><b>Sources</b></p><ul><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Only critical data assets as the policy defines them. You can catalogue anything else for your own purposes, but it does not go in the return. Sources GDS DAM Policy FAQs, November 2026", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {id: "who-accountable", topic: "Roles and governance", prov: "Policy", q: "Who is accountable, and who should our coordinator be?", x: "<p><b>[Policy]</b> Stated in the published policy or its guidance on GOV.UK.</p><p>Your chief data officer is responsible for putting the policy into practice. If you have no chief data officer, the director responsible for data is accountable. Every asset must have a named data owner.</p><p>The coordinator role comes from the programme, not the policy. Your chief data officer names someone who knows your organisation's data and gives them time for the work. See <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/policy.html#roles"">who does what</a>.</p><p><b>Sources</b></p><ul><li><a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy in government</a></li><li><a href=""https://www.gov.uk/government/publications/data-ownership-in-government/data-ownership-model"">Data ownership model</a></li><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[Policy] Stated in the published policy or its guidance on GOV.UK. Your chief data officer is responsible for putting the policy into practice. If you have no chief data officer, the director responsible for data is accountable. Every asset must have a named data owner. The coordinator role comes from the programme, not the policy. Your chief data officer names someone who knows your organisation's data and gives them time for the work. See who does what . Sources Data Asset Management Policy in government Data ownership model GDS DAM Policy FAQs, November 2026", col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1), flag: ""},
  {id: "iao", topic: "Roles and governance", prov: "Policy", q: "Does the data owner role replace information asset owners?", x: "<p><b>[Policy]</b> Stated in the published policy or its guidance on GOV.UK.</p><p>No. Information asset owners keep their role and their accountability for managing, securing and complying with rules about information assets. The data owner role adds to it by making clear who is accountable for how data is accessed, used, improved and governed. The data ownership model explains the difference. Training for data owners is being developed.</p><p><b>Sources</b></p><ul><li><a href=""https://www.gov.uk/government/publications/data-ownership-in-government/data-ownership-model"">Data ownership model</a></li><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[Policy] Stated in the published policy or its guidance on GOV.UK. No. Information asset owners keep their role and their accountability for managing, securing and complying with rules about information assets. The data owner role adds to it by making clear who is accountable for how data is accessed, used, improved and governed. The data ownership model explains the difference. Training for data owners is being developed. Sources Data ownership model GDS DAM Policy FAQs, November 2026", col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1), flag: ""},
  {id: "shared-service", topic: "Roles and governance", prov: "GDS position", q: "Who reports an asset when ownership is shared or spread across teams?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>The organisation that holds data ownership accountability reports it. Where there is a shared service, agree between you which organisation that is. Others may have stewardship or operational roles, but each asset has one named data owner.</p><p><b>Sources</b></p><ul><li><a href=""https://www.gov.uk/government/publications/data-ownership-in-government/data-ownership-model"">Data ownership model</a></li><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. The organisation that holds data ownership accountability reports it. Where there is a shared service, agree between you which organisation that is. Others may have stewardship or operational roles, but each asset has one named data owner. Sources Data ownership model GDS DAM Policy FAQs, November 2026", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {id: "owner-kit", topic: "Roles and governance", prov: "Suggested practice", q: "Is there practical, day-to-day help for data owners and stewards?", x: "<p><b>[Suggested practice]</b> Written for this app, built on the policy. Helpful, not required.</p><p>Yes: see the <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/embed.html#owners"">practical kit for data owners and stewards</a>. It has a checklist for each role, what to do first, questions to ask yourself each quarter, and a guide for the regular owner and steward conversation. It is built on the data ownership model and the capability playbooks.</p><p>GDS is also developing training for data owners.</p><p><b>Sources</b></p><ul><li><a href=""https://www.gov.uk/government/publications/data-ownership-in-government/data-ownership-model"">Data ownership model</a></li><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[Suggested practice] Written for this app, built on the policy. Helpful, not required. Yes: see the practical kit for data owners and stewards . It has a checklist for each role, what to do first, questions to ask yourself each quarter, and a guide for the regular owner and steward conversation. It is built on the data ownership model and the capability playbooks. GDS is also developing training for data owners. Sources Data ownership model GDS DAM Policy FAQs, November 2026", col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1), flag: "New"},
  {id: "minimum-metadata", topic: "Data management requirements", prov: "Policy", q: "What metadata is mandatory?", x: "<p><b>[Policy]</b> Stated in the published policy or its guidance on GOV.UK.</p><p>The minimum set is in <i>Recording metadata to describe critical data assets</i>. It recommends the Data Catalogue Vocabulary (DCAT) to describe data sets and data services. The UK Cross-Government Metadata Exchange Model is one practical way to apply it.</p><p>The return asks for less than this: a smaller set of details GDS uses to monitor the policy. Keep the full metadata in your own catalogue. See <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-7"">step 7</a>.</p><p><b>Sources</b></p><ul><li><a href=""https://www.gov.uk/government/publications/record-metadata-to-describe-critical-data-assets/recording-metadata-to-describe-critical-data-assets"">Recording metadata to describe critical data assets</a></li><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[Policy] Stated in the published policy or its guidance on GOV.UK. The minimum set is in Recording metadata to describe critical data assets . It recommends the Data Catalogue Vocabulary (DCAT) to describe data sets and data services. The UK Cross-Government Metadata Exchange Model is one practical way to apply it. The return asks for less than this: a smaller set of details GDS uses to monitor the policy. Keep the full metadata in your own catalogue. See step 7 . Sources Recording metadata to describe critical data assets GDS DAM Policy FAQs, November 2026", col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1), flag: ""},
  {id: "mandatory-kinds", topic: "Data management requirements", prov: "GDS position", q: "A field is not in the minimum. Should we stop collecting it?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>No. The minimum is a floor, not a ceiling. Leaving a field out of the return is not an instruction to stop collecting it. GDS has described four senses of ""mandatory"":</p><ul><li><b>Policy mandatory</b>: what the DAM Policy requires you to identify, record, report and own.</li><li><b>Profile mandatory</b>: the metadata profile for exchange, built on DCAT and the UK Metadata Exchange Model.</li><li><b>Locally mandated</b>: extra fields your organisation requires for its own needs. Keep collecting them.</li><li><b>Future adoption</b>: direction of travel, not needed for today's return.</li></ul><p><b>Sources</b></p><ul><li><a href=""https://www.gov.uk/government/publications/record-metadata-to-describe-critical-data-assets/recording-metadata-to-describe-critical-data-assets"">Recording metadata to describe critical data assets</a></li><li>GDS DAM Policy FAQs, November 2026</li><li>GDS clarification to coordinators on the metadata minimum, August 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. No. The minimum is a floor, not a ceiling. Leaving a field out of the return is not an instruction to stop collecting it. GDS has described four senses of ""mandatory"": Policy mandatory : what the DAM Policy requires you to identify, record, report and own. Profile mandatory : the metadata profile for exchange, built on DCAT and the UK Metadata Exchange Model. Locally mandated : extra fields your organisation requires for its own needs. Keep collecting them. Future adoption", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: "New"},
  {id: "discovery-access", topic: "Data management requirements", prov: "Policy", q: "Does recording metadata give others access to our data?", x: "<p><b>[Policy]</b> Stated in the published policy or its guidance on GOV.UK.</p><p>No. Describing an asset helps people find out that it exists and who owns it. Access to the data itself still depends on the law, agreements and controls that already apply. The policy does not create a duty to share. Even sensitive data can be described, so that people know whom to ask.</p><p><b>Sources</b></p><ul><li><a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy in government</a></li><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[Policy] Stated in the published policy or its guidance on GOV.UK. No. Describing an asset helps people find out that it exists and who owns it. Access to the data itself still depends on the law, agreements and controls that already apply. The policy does not create a duty to share. Even sensitive data can be described, so that people know whom to ask. Sources Data Asset Management Policy in government GDS DAM Policy FAQs, November 2026", col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1), flag: "New"},
  {id: "richer-metadata", topic: "Data management requirements", prov: "GDS position", q: "Can we keep richer metadata than the minimum?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>Yes. The policy sets a minimum. Keep any extra metadata you need, and keep meeting any higher standards that already apply to you, such as internal rules, regulation or security policies.</p><p><b>Sources</b></p><ul><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Yes. The policy sets a minimum. Keep any extra metadata you need, and keep meeting any higher standards that already apply to you, such as internal rules, regulation or security policies. Sources GDS DAM Policy FAQs, November 2026", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {id: "iar-catalogue", topic: "Data management requirements", prov: "GDS position", q: "How does a data catalogue relate to our information asset register?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>They overlap but do different jobs. An information asset register is mainly for governance: accountability, risk, security and compliance. A data catalogue helps people find, understand and use data, with richer details such as quality and lineage. A catalogue could replace a register only if it does the governance job as well. Avoid keeping the same details twice: agree one source for the shared fields and link the two.</p><p><b>Sources</b></p><ul><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. They overlap but do different jobs. An information asset register is mainly for governance: accountability, risk, security and compliance. A data catalogue helps people find, understand and use data, with richer details such as quality and lineage. A catalogue could replace a register only if it does the governance job as well. Avoid keeping the same details twice: agree one source for the shared fields and link the two. Sources GDS DAM Policy FAQs, November 2026", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {id: "catalogue-tool", topic: "Data management requirements", prov: "Policy", q: "Do we need a particular data catalogue product?", x: "<p><b>[Policy]</b> Stated in the published policy or its guidance on GOV.UK.</p><p>No. The policy asks you to manage metadata about your assets in your data catalogue and report it to GDS. It does not name a product. GDS ran a catalogue pilot on Microsoft Purview because many organisations already use it, and would repeat the pilot with other tools if there is demand. Peers share how they use their tools at the Data Catalogue and Analysis Platform Working Group.</p><p><b>Sources</b></p><ul><li><a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy in government</a></li><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[Policy] Stated in the published policy or its guidance on GOV.UK. No. The policy asks you to manage metadata about your assets in your data catalogue and report it to GDS. It does not name a product. GDS ran a catalogue pilot on Microsoft Purview because many organisations already use it, and would repeat the pilot with other tools if there is demand. Peers share how they use their tools at the Data Catalogue and Analysis Platform Working Group. Sources Data Asset Management Policy in government GDS DAM Policy FAQs, November 2026", col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1), flag: ""},
  {id: "dqap", topic: "Data management requirements", prov: "GDS position", q: "What counts as a data quality action plan ""or equivalent""?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>Every asset must have a data quality action plan or an equivalent. To count as equivalent, your own process must cover all seven steps of the GDS guide:</p><ol><li>Identify critical data</li><li>Identify data quality rules</li><li>Assess current data quality</li><li>Prioritise improvements and set goals</li><li>Find the root cause and act</li><li>Report on data quality</li><li>Measure again over time</li></ol><p>The policy does not require a particular document or tool. GDS is building a bank of examples.</p><p><b>Sources</b></p><ul><li><a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy in government</a></li><li><a href=""https://www.gov.uk/government/publications/implement-a-data-quality-action-plan/data-quality-action-plan-implementation-guide"">Data quality action plan: implementation guide</a></li><li><a href=""https://www.gov.uk/government/publications/implement-a-data-quality-action-plan/data-quality-issues-framework"">Data quality issues framework</a></li><li><a href=""https://www.gov.uk/government/publications/the-government-data-quality-framework"">The Government Data Quality Framework</a></li><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Every asset must have a data quality action plan or an equivalent. To count as equivalent, your own process must cover all seven steps of the GDS guide: Identify critical data Identify data quality rules Assess current data quality Prioritise improvements and set goals Find the root cause and act Report on data quality Measure again over time The policy does not require a particular document or tool. GDS is building a bank of examples. Sources Data Asset Management Policy i", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {id: "resourcing", topic: "Implementation and support", prov: "GDS position", q: "This is a big task. Do we absorb it or set up a team?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>GDS is not prescriptive about how you organise the work, because organisations differ so much. It will work through the challenges with lead coordinators in the DAM Policy Working Group, and share how others are approaching it.</p><p><b>Sources</b></p><ul><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. GDS is not prescriptive about how you organise the work, because organisations differ so much. It will work through the challenges with lead coordinators in the DAM Policy Working Group, and share how others are approaching it. Sources GDS DAM Policy FAQs, November 2026", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {id: "tranches", topic: "Implementation and support", prov: "GDS position", q: "Are the timings for prioritised support fixed?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>No, they are indicative. They are based on how complex and widely used each department's data was in the ESDA returns. If the timing does not suit your capacity, or you need closer support, raise it through your lead coordinator.</p><p><b>Sources</b></p><ul><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. No, they are indicative. They are based on how complex and widely used each department's data was in the ESDA returns. If the timing does not suit your capacity, or you need closer support, raise it through your lead coordinator. Sources GDS DAM Policy FAQs, November 2026", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {id: "test-return", topic: "Implementation and support", prov: "Suggested practice", q: "Can we get feedback on a test return?", x: "<p><b>[Suggested practice]</b> Written for this app, built on the policy. Helpful, not required.</p><p>Yes. First run your list through <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#check"">Is my list ready to send?</a>. It runs in your browser and finds the most common problems. Then ask for feedback through your lead coordinator or the <a href=""https://forms.cloud.microsoft/e/SLBvuPX7jK"">contact form</a>. Do not attach the file to the form.</p>", t: "[Suggested practice] Written for this app, built on the policy. Helpful, not required. Yes. First run your list through Is my list ready to send? . It runs in your browser and finds the most common problems. Then ask for feedback through your lead coordinator or the contact form . Do not attach the file to the form.", col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1), flag: ""},
  {id: "brief-albs", topic: "Implementation and support", prov: "GDS position", q: "How do we brief our arm's length bodies, and can GDS help?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>GDS is happy to support departments in conversations with their arm's length bodies, including answering questions about scope. Ask through the contact form.</p><p>To brief them yourself, use the <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/embed.html#brief"">briefing outline</a>: the ask, the scope, why it matters, how the return works for them and the support available. Every point links to a page here they can read afterwards.</p><p><b>Sources</b></p><ul><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. GDS is happy to support departments in conversations with their arm's length bodies, including answering questions about scope. Ask through the contact form. To brief them yourself, use the briefing outline : the ask, the scope, why it matters, how the return works for them and the support available. Every point links to a page here they can read afterwards. Sources GDS DAM Policy FAQs, November 2026", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: "New"},
  {id: "later-returns", topic: "Reporting and the return", prov: "GDS position", q: "When are the returns due?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>The first return, the Baseline Return, is due in January 2027. The next is due in October 2027. Aim to be ready by Friday 18 December 2026, before the Christmas break.</p><p>The policy itself asks you to maintain and review your list every year. In time, GDS expects to replace these returns with more frequent updates taken straight from your catalogue.</p><p><b>Sources</b></p><ul><li><a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy in government</a></li><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. The first return, the Baseline Return, is due in January 2027. The next is due in October 2027. Aim to be ready by Friday 18 December 2026, before the Christmas break. The policy itself asks you to maintain and review your list every year. In time, GDS expects to replace these returns with more frequent updates taken straight from your catalogue. Sources Data Asset Management Policy in government GDS DAM Policy FAQs, November 2026", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {id: "alb-returns", topic: "Reporting and the return", prov: "GDS position", q: "Do arm's length bodies send their own return, or one with their department?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>Arm's length bodies identify and record their own critical data assets using the return template. They send it to their parent department first, and the department forwards it to GDS. Departments coordinate and assure their arm's length bodies' returns, and send a combined return where that makes sense. Either one combined return or separate returns is fine, as long as the department knows about every one. In a combined return, fill in the arm's length body or agency column on every row, so each body's assets stay distinct. Some bodies have asked to send returns straight to GDS; a common position on that is still being agreed.</p><p>If your arm's length body has not heard from its department about the return, contact GDS.</p><p><b>Sources</b></p><ul><li><a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy in government</a></li><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Arm's length bodies identify and record their own critical data assets using the return template. They send it to their parent department first, and the department forwards it to GDS. Departments coordinate and assure their arm's length bodies' returns, and send a combined return where that makes sense. Either one combined return or separate returns is fine, as long as the department knows about every one. In a combined return, fill in the arm's length body or agency column", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: "Updated"},
  {id: "deadline", topic: "Reporting and the return", prov: "Programme plan", q: "When exactly is the Baseline Return due?", x: "<p><b>[Programme plan]</b> From the programme plan. Not yet written into the published policy.</p><p>By the end of January 2027. The Chief Data Officer Council will issue the formal commission in December 2026. Aim to be ready by Friday 18 December 2026, before the Christmas break, so there is time to check your return.</p><p><b>Sources</b></p><ul><li>DAM Policy coordinator meetings, September to November 2026</li></ul>", t: "[Programme plan] From the programme plan. Not yet written into the published policy. By the end of January 2027. The Chief Data Officer Council will issue the formal commission in December 2026. Aim to be ready by Friday 18 December 2026, before the Christmas break, so there is time to check your return. Sources DAM Policy coordinator meetings, September to November 2026", col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1), flag: "New"},
  {id: "identifier", topic: "Reporting and the return", prov: "GDS position", q: "Who sets the unique identifier, and what if an asset is renamed?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>You do. Use the stable identifier from your own data catalogue, or a local convention you document. There is no national format, and it can be up to 100 characters.</p><p>If an asset is renamed, change its name but keep its identifier, so it is not counted twice. The template's guide allows the same identifier on more than one row only for an approved version or licence variant. Its built-in check does not yet allow that, so tell GDS if it blocks you.</p><p><b>Sources</b></p><ul><li>DAM Policy Baseline Return template, version 3 (data dictionary and user guide)</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. You do. Use the stable identifier from your own data catalogue, or a local convention you document. There is no national format, and it can be up to 100 characters. If an asset is renamed, change its name but keep its identifier, so it is not counted twice. The template's guide allows the same identifier on more than one row only for an approved version or licence variant. Its built-in check does not yet allow that, so tell GDS if it blocks you. Sources DAM Policy Baseline", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: "New"},
  {id: "field-lengths", topic: "Reporting and the return", prov: "GDS position", q: "Is there a naming convention, and how long can the text fields be?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>There is no naming convention for government. Use the name the asset is known by in your organisation or catalogue. The template sets these lengths:</p><ul><li>Unique identifier: up to 100 characters.</li><li>Data asset name: up to 200 characters.</li><li>Description: 20 to 2,000 characters. Say what the data is, what it covers, what it is for and why it matters.</li><li>Legal gateway: up to 500 characters.</li><li>Source or provenance: up to 1,000 characters.</li></ul><p>If text seems to be cut off when you enter it, tell GDS through the contact form.</p><p><b>Sources</b></p><ul><li>DAM Policy Baseline Return template, version 3 (data dictionary and user guide)</li><li>DAM Policy coordinator meetings, September to November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. There is no naming convention for government. Use the name the asset is known by in your organisation or catalogue. The template sets these lengths: Unique identifier: up to 100 characters. Data asset name: up to 200 characters. Description: 20 to 2,000 characters. Say what the data is, what it covers, what it is for and why it matters. Legal gateway: up to 500 characters. Source or provenance: up to 1,000 characters. If text seems to be cut off when you enter it, tell GDS", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: "New"},
  {id: "if-applicable", topic: "Reporting and the return", prov: "GDS position", q: "What does 'mandatory if applicable' mean? Can we leave those fields blank?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>Fill them in whenever they apply to the asset. Leave one blank only when it really does not apply. Five fields are like this:</p><ul><li>Arm's length body or agency</li><li>Source or provenance</li><li>Legal gateway or regulatory basis</li><li>Catalogue or metadata reference: needed whenever you answer In catalogue</li><li>Geospatial standard applied: choose Not applicable rather than leaving it blank</li></ul><p>The 13 mandatory fields always need an answer.</p><p><b>Sources</b></p><ul><li>DAM Policy Baseline Return template, version 3 (data dictionary and user guide)</li><li>DAM Policy coordinator meetings, September to November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Fill them in whenever they apply to the asset. Leave one blank only when it really does not apply. Five fields are like this: Arm's length body or agency Source or provenance Legal gateway or regulatory basis Catalogue or metadata reference: needed whenever you answer In catalogue Geospatial standard applied: choose Not applicable rather than leaving it blank The 13 mandatory fields always need an answer. Sources DAM Policy Baseline Return template, version 3 (data dictiona", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: "New"},
  {id: "contact-enquiries", topic: "Reporting and the return", prov: "GDS position", q: "Will named people be contacted directly about our assets?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>No. The return has no contact name or email address for each asset, and asks only whether an owner and a steward are assigned. Questions about your return go through your lead coordinator. You can keep your own functional contact in your catalogue.</p><p><b>Sources</b></p><ul><li>DAM Policy Baseline Return template, version 3 (data dictionary and user guide)</li><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. No. The return has no contact name or email address for each asset, and asks only whether an owner and a steward are assigned. Questions about your return go through your lead coordinator. You can keep your own functional contact in your catalogue. Sources DAM Policy Baseline Return template, version 3 (data dictionary and user guide) GDS DAM Policy FAQs, November 2026", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: "New"},
  {id: "performance-framework", topic: "Reporting and the return", prov: "GDS position", q: "Is the Performance Framework commission the same as the DAM return?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>No, but they are aligned and you should not have to do the work twice.</p><ul><li><b>The GDS Performance Framework</b> is a quarterly commission. It looks at your organisation's data capability and maturity as a whole, and asks for counts, including of the critical data assets you manage internally.</li><li><b>The DAM Policy return</b> is about shared critical data assets, asset by asset, and how the policy is being put into practice for each one.</li></ul><p>Some questions deliberately match. GDS is looking at how evidence from the Performance Framework, for example on ownership, data quality and cataloguing, can support assurance of the Baseline Return. Use the same underlying evidence for both. GDS is also working with the team that runs the commission to align future rounds.</p><p><b>Sources</b></p><ul><li>GDS reply to coordinators on the Performance Framework commission, October 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. No, but they are aligned and you should not have to do the work twice. The GDS Performance Framework is a quarterly commission. It looks at your organisation's data capability and maturity as a whole, and asks for counts, including of the critical data assets you manage internally. The DAM Policy return is about shared critical data assets, asset by asset, and how the policy is being put into practice for each one. Some questions deliberately match. GDS is looking at how ev", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: "New"},
  {id: "alb-not-contacted", topic: "Reporting and the return", prov: "GDS position", q: "We are an arm's length body and nobody has contacted us. What do we do?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>Contact GDS through the contact form. GDS will help through the Chief Data Officer Council to connect you with your department. Your route for the return is your parent department's lead coordinator.</p><p>Who coordinates the work inside your own organisation is for you to decide. The return uses version 3 of the template and is due in January 2027.</p><p><b>Sources</b></p><ul><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Contact GDS through the contact form. GDS will help through the Chief Data Officer Council to connect you with your department. Your route for the return is your parent department's lead coordinator. Who coordinates the work inside your own organisation is for you to decide. The return uses version 3 of the template and is due in January 2027. Sources GDS DAM Policy FAQs, November 2026", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: "New"},
  {id: "compliance-maturity", topic: "Reporting and the return", prov: "GDS position", q: "Does the return assess compliance or maturity?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>Compliance with the DAM Policy. The Baseline Return shows which assets are in scope and how far they meet the data management requirements. Progress is reported to the Chief Data Officer Council and to ministers after each return. Data maturity is assessed separately, by the GDS Data Maturity Service.</p><p><b>Sources</b></p><ul><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Compliance with the DAM Policy. The Baseline Return shows which assets are in scope and how far they meet the data management requirements. Progress is reported to the Chief Data Officer Council and to ministers after each return. Data maturity is assessed separately, by the GDS Data Maturity Service. Sources GDS DAM Policy FAQs, November 2026", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {id: "names", topic: "Reporting and the return", prov: "GDS position", q: "Do we give the names of data owners and stewards?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>No. The return asks only whether each role has been assigned. Do not enter anyone's name. Keep names in your own catalogue or register.</p><p><b>Sources</b></p><ul><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. No. The return asks only whether each role has been assigned. Do not enter anyone's name. Keep names in your own catalogue or register. Sources GDS DAM Policy FAQs, November 2026", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {id: "evidence", topic: "Reporting and the return", prov: "GDS position", q: "What evidence should we keep?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>You do not send evidence with the return. Be able to trace each answer back to the system it came from, such as your data catalogue or information asset register. Give each row a unique identifier, so later returns can show what is new or changed.</p><p><b>Sources</b></p><ul><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. You do not send evidence with the return. Be able to trace each answer back to the system it came from, such as your data catalogue or information asset register. Give each row a unique identifier, so later returns can show what is new or changed. Sources GDS DAM Policy FAQs, November 2026", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {id: "partial", topic: "Reporting and the return", prov: "GDS position", q: "How do we report something that is only partly in place?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>Choose the option in the template that matches where you really are. Use <b>In development</b> when work has started but is not finished, and <b>Planned</b> or <b>No</b> when it has not started. Do not overstate. For data quality, say whether you have a standard plan, a documented equivalent, or nothing in place yet.</p><p><b>Sources</b></p><ul><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Choose the option in the template that matches where you really are. Use In development when work has started but is not finished, and Planned or No when it has not started. Do not overstate. For data quality, say whether you have a standard plan, a documented equivalent, or nothing in place yet. Sources GDS DAM Policy FAQs, November 2026", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {id: "free-text", topic: "Reporting and the return", prov: "GDS position", q: "How much should we write in free-text fields?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>Keep it short. Use free text only for context the options cannot give: exceptions, partial progress, dependencies, risks, next steps or a non-sensitive evidence reference. Never include personal data, sensitive information, detailed quality scores or rules.</p><p><b>Sources</b></p><ul><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Keep it short. Use free text only for context the options cannot give: exceptions, partial progress, dependencies, risks, next steps or a non-sensitive evidence reference. Never include personal data, sensitive information, detailed quality scores or rules. Sources GDS DAM Policy FAQs, November 2026", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {id: "legal-gateway", topic: "Reporting and the return", prov: "GDS position", q: "What goes in the legal gateway field?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>The law or agreement that allows the data to be shared or made available, not the basis on which you first collected it. If more than one applies, give the main one if you know it. If there is no clear main one, leave the field blank. You do not need to review several data sharing agreements to fill it in. Recording legal gateways in your catalogue is still good practice.</p><p><b>Sources</b></p><ul><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. The law or agreement that allows the data to be shared or made available, not the basis on which you first collected it. If more than one applies, give the main one if you know it. If there is no clear main one, leave the field blank. You do not need to review several data sharing agreements to fill it in. Recording legal gateways in your catalogue is still good practice. Sources GDS DAM Policy FAQs, November 2026", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {id: "discoverability", topic: "Reporting and the return", prov: "GDS position", q: "How do we answer the discoverability and interoperability field?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>It asks whether information about the data standards the asset uses can be found, inside your organisation and across government, for example on data.gov.uk or a sector portal.</p><ul><li><b>In place</b>: full details are available on every standard used.</li><li><b>Partial</b>: some details, but not complete.</li><li><b>Not in place</b>: no details are available.</li></ul><p><b>Sources</b></p><ul><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. It asks whether information about the data standards the asset uses can be found, inside your organisation and across government, for example on data.gov.uk or a sector portal. In place : full details are available on every standard used. Partial : some details, but not complete. Not in place : no details are available. Sources GDS DAM Policy FAQs, November 2026", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {id: "what-to-report", topic: "Reporting and the return", prov: "GDS position", q: "Do we report data sets, data products or APIs?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>Report the underlying source data set. Where a critical product, report or API draws on data sets, name those source data sets. You may add details of APIs if you already have them, but you do not need to look for them. If one data set is reached through several APIs, report the data set once.</p><p>The policy defines a data asset as one or more data sets plus any data services, such as APIs, used to reach them.</p><p><b>Sources</b></p><ul><li><a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy in government</a></li><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Report the underlying source data set. Where a critical product, report or API draws on data sets, name those source data sets. You may add details of APIs if you already have them, but you do not need to look for them. If one data set is reached through several APIs, report the data set once. The policy defines a data asset as one or more data sets plus any data services, such as APIs, used to reach them. Sources Data Asset Management Policy in government GDS DAM Policy FA", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {id: "who-sees", topic: "Reporting and the return", prov: "GDS position", q: "Will other departments see the metadata we send?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>Not for now. Returns go to GDS. Sharing metadata across government is being considered as part of the GDS discoverability service, and members will be able to help shape it. The policy says GDS is developing that service.</p><p><b>Sources</b></p><ul><li><a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy in government</a></li><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Not for now. Returns go to GDS. Sharing metadata across government is being considered as part of the GDS discoverability service, and members will be able to help shape it. The policy says GDS is developing that service. Sources Data Asset Management Policy in government GDS DAM Policy FAQs, November 2026", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {id: "template-changes", topic: "Reporting and the return", prov: "GDS position", q: "Which template version do we use, and how will changes be managed?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>Use version 3 of the Baseline Return template: it is the agreed template for the January 2027 return. A change log starts when the first returns arrive. Unique identifiers on each row let GDS see what is new or changed between returns.</p><p><b>Sources</b></p><ul><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. Use version 3 of the Baseline Return template: it is the agreed template for the January 2027 return. A change log starts when the first returns arrive. Unique identifiers on each row let GDS see what is new or changed between returns. Sources GDS DAM Policy FAQs, November 2026", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {id: "ndl", topic: "Related initiatives", prov: "GDS position", q: "How does this relate to the National Data Library?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>The two work closely together to avoid duplication. The National Data Library is focused on developing data.gov.uk. The DAM Policy makes sure good data management practice is applied to government data, which makes it more valuable to initiatives like the library.</p><p><b>Sources</b></p><ul><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. The two work closely together to avoid duplication. The National Data Library is focused on developing data.gov.uk. The DAM Policy makes sure good data management practice is applied to government data, which makes it more valuable to initiatives like the library. Sources GDS DAM Policy FAQs, November 2026", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {id: "star", topic: "Related initiatives", prov: "GDS position", q: "How does this relate to HM Treasury's Strategic Asset Review?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>They ask different things. The Strategic Asset Review looks for assets of all kinds with high commercial potential. The DAM Policy is about critical data that is shared, and commercialisation is not its aim. Some assets may appear in both, but the returns will not be the same.</p><p><b>Sources</b></p><ul><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. They ask different things. The Strategic Asset Review looks for assets of all kinds with high commercial potential. The DAM Policy is about critical data that is shared, and commercialisation is not its aim. Some assets may appear in both, but the returns will not be the same. Sources GDS DAM Policy FAQs, November 2026", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {id: "mem", topic: "Related initiatives", prov: "GDS position", q: "How does this relate to the Metadata Exchange Model?", x: "<p><b>[GDS position]</b> An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK.</p><p>The metadata guidance recommends DCAT for describing data sets and data services. The UK Cross-Government Metadata Exchange Model is a practical way to apply DCAT, and can help you record and exchange metadata consistently.</p><p><b>Sources</b></p><ul><li><a href=""https://www.gov.uk/government/publications/record-metadata-to-describe-critical-data-assets/recording-metadata-to-describe-critical-data-assets"">Recording metadata to describe critical data assets</a></li><li>GDS DAM Policy FAQs, November 2026</li></ul>", t: "[GDS position] An answer GDS has given to coordinators, mostly in the DAM Policy FAQs (November 2026). Not yet on GOV.UK. The metadata guidance recommends DCAT for describing data sets and data services. The UK Cross-Government Metadata Exchange Model is a practical way to apply DCAT, and can help you record and exchange metadata consistently. Sources Recording metadata to describe critical data assets GDS DAM Policy FAQs, November 2026", col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {id: "new-service", topic: "Embedding the policy", prov: "Suggested practice", q: "How do we build the policy into a new service or project?", x: "<p><b>[Suggested practice]</b> Written for this app, built on the policy. Helpful, not required.</p><p>Treat it as part of the design, not a task at the end. During discovery, name the data the service will create, use or share. Before live, give each critical asset an owner, describe it in your catalogue and start a quality plan, so it joins your next return without extra work. See <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/embed.html#change"">embedding it in change</a>.</p><p>This matches point 10 of the Technology Code of Practice, which asks teams to plan for data across its whole lifecycle.</p><p><b>Sources</b></p><ul><li><a href=""https://www.gov.uk/guidance/make-better-use-of-data"">Technology Code of Practice, point 10: make better use of data</a></li><li><a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy in government</a></li></ul>", t: "[Suggested practice] Written for this app, built on the policy. Helpful, not required. Treat it as part of the design, not a task at the end. During discovery, name the data the service will create, use or share. Before live, give each critical asset an owner, describe it in your catalogue and start a quality plan, so it joins your next return without extra work. See embedding it in change . This matches point 10 of the Technology Code of Practice, which asks teams to plan for data across its whole lifecycle. Sources Technology Code of Practice, point 10: make better use of data Data Asset Man", col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1), flag: ""},
  {id: "service-standards", topic: "Embedding the policy", prov: "Suggested practice", q: "Which standards should a new service, or one replacing a legacy system, adopt from the start?", x: "<p><b>[Suggested practice]</b> Written for this app, built on the policy. Helpful, not required.</p><p>Build these in as architecture principles from discovery:</p><ul><li><b>The DAM Policy</b>, and its guidance on identifying critical data assets and recording metadata.</li><li><b>The data ownership model</b>, for named owners and stewards.</li><li><b>The data quality action plan guide</b> and the Government Data Quality Framework, for quality.</li><li><b>DCAT</b>, through the UK Cross-Government Metadata Exchange Model, for your catalogue.</li><li><b>Point 10 of the Technology Code of Practice</b>, for planning data across its lifecycle, including migration, retention and exit.</li><li><b>The Service Standard</b>, for how the service is built and assessed.</li></ul><p>For replacing a legacy system, the capability playbooks cover <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-26"">legacy migration</a> and <a href=""https://cyberdudeuk.github.io/dam-capability-playbooks/capabilities.html#CR-32"">avoiding future legacy</a>. GDS can talk your plans through: ask through the contact form.</p><p><b>Sources</b></p><ul><li><a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy in government</a></li><li><a href=""https://www.gov.uk/government/publications/identify-and-record-critical-data-assets/identifying-and-recording-critical-data-assets"">Identifying and recording critical data assets</a></li><li><a href=""https://www.gov.uk/government/publications/record-metadata-to-describe-critical-data-assets/recording-metadata-to-describe-critical-data-assets"">Recording metadata to describe critical data assets</a></li><li><a href=""https://www.gov.uk/government/publications/data-ownership-in-government/data-ownership-model"">Data ownership model</a></li><li><a href=""https://www.gov.uk/government/publications/implement-a-data-quality-action-plan/data-quality-action-plan-implementation-guide"">Data quality action plan: implementation guide</a></li><li><a href=""https://www.gov.uk/guidance/make-better-use-of-data"">Technology Code of Practice, point 10: make better use of data</a></li><li><a href=""https://www.gov.uk/service-manual/service-standard"">Service Standard</a></li></ul>", t: "[Suggested practice] Written for this app, built on the policy. Helpful, not required. Build these in as architecture principles from discovery: The DAM Policy , and its guidance on identifying critical data assets and recording metadata. The data ownership model , for named owners and stewards. The data quality action plan guide and the Government Data Quality Framework, for quality. DCAT , through the UK Cross-Government Metadata Exchange Model, for your catalogue. Point 10 of the Technology Code of Practice , for planning data across its lifecycle, including migration, retention and exit. T", col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1), flag: "New"},
  {id: "resilience", topic: "Embedding the policy", prov: "Policy", q: "How does the policy link to resilience data sharing?", x: "<p><b>[Policy]</b> Stated in the published policy or its guidance on GOV.UK.</p><p>Defence, national security and resilience is one of the seven critical purposes. Data shared for resilience work can be a critical data asset if the other principles apply. Listing it records that it exists and who owns it. It does not change who may use it.</p><p><b>Sources</b></p><ul><li><a href=""https://www.gov.uk/government/publications/identify-and-record-critical-data-assets/identifying-and-recording-critical-data-assets"">Identifying and recording critical data assets</a></li><li><a href=""https://www.gov.uk/government/publications/data-asset-management-policy-in-government/data-asset-management-policy-in-government"">Data Asset Management Policy in government</a></li></ul>", t: "[Policy] Stated in the published policy or its guidance on GOV.UK. Defence, national security and resilience is one of the seven critical purposes. Data shared for resilience work can be a critical data asset if the other principles apply. Listing it records that it exists and who owns it. It does not change who may use it. Sources Identifying and recording critical data assets Data Asset Management Policy in government", col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1), flag: ""},
  {id: "find-materials", topic: "Finding things", prov: "Suggested practice", q: "Where do I find the guidance, templates and meeting materials?", x: "<p><b>[Suggested practice]</b> Written for this app, built on the policy. Helpful, not required.</p><p>Here. The <a href=""https://cyberdudeuk.github.io/dam-policy-explorer/resources.html"">resources page</a> lists all the published guidance, templates and tools, and you can filter it by what you need. The coordinators' FAQ and meeting recordings are kept with the DAM Policy Working Group on the Knowledge Hub. If you cannot open something, tell us and we will send it another way.</p>", t: "[Suggested practice] Written for this app, built on the policy. Helpful, not required. Here. The resources page lists all the published guidance, templates and tools, and you can filter it by what you need. The coordinators' FAQ and meeting recordings are kept with the DAM Policy Working Group on the Knowledge Hub. If you cannot open something, tell us and we will send it another way.", col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1), flag: ""}
);
nfEx = Table(
  {id: "EX-001", title: "A flood-warning data set, every field filled in", topics: "Filling in the return; Critical purposes", sector: "Environment and flood resilience", kind: "Filling in the return", stat: "Agreed", x: "<p><b>[Filling in the return]</b> <b>[Agreed]</b> Environment and flood resilience</p><p>A live and historical river-level and flood-warning data set is described across all 24 fields of the version 3 template: publisher, provenance, owner and steward assigned, licence, update status, catalogue and quality plan references and the geospatial standards used. It serves purposes 1, 3 and 6.</p><p><b>Outcome.</b> In scope. One row, with short asset-level answers and references back to your own records.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/return.html#step-7"">Return: related guidance</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-field-lengths"">Questions: related guidance</a></li></ul>", t: "A live and historical river-level and flood-warning data set is described across all 24 fields of the version 3 template: publisher, provenance, owner and steward assigned, licence, update status, catalogue and quality plan references and the geospatial standards used. It serves purposes 1, 3 and 6.", ic: Icon.DetailList, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1), flag: "New"},
  {id: "EX-002", title: "Moving an old return to the version 3 purposes: 1, 2 and 6", topics: "Critical purposes; Filling in the return", sector: "Any organisation", kind: "Filling in the return", stat: "Agreed", x: "<p><b>[Filling in the return]</b> <b>[Agreed]</b> Any organisation</p><p>A return started under the earlier numbering lists purposes 1, 2 and 6. In version 3, public service delivery stays 1, developing and evaluating policy becomes 4, and the public interest stays 6.</p><p><b>Outcome.</b> Enter 1, 4, 6.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-purpose-fit"">Questions: related guidance</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/asset-test.html"">Asset test: related guidance</a></li></ul>", t: "A return started under the earlier numbering lists purposes 1, 2 and 6. In version 3, public service delivery stays 1, developing and evaluating policy becomes 4, and the public interest stays 6.", ic: Icon.DetailList, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1), flag: "New"},
  {id: "EX-003", title: "Moving an old return to the version 3 purposes: 3, 4 and 5", topics: "Critical purposes; Filling in the return", sector: "Any organisation", kind: "Filling in the return", stat: "Agreed", x: "<p><b>[Filling in the return]</b> <b>[Agreed]</b> Any organisation</p><p>A return started under the earlier numbering lists purposes 3, 4 and 5. In version 3 these become official statistics (5), a legislative, legal or contractual requirement (2), and defence, national security and resilience (3).</p><p><b>Outcome.</b> Enter 5, 2, 3.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-purpose-fit"">Questions: related guidance</a></li></ul>", t: "A return started under the earlier numbering lists purposes 3, 4 and 5. In version 3 these become official statistics (5), a legislative, legal or contractual requirement (2), and defence, national security and resilience (3).", ic: Icon.DetailList, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1), flag: "New"},
  {id: "EX-026", title: "Official statistics received unchanged from another body", topics: "Scope principles; Critical purposes; Third-party and licensed data", sector: "Energy", kind: "Out of scope", stat: "Agreed", x: "<p><b>[Out of scope]</b> <b>[Agreed]</b> Energy</p><p>A department receives official statistics produced by another public body and uses an unchanged copy in its own work. Keeping a local copy does not make it a new critical data asset.</p><p><b>Outcome.</b> Out of the receiving department's return. The body that produces the statistics considers the source data behind them.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-official-stats"">Questions: related guidance</a></li></ul>", t: "A department receives official statistics produced by another public body and uses an unchanged copy in its own work. Keeping a local copy does not make it a new critical data asset.", ic: Icon.CancelBadge, col: RGBA(163,38,26,1), tint: RGBA(251,233,231,1), flag: "New"},
  {id: "EX-027", title: "Official statistics the receiver has materially enriched", topics: "Scope principles; Critical purposes; Third-party and licensed data", sector: "Energy", kind: "It depends", stat: "Agreed", x: "<p><b>[It depends]</b> <b>[Agreed]</b> Energy</p><p>The receiving department materially changes or enriches the statistics and becomes accountable for a distinct asset. A critical purpose on its own is not enough.</p><p><b>Outcome.</b> In scope for the receiver only if it owns or manages the enriched asset and all four principles apply.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-official-stats"">Questions: related guidance</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/asset-test.html"">Asset test: related guidance</a></li></ul>", t: "The receiving department materially changes or enriches the statistics and becomes accountable for a distinct asset. A critical purpose on its own is not enough.", ic: Icon.Warning, col: RGBA(138,74,0,1), tint: RGBA(253,241,225,1), flag: "New"},
  {id: "EX-034", title: "A pupil data asset with several legal gateways", topics: "Filling in the return", sector: "Education", kind: "Filling in the return", stat: "Agreed", x: "<p><b>[Filling in the return]</b> <b>[Agreed]</b> Education</p><p>A national pupil data asset has legal gateways that vary by component and by type of request. Copying every legal analysis into the return would give inconsistent detail.</p><p><b>Outcome.</b> Enter ""Varies by request: see local record"" and keep the detailed legal analysis in your own system.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-legal-gateway"">Questions: related guidance</a></li></ul>", t: "A national pupil data asset has legal gateways that vary by component and by type of request. Copying every legal analysis into the return would give inconsistent detail.", ic: Icon.DetailList, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1), flag: "New"},
  {id: "EX-035", title: "Metadata kept in several governed places, not one catalogue", topics: "Metadata and catalogues; Filling in the return", sector: "Education", kind: "Filling in the return", stat: "Agreed", x: "<p><b>[Filling in the return]</b> <b>[Agreed]</b> Education</p><p>A department has no single catalogue, but keeps authoritative metadata in its information asset register, published service records and research catalogues.</p><p><b>Outcome.</b> Choose ""In catalogue"" where the metadata is authoritative, and give a stable reference that finds the record.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-catalogue-tool"">Questions: related guidance</a></li></ul>", t: "A department has no single catalogue, but keeps authoritative metadata in its information asset register, published service records and research catalogues.", ic: Icon.DetailList, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1), flag: "New"},
  {id: "EX-036", title: "An asset that is updated all the time", topics: "Filling in the return", sector: "Education", kind: "Filling in the return", stat: "Agreed", x: "<p><b>[Filling in the return]</b> <b>[Agreed]</b> Education</p><p>A longitudinal administrative data set has no releases that fit a version number. Its currency and time coverage are kept in fuller metadata.</p><p><b>Outcome.</b> Enter ""Continuously updated"" or ""Not versioned"", whichever is true.</p>", t: "A longitudinal administrative data set has no releases that fit a version number. Its currency and time coverage are kept in fuller metadata.", ic: Icon.DetailList, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1), flag: "New"},
  {id: "EX-037", title: "An asset governed by several usage bases", topics: "Filling in the return; Third-party and licensed data", sector: "Education", kind: "Filling in the return", stat: "Agreed", x: "<p><b>[Filling in the return]</b> <b>[Agreed]</b> Education</p><p>The same asset is covered by law, a data sharing agreement and a time-limited licence. A row for each arrangement would count the asset several times.</p><p><b>Outcome.</b> Choose the main basis, or ""Multiple / varies: see local record"". Add rows only for genuinely different versions of the asset.</p>", t: "The same asset is covered by law, a data sharing agreement and a time-limited licence. A row for each arrangement would count the asset several times.", ic: Icon.DetailList, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1), flag: "New"},
  {id: "EX-038", title: "A finance or workforce extract that matters only internally", topics: "Scope principles", sector: "Central government corporate services", kind: "Out of scope", stat: "Agreed", x: "<p><b>[Out of scope]</b> <b>[Agreed]</b> Central government corporate services</p><p>An extract is vital inside the organisation but has no value elsewhere in government and no realistic reuse.</p><p><b>Outcome.</b> Out of scope, unless value to the wider public sector can be shown.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-shared-only"">Questions: related guidance</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-internal-shared"">Questions: related guidance</a></li></ul>", t: "An extract is vital inside the organisation but has no value elsewhere in government and no realistic reuse.", ic: Icon.CancelBadge, col: RGBA(163,38,26,1), tint: RGBA(251,233,231,1), flag: "New"},
  {id: "EX-039", title: "One data set offered through several APIs", topics: "Sources, products and APIs", sector: "Digital services", kind: "Filling in the return", stat: "Agreed", x: "<p><b>[Filling in the return]</b> <b>[Agreed]</b> Digital services</p><p>Several APIs give different routes into the same data set. More routes do not make more assets.</p><p><b>Outcome.</b> Report the data set once. Describe an API separately only if it is managed and owned in its own right.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-principles"">Questions: related guidance</a></li></ul>", t: "Several APIs give different routes into the same data set. More routes do not make more assets.", ic: Icon.DetailList, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1), flag: "New"},
  {id: "EX-040", title: "A shared service run by several teams", topics: "Owners and stewards; Scope principles", sector: "Shared services", kind: "Roles", stat: "Agreed", x: "<p><b>[Roles]</b> <b>[Agreed]</b> Shared services</p><p>Several organisations or directorates operate or look after a shared service, but the return needs one organisation that is accountable.</p><p><b>Outcome.</b> The accountable organisation reports the asset; others can keep stewardship or operational roles.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-shared-service"">Questions: related guidance</a></li></ul>", t: "Several organisations or directorates operate or look after a shared service, but the return needs one organisation that is accountable.", ic: Icon.People, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1), flag: "New"},
  {id: "EX-041", title: "One owner, several stewards", topics: "Owners and stewards", sector: "Energy", kind: "Roles", stat: "Agreed", x: "<p><b>[Roles]</b> <b>[Agreed]</b> Energy</p><p>A data product has one senior accountable owner. Several stewards or technical custodians each look after part of it. More than one owner would blur who decides.</p><p><b>Outcome.</b> Name one owner; divide the day-to-day work between stewards and custodians.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/people.html#p-own"">People: related guidance</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/people.html#p-stw"">People: related guidance</a></li></ul>", t: "A data product has one senior accountable owner. Several stewards or technical custodians each look after part of it. More than one owner would blur who decides.", ic: Icon.People, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1), flag: "New"},
  {id: "EX-042", title: "Data brought in from outside still needs a local owner", topics: "Owners and stewards; Third-party and licensed data", sector: "Energy", kind: "Roles", stat: "Agreed", x: "<p><b>[Roles]</b> <b>[Agreed]</b> Energy</p><p>Data received from another organisation needs someone accountable for the copy held, its compliance and its proper use. The sender still owns its own version unless agreed otherwise.</p><p><b>Outcome.</b> Name a local owner for your copy; the originator keeps authority over the source.</p>", t: "Data received from another organisation needs someone accountable for the copy held, its compliance and its proper use. The sender still owns its own version unless agreed otherwise.", ic: Icon.People, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1), flag: "New"},
  {id: "EX-043", title: "Copying data does not move its ownership", topics: "Owners and stewards", sector: "Energy", kind: "Roles", stat: "Agreed", x: "<p><b>[Roles]</b> <b>[Agreed]</b> Energy</p><p>A team copies part of a data product to work on it. The source owner's rules still apply, and unnecessary copies should be avoided.</p><p><b>Outcome.</b> Ownership and controls stay with the source unless a transfer is agreed.</p>", t: "A team copies part of a data product to work on it. The source owner's rules still apply, and unnecessary copies should be avoided.", ic: Icon.People, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1), flag: "New"},
  {id: "EX-044", title: "A derived product can have a new owner, but keeps the rules of its inputs", topics: "Owners and stewards; Sources, products and APIs", sector: "Energy", kind: "Roles", stat: "Agreed", x: "<p><b>[Roles]</b> <b>[Agreed]</b> Energy</p><p>A product made from other data is given an owner. That does not remove the policies and permissions attached to the data it came from.</p><p><b>Outcome.</b> Name an owner for the derived product and keep the rules inherited from its sources unless they are changed explicitly.</p>", t: "A product made from other data is given an owner. That does not remove the policies and permissions attached to the data it came from.", ic: Icon.People, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1), flag: "New"},
  {id: "EX-045", title: "The same data used by several organisations", topics: "Owners and stewards; Scope principles", sector: "Cross-government sharing", kind: "Roles", stat: "Agreed", x: "<p><b>[Roles]</b> <b>[Agreed]</b> Cross-government sharing</p><p>The organisation that creates the data names an owner who sets the conditions for supply and use. Each organisation that receives it names a local owner for its copy, and the owners work together.</p><p><b>Outcome.</b> Keep the source owner and each local owner clear; sharing does not create one shared owner.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-who-accountable"">Questions: related guidance</a></li></ul>", t: "The organisation that creates the data names an owner who sets the conditions for supply and use. Each organisation that receives it names a local owner for its copy, and the owners work together.", ic: Icon.People, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1), flag: "New"},
  {id: "EX-046", title: "A platform team as data custodian", topics: "Owners and stewards", sector: "Digital platforms", kind: "Roles", stat: "Agreed", x: "<p><b>[Roles]</b> <b>[Agreed]</b> Digital platforms</p><p>Data sits on a managed platform. The platform team gives technical support, the business owner stays accountable and the steward manages the day-to-day.</p><p><b>Outcome.</b> Record technical custody separately from ownership and stewardship.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/glossary.html#t-data-custodian"">Glossary: related guidance</a></li></ul>", t: "Data sits on a managed platform. The platform team gives technical support, the business owner stays accountable and the steward manages the day-to-day.", ic: Icon.People, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1), flag: "New"},
  {id: "EX-047", title: "The owner is accountable for how published data is licensed", topics: "Owners and stewards; Third-party and licensed data", sector: "Open publication", kind: "Roles", stat: "Agreed", x: "<p><b>[Roles]</b> <b>[Agreed]</b> Open publication</p><p>A department publishes data under a licence. The owner makes sure permitted uses are clear, compliance is watched and requests are handled. Stewards can run the licensing day to day.</p><p><b>Outcome.</b> The owner stays accountable for licensing decisions.</p>", t: "A department publishes data under a licence. The owner makes sure permitted uses are clear, compliance is watched and requests are handled. Stewards can run the licensing day to day.", ic: Icon.People, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1), flag: "New"},
  {id: "EX-048", title: "Information asset register and catalogue, side by side", topics: "Metadata and catalogues", sector: "Information governance", kind: "Process", stat: "Agreed", x: "<p><b>[Process]</b> <b>[Agreed]</b> Information governance</p><p>The register records accountability, risk, security and compliance. The catalogue adds richer details for finding, accessing and reusing data, and can show ownership and classification taken from the register.</p><p><b>Outcome.</b> Connected but different tools: align the shared fields and keep both purposes.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-iar-catalogue"">Questions: related guidance</a></li></ul>", t: "The register records accountability, risk, security and compliance. The catalogue adds richer details for finding, accessing and reusing data, and can show ownership and classification taken from the register.", ic: Icon.Sync, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: "New"},
  {id: "EX-049", title: "When a catalogue can replace the register", topics: "Metadata and catalogues", sector: "Information governance", kind: "It depends", stat: "Agreed", x: "<p><b>[It depends]</b> <b>[Agreed]</b> Information governance</p><p>A catalogue can replace an information asset register only if it also does the register's governance and assurance job.</p><p><b>Outcome.</b> Replace only when that is shown; otherwise keep both and link them.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-iar-catalogue"">Questions: related guidance</a></li></ul>", t: "A catalogue can replace an information asset register only if it also does the register's governance and assurance job.", ic: Icon.Warning, col: RGBA(138,74,0,1), tint: RGBA(253,241,225,1), flag: "New"},
  {id: "EX-050", title: "A quality process with a different name", topics: "Data quality", sector: "Any organisation", kind: "It depends", stat: "Agreed", x: "<p><b>[It depends]</b> <b>[Agreed]</b> Any organisation</p><p>A department uses its own quality process. It identifies critical data, sets rules, assesses quality, sets priorities, fixes root causes, reports and measures again.</p><p><b>Outcome.</b> Counts as equivalent to a data quality action plan only if all seven steps are covered.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-dqap"">Questions: related guidance</a></li></ul>", t: "A department uses its own quality process. It identifies critical data, sets rules, assesses quality, sets priorities, fixes root causes, reports and measures again.", ic: Icon.Warning, col: RGBA(138,74,0,1), tint: RGBA(253,241,225,1), flag: "New"},
  {id: "EX-051", title: "Work that has started but is not finished", topics: "Filling in the return", sector: "Any organisation", kind: "Filling in the return", stat: "Agreed", x: "<p><b>[Filling in the return]</b> <b>[Agreed]</b> Any organisation</p><p>A catalogue entry, role assignment, quality plan or discoverability route is being put in place. ""In development"" does not fit work that has not started.</p><p><b>Outcome.</b> Choose the status that is true, such as Planned or In development. Do not overstate.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-partial"">Questions: related guidance</a></li></ul>", t: "A catalogue entry, role assignment, quality plan or discoverability route is being put in place. ""In development"" does not fit work that has not started.", ic: Icon.DetailList, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1), flag: "New"},
  {id: "EX-052", title: "Keep free text short and not sensitive", topics: "Filling in the return", sector: "Any organisation", kind: "Filling in the return", stat: "Agreed", x: "<p><b>[Filling in the return]</b> <b>[Agreed]</b> Any organisation</p><p>Exceptions, dependencies, risks, next steps and evidence references can be summarised briefly. Long narrative, personal data and detailed quality rules belong in your own systems.</p><p><b>Outcome.</b> Write only what is needed to understand the row.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-free-text"">Questions: related guidance</a></li></ul>", t: "Exceptions, dependencies, risks, next steps and evidence references can be summarised briefly. Long narrative, personal data and detailed quality rules belong in your own systems.", ic: Icon.DetailList, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1), flag: "New"},
  {id: "EX-058", title: "An oversight body's quality programme, started with one asset", topics: "Data quality; Arm's length bodies", sector: "Police oversight (arm's length body)", kind: "Process", stat: "Agreed", x: "<p><b>[Process]</b> <b>[Agreed]</b> Police oversight (arm's length body)</p><p>An arm's length body began with its most critical casework data: it set quality rules, used a repeatable assessment, gave actions owners and checked progress at its governance meetings. The organisation reports a large fall in errors in key reporting.</p><p><b>Outcome.</b> A focused, governed improvement cycle meets the intent of a quality plan, and can grow once it has shown value.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-dqap"">Questions: related guidance</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/embed.html#owners"">Embed: related guidance</a></li></ul>", t: "An arm's length body began with its most critical casework data: it set quality rules, used a repeatable assessment, gave actions owners and checked progress at its governance meetings. The organisation reports a large fall in errors in key reporting.", ic: Icon.Sync, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: "New"},
  {id: "EX-059", title: "Wrong case details after a system move", topics: "Data quality", sector: "Police oversight (arm's length body)", kind: "Process", stat: "Agreed", x: "<p><b>[Process]</b> <b>[Agreed]</b> Police oversight (arm's length body)</p><p>Case classifications were mapped wrongly when old data moved into a new system. The team traced it to the migration logic, corrected the records in bulk and reported assurance.</p><p><b>Outcome.</b> Fix the cause at source, correct the records, and show the issue is resolved.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-service-standards"">Questions: related guidance</a></li></ul>", t: "Case classifications were mapped wrongly when old data moved into a new system. The team traced it to the migration logic, corrected the records in bulk and reported assurance.", ic: Icon.Sync, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: "New"},
  {id: "EX-060", title: "Outcomes recorded inconsistently", topics: "Data quality", sector: "Police oversight (arm's length body)", kind: "Process", stat: "Agreed", x: "<p><b>[Process]</b> <b>[Agreed]</b> Police oversight (arm's length body)</p><p>Inconsistent outcomes had several causes: data pipelines, screen design and unclear guidance. Operational, analytical and technical staff worked together on targeted actions and a dashboard for senior oversight.</p><p><b>Outcome.</b> Match each fix to its cause, and watch the issue through governance, not as a one-off clean-up.</p>", t: "Inconsistent outcomes had several causes: data pipelines, screen design and unclear guidance. Operational, analytical and technical staff worked together on targeted actions and a dashboard for senior oversight.", ic: Icon.Sync, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: "New"},
  {id: "EX-061", title: "Quality evidence that made the case for a new system", topics: "Data quality", sector: "Police oversight (arm's length body)", kind: "Process", stat: "Agreed", x: "<p><b>[Process]</b> <b>[Agreed]</b> Police oversight (arm's length body)</p><p>The business knew a system had problems but could not show them. A structured assessment and root-cause evidence supported a successful business case to replace it.</p><p><b>Outcome.</b> Use measured quality evidence to justify change, then check the new system removes the problems.</p>", t: "The business knew a system had problems but could not show them. A structured assessment and root-cause evidence supported a successful business case to replace it.", ic: Icon.Sync, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: "New"},
  {id: "EX-062", title: "A department and its agency pilot a quality framework", topics: "Data quality; Arm's length bodies", sector: "Justice", kind: "Process", stat: "Agreed", x: "<p><b>[Process]</b> <b>[Agreed]</b> Justice</p><p>After an audit, a department set up ownership roles, a repeatable quality framework and a pilot with one of its agencies. Critical data, rules and tolerances are held centrally, measured daily and shown on dashboards for each role.</p><p><b>Outcome.</b> A workable model: scale it with more automation and routine self-assessment.</p>", t: "After an audit, a department set up ownership roles, a repeatable quality framework and a pilot with one of its agencies. Critical data, rules and tolerances are held centrally, measured daily and shown on dashboards for each role.", ic: Icon.Sync, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: "New"},
  {id: "EX-063", title: "Owner, steward and engineer in a quality model", topics: "Owners and stewards; Data quality", sector: "Justice", kind: "Roles", stat: "Agreed", x: "<p><b>[Roles]</b> <b>[Agreed]</b> Justice</p><p>The owner sets direction and escalates. The steward identifies critical data, writes rules, watches the measures and drives fixes. Engineers and custodians build the technical controls.</p><p><b>Outcome.</b> Keep accountability, coordination and technical work separate but connected.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/people.html#p-own"">People: related guidance</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/people.html#p-stw"">People: related guidance</a></li></ul>", t: "The owner sets direction and escalates. The steward identifies critical data, writes rules, watches the measures and drives fixes. Engineers and custodians build the technical controls.", ic: Icon.People, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1), flag: "New"},
  {id: "EX-074", title: "Confirm roles without naming people", topics: "Owners and stewards; Filling in the return", sector: "Any organisation", kind: "Filling in the return", stat: "Agreed", x: "<p><b>[Filling in the return]</b> <b>[Agreed]</b> Any organisation</p><p>The return asks, Yes or No, whether an owner and a steward are assigned. Names, handovers and successors stay in your own records.</p><p><b>Outcome.</b> Enter Yes or No only; never names.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-names"">Questions: related guidance</a></li></ul>", t: "The return asks, Yes or No, whether an owner and a steward are assigned. Names, handovers and successors stay in your own records.", ic: Icon.DetailList, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1), flag: "New"},
  {id: "EX-077", title: "One row per asset, not per recipient", topics: "Filling in the return; Sources, products and APIs", sector: "Education", kind: "Filling in the return", stat: "Agreed", x: "<p><b>[Filling in the return]</b> <b>[Agreed]</b> Education</p><p>Different agreements, recipients or criteria do not make different assets. Several purpose numbers go in one field, and recipient details stay in your own records.</p><p><b>Outcome.</b> One row per asset. Repeat only for a genuinely distinct version or licence variant.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-identifier"">Questions: related guidance</a></li></ul>", t: "Different agreements, recipients or criteria do not make different assets. Several purpose numbers go in one field, and recipient details stay in your own records.", ic: Icon.DetailList, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1), flag: "New"},
  {id: "EX-078", title: "Critical because another organisation depends on it", topics: "Scope principles; Filling in the return", sector: "Education", kind: "In scope", stat: "Agreed", x: "<p><b>[In scope]</b> <b>[Agreed]</b> Education</p><p>The organisation that holds an asset may not see it as one of its most critical, but another public body depends on it for an essential purpose. That dependency is evidence of value across government.</p><p><b>Outcome.</b> Possibly in scope: say who depends on it in the description.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-potential-value"">Questions: related guidance</a></li><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/asset-test.html"">Asset test: related guidance</a></li></ul>", t: "The organisation that holds an asset may not see it as one of its most critical, but another public body depends on it for an essential purpose. That dependency is evidence of value across government.", ic: Icon.CheckBadge, col: RGBA(11,107,58,1), tint: RGBA(231,243,236,1), flag: "New"},
  {id: "EX-079", title: "A stable repository reference instead of a catalogue number", topics: "Metadata and catalogues; Filling in the return", sector: "Education", kind: "Filling in the return", stat: "Agreed", x: "<p><b>[Filling in the return]</b> <b>[Agreed]</b> Education</p><p>Authoritative metadata exists but has no catalogue record number. A local identifier, record title or repository-and-entry reference works if it finds the record.</p><p><b>Outcome.</b> Choose ""In catalogue"" and enter that reference.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-identifier"">Questions: related guidance</a></li></ul>", t: "Authoritative metadata exists but has no catalogue record number. A local identifier, record title or repository-and-entry reference works if it finds the record.", ic: Icon.DetailList, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1), flag: "New"},
  {id: "EX-080", title: "A new release is not a new row", topics: "Filling in the return", sector: "Education", kind: "Filling in the return", stat: "Agreed", x: "<p><b>[Filling in the return]</b> <b>[Agreed]</b> Education</p><p>Assets that roll forward use one current update status, not a row for every release or period.</p><p><b>Outcome.</b> One row with the current status, unless a version is a distinct asset that needs its own report.</p>", t: "Assets that roll forward use one current update status, not a row for every release or period.", ic: Icon.DetailList, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1), flag: "New"},
  {id: "EX-004", title: "A vehicle data set and the API that serves it", topics: "Sources, products and APIs; Scope principles", sector: "Transport", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Transport</p><p>A vehicle data set supports public services and is offered through an open enquiry API. Which is reported?</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-principles"">Questions: related guidance</a></li></ul>", t: "A vehicle data set supports public services and is offered through an open enquiry API. Which is reported?", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-005", title: "Homelessness case data with credible future reuse", topics: "Scope principles", sector: "Local government", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Local government</p><p>Case-management data is not shared yet, but could support benefits, health and justice work.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-potential-value"">Questions: related guidance</a></li></ul>", t: "Case-management data is not shared yet, but could support benefits, health and justice work.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-006", title: "Fraud intelligence enriched from company records", topics: "Third-party and licensed data; Critical purposes", sector: "Fraud and error", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Fraud and error</p><p>Company records are combined with departmental intelligence, matched, improved and risk-scored.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p>", t: "Company records are combined with departmental intelligence, matched, improved and risk-scored.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-007", title: "A fraud risk score managed as its own product", topics: "Sources, products and APIs; Critical purposes", sector: "Fraud and error", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Fraud and error</p><p>A risk score is derived from several sources but has its own owner, lifecycle, quality measures and users.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p>", t: "A risk score is derived from several sources but has its own owner, lifecycle, quality measures and users.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-008", title: "Safeguarding data shared only under strict controls", topics: "Security and restricted data", sector: "Safeguarding", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Safeguarding</p><p>Personal safeguarding data with a lawful route, defined purpose and controls.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-discovery-access"">Questions: related guidance</a></li></ul>", t: "Personal safeguarding data with a lawful route, defined purpose and controls.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-009", title: "Resettlement programme data", topics: "Scope principles; Security and restricted data", sector: "Local government", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Local government</p><p>Programme data other public bodies could reuse, only for a defined purpose under an agreement.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p>", t: "Programme data other public bodies could reuse, only for a defined purpose under an agreement.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-010", title: "Mapping data that is critical but licence-restricted", topics: "Third-party and licensed data", sector: "Geospatial", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Geospatial</p><p>A geospatial product with high public value, whose onward sharing is limited by its licence.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p>", t: "A geospatial product with high public value, whose onward sharing is limited by its licence.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-011", title: "Commercial reference data", topics: "Third-party and licensed data", sector: "Commercial data", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Commercial data</p><p>Supplier terms limit reuse of reference data. Does that change reporting?</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p>", t: "Supplier terms limit reuse of reference data. Does that change reporting?", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-012", title: "Open data that may not be critical", topics: "Scope principles", sector: "Open data", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Open data</p><p>Publishing data openly meets the sharing test, but not the critical-purpose test.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p>", t: "Publishing data openly meets the sharing test, but not the critical-purpose test.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-013", title: "An arm's length body's data", topics: "Arm's length bodies", sector: "Department and arm's length body", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Department and arm's length body</p><p>How the department brings together coverage while keeping clear which body is accountable.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-alb-returns"">Questions: related guidance</a></li></ul>", t: "How the department brings together coverage while keeping clear which body is accountable.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-014", title: "Address data and the geospatial field", topics: "Filling in the return", sector: "Geospatial", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Geospatial</p><p>Which address and location standards to record, beyond the property reference number.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p>", t: "Which address and location standards to record, beyond the property reference number.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-015", title: "Mapping licensed under the public sector agreement", topics: "Third-party and licensed data; Filling in the return", sector: "Geospatial", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Geospatial</p><p>Recording the licence holder and onward-sharing limits.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p>", t: "Recording the licence holder and onward-sharing limits.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-016", title: "A geospatial layer used exactly as supplied", topics: "Third-party and licensed data; Scope principles", sector: "Geospatial", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Geospatial</p><p>A team uses an external layer as supplied and does not manage it.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p>", t: "A team uses an external layer as supplied and does not manage it.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-017", title: "Keeping richer local geospatial metadata", topics: "Metadata and catalogues", sector: "Geospatial", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Geospatial</p><p>Local fields beyond the minimum.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-mandatory-kinds"">Questions: related guidance</a></li></ul>", t: "Local fields beyond the minimum.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-018", title: "Material above OFFICIAL", topics: "Security and restricted data", sector: "Defence and security", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Defence and security</p><p>Testing the security gate with material classified above OFFICIAL.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-classified"">Questions: related guidance</a></li></ul>", t: "Testing the security gate with material classified above OFFICIAL.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-019", title: "OFFICIAL-SENSITIVE operational data", topics: "Security and restricted data", sector: "Defence", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Defence</p><p>Whether the sensitive marking ends the assessment.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-classified"">Questions: related guidance</a></li></ul>", t: "Whether the sensitive marking ends the assessment.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-020", title: "Data shared under an umbrella agreement", topics: "Filling in the return; Scope principles", sector: "Cross-government sharing", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Cross-government sharing</p><p>What the metadata must show when an umbrella agreement covers the sharing.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-open-scenarios"">Questions: related guidance</a></li></ul>", t: "What the metadata must show when an umbrella agreement covers the sharing.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-021", title: "Corporate data held under a commercial licence", topics: "Third-party and licensed data", sector: "Commercial data", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Commercial data</p><p>Data an organisation owns versus data it only holds under supplier terms.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-open-scenarios"">Questions: related guidance</a></li></ul>", t: "Data an organisation owns versus data it only holds under supplier terms.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-022", title: "A decision route through the four principles", topics: "Scope principles", sector: "Any organisation", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Any organisation</p><p>Stop at the first clear no, and keep the reason.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/asset-test.html"">Asset test: related guidance</a></li></ul>", t: "Stop at the first clear no, and keep the reason.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-023", title: "A decision route for sharing", topics: "Scope principles", sector: "Any organisation", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Any organisation</p><p>Current sharing, open publication, potential sharing under controls, or private-sector use only.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-potential-value"">Questions: related guidance</a></li></ul>", t: "Current sharing, open publication, potential sharing under controls, or private-sector use only.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-024", title: "A decision route for third-party data", topics: "Third-party and licensed data", sector: "Any organisation", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Any organisation</p><p>Used as supplied, a governed copy, materially enriched, or licence-restricted.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-open-scenarios"">Questions: related guidance</a></li></ul>", t: "Used as supplied, a governed copy, materially enriched, or licence-restricted.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-025", title: "A decision route for security classification", topics: "Security and restricted data", sector: "Any organisation", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Any organisation</p><p>Which classifications stop the route, and which continue to the normal tests.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-classified"">Questions: related guidance</a></li></ul>", t: "Which classifications stop the route, and which continue to the normal tests.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-053", title: "A team says it has no critical data", topics: "Scope principles", sector: "Any organisation", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Any organisation</p><p>How a coordinator re-tests the claim.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p>", t: "How a coordinator re-tests the claim.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-054", title: "Nobody is clearly accountable", topics: "Owners and stewards", sector: "Any organisation", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Any organisation</p><p>Recording and escalating an ownership gap.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-who-accountable"">Questions: related guidance</a></li></ul>", t: "Recording and escalating an ownership gap.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-055", title: "No catalogue yet", topics: "Metadata and catalogues", sector: "Any organisation", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Any organisation</p><p>An interim record of where metadata lives, and a plan for the gaps.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-catalogue-tool"">Questions: related guidance</a></li></ul>", t: "An interim record of where metadata lives, and a plan for the gaps.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-056", title: "Discovering legacy social care data without inventing evidence", topics: "Metadata and catalogues; Data quality", sector: "Local government", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Local government</p><p>Recording unknowns honestly in a bounded discovery.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p>", t: "Recording unknowns honestly in a bounded discovery.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-064", title: "Transport services as candidates", topics: "Critical purposes; Scope principles", sector: "Transport", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Transport</p><p>Service importance alone does not settle scope.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p>", t: "Service importance alone does not settle scope.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-065", title: "Systems of record, not every service view", topics: "Sources, products and APIs", sector: "Transport", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Transport</p><p>Reporting coherent source assets rather than each service or system.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-principles"">Questions: related guidance</a></li></ul>", t: "Reporting coherent source assets rather than each service or system.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-066", title: "Data that could support grant eligibility", topics: "Scope principles", sector: "Transport and social support", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Transport and social support</p><p>Potential use by another organisation for eligibility checks.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-potential-value"">Questions: related guidance</a></li></ul>", t: "Potential use by another organisation for eligibility checks.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-067", title: "A department coordinating its agencies' returns", topics: "Arm's length bodies", sector: "Transport", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Transport</p><p>Agencies prepare their lists; the department coordinates.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-alb-returns"">Questions: related guidance</a></li></ul>", t: "Agencies prepare their lists; the department coordinates.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-068", title: "A local quality process that differs from the template", topics: "Data quality", sector: "Transport", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Transport</p><p>Meeting the intent of a quality plan in a different form.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-dqap"">Questions: related guidance</a></li></ul>", t: "Meeting the intent of a quality plan in a different form.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-071", title: "Weather data as a third-party example", topics: "Third-party and licensed data", sector: "Weather and climate", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Weather and climate</p><p>Third-party origin, commercial terms and public-sector use.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p>", t: "Third-party origin, commercial terms and public-sector use.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-072", title: "Mapping data as a third-party example", topics: "Third-party and licensed data", sector: "Geospatial", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Geospatial</p><p>Third-party and commercial constraints.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p>", t: "Third-party and commercial constraints.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-073", title: "A local identifier when there is no catalogue number", topics: "Filling in the return", sector: "Any organisation", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Any organisation</p><p>A stable local key for the identifier field.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-identifier"">Questions: related guidance</a></li></ul>", t: "A stable local key for the identifier field.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-075", title: "Fields that apply only sometimes", topics: "Filling in the return", sector: "Any organisation", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Any organisation</p><p>When to fill the conditional fields.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-if-applicable"">Questions: related guidance</a></li></ul>", t: "When to fill the conditional fields.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"},
  {id: "EX-076", title: "When a check rejects a true answer", topics: "Filling in the return", sector: "Any organisation", kind: "Scenario", stat: "Being agreed", x: "<p><b>[Scenario]</b> <b>[Being agreed]</b> Any organisation</p><p>Logging the problem rather than changing the answer.</p><p><b>Outcome.</b> Not yet agreed. Treat this as a scenario to discuss, not a ruling.</p><ul><li><a href=""https://cyberdudeuk.github.io/dam-policy-explorer/questions.html#q-field-lengths"">Questions: related guidance</a></li></ul>", t: "Logging the problem rather than changing the answer.", ic: Icon.LevelsLayersItems, col: RGBA(74,79,84,1), tint: RGBA(242,243,244,1), flag: "New"}
);
nfGlo = Table(
  {term: "Arm's length body", def: "An organisation that is part of government but works at a distance from its department, such as an executive agency.", flag: ""},
  {term: "Baseline Return", def: "The first list of critical data assets each organisation sends to GDS.", flag: ""},
  {term: "Chief data officer", def: "The most senior person in charge of data in an organisation. Responsible for putting the policy into practice there.", flag: ""},
  {term: "Chief Data Officer Council", def: "The group of chief data officers that oversees how the policy is put into practice across government.", flag: ""},
  {term: "Critical data asset", def: "A data asset that is OFFICIAL, serves at least one of seven critical purposes, has value across government through sharing, and that your organisation is accountable for. Called an Essential Shared Data Asset (ESDA) before the DAM Policy.", flag: ""},
  {term: "Critical purpose", def: "One of seven reasons that make shared data critical, numbered 1 to 7 in the guidance, such as delivering public services.", flag: ""},
  {term: "CSV file", def: "A simple file for table data that any spreadsheet program can open and save.", flag: ""},
  {term: "DAM", def: "Data Asset Management, the government policy this app is about.", flag: ""},
  {term: "Data asset", def: "One or more data sets, plus any data services used to reach them.", flag: ""},
  {term: "Data catalogue", def: "A list that describes the data an organisation holds, so people can find it.", flag: ""},
  {term: "Data custodian", def: "The team that runs the systems where data is kept, on behalf of the data owner.", flag: "New"},
  {term: "Data owner", def: "The person named as accountable for decisions about a data asset.", flag: ""},
  {term: "Data protection officer", def: "The person in an organisation who makes sure personal data is handled lawfully.", flag: ""},
  {term: "Data quality action plan", def: "A plan for keeping a data asset accurate and complete enough to use. Often shortened to DQAP.", flag: ""},
  {term: "Data service", def: "Something that gives controlled access to one or more data sets, such as an API.", flag: ""},
  {term: "Data set", def: "A structured collection of data chosen to meet a defined need. It can be part of a larger system.", flag: ""},
  {term: "Data steward", def: "The person who looks after a set of data day to day.", flag: ""},
  {term: "DCAT", def: "Data Catalogue Vocabulary, an open standard for describing data sets and data services. The metadata guidance recommends it.", flag: ""},
  {term: "ESDA", def: "Essential Shared Data Asset, the earlier name for a critical data asset. The return asks for your reference from the ESDA exercise.", flag: ""},
  {term: "GDS", def: "The Government Digital Service, which runs the Data Asset Management programme.", flag: ""},
  {term: "Information asset owner", def: "The person accountable for managing, securing and complying with rules about an information asset. The role continues alongside the data owner.", flag: ""},
  {term: "Information asset register", def: "A governance record of information assets, their owners (information asset owners), risks and controls.", flag: ""},
  {term: "Legal gateway", def: "The law or agreement that allows data to be shared.", flag: ""},
  {term: "Metadata", def: "Information that describes data: what it is, who owns it, where it comes from and how it can be used.", flag: ""},
  {term: "Metadata minimum", def: "The smallest set of details to record about each critical data asset. It is a floor, not a ceiling: keep any other fields you need.", flag: "New"},
  {term: "OFFICIAL", def: "The lowest of the government's security classifications. Most government data is OFFICIAL.", flag: ""},
  {term: "Performance Framework", def: "A quarterly GDS commission on departments' digital and data capability. It asks for counts, not lists, of critical data assets.", flag: "New"},
  {term: "Policy gap", def: "Something the policy expects that is not in place yet, such as an asset with no data owner. A gap is not a mistake: GDS accepts it and uses it to decide where to help.", flag: ""},
  {term: "Scope principles", def: "The four DAM Policy principles that decide whether an asset is in scope: critical criterion, shared, accountable, and prioritise the source.", flag: ""},
  {term: "System of record", def: "The system that holds the authoritative version of some data. Copies and services built on it point back to it.", flag: "New"},
  {term: "Worked example", def: "A real kind of data used to show how the policy applies: whether it is in scope and how to fill in the return.", flag: "New"},
  {term: "XG_CDA", def: "The label GDS recommends for marking assets that are in scope of the DAM Policy in your data catalogue.", flag: ""}
);
nfTopics = Table(
  {topic: "All"},
  {topic: "Scope and critical data assets"},
  {topic: "Roles and governance"},
  {topic: "Data management requirements"},
  {topic: "Implementation and support"},
  {topic: "Reporting and the return"},
  {topic: "Related initiatives"},
  {topic: "Embedding the policy"},
  {topic: "Finding things"}
);
nfExKinds = Table(
  {kind: "All"},
  {kind: "In scope"},
  {kind: "Out of scope"},
  {kind: "It depends"},
  {kind: "Filling in the return"},
  {kind: "Roles"},
  {kind: "Process"},
  {kind: "Scenario"}
);
nfTestQ = Table(
  {n: 1, key: "official", q: "Is it classified OFFICIAL?", hint: "OFFICIAL with markings such as sensitive counts. SECRET and TOP SECRET do not.", multi: 0},
  {n: 2, key: "purpose", q: "Which critical purposes does it serve?", hint: "Principle 1, a critical criterion. Choose all that apply, or none.", multi: 1},
  {n: 3, key: "shared", q: "How is it shared?", hint: "Principle 2, shared. Choose the best fit.", multi: 0},
  {n: 4, key: "accountable", q: "Who is accountable for it?", hint: "Principle 3, accountable.", multi: 0},
  {n: 5, key: "source", q: "Is it the source data?", hint: "Principle 4, prioritise the source.", multi: 0}
);
nfTestOpt = Table(
  {key: "official", v: "yes", label: "Yes"},
  {key: "official", v: "no", label: "No, it is SECRET or TOP SECRET"},
  {key: "official", v: "unsure", label: "Not sure"},
  {key: "purpose", v: "1", label: "1. Delivering public services"},
  {key: "purpose", v: "2", label: "2. A legislative, legal or contractual requirement"},
  {key: "purpose", v: "3", label: "3. Defence, national security and resilience"},
  {key: "purpose", v: "4", label: "4. Developing and evaluating policy"},
  {key: "purpose", v: "5", label: "5. Official statistics"},
  {key: "purpose", v: "6", label: "6. The public interest"},
  {key: "purpose", v: "7", label: "7. Fraud and error"},
  {key: "purpose", v: "unsure", label: "Not sure"},
  {key: "shared", v: "dsa", label: "Shared with a public sector organisation under a data sharing agreement"},
  {key: "shared", v: "open", label: "Published as open data"},
  {key: "shared", v: "potential", label: "Not shared yet, but could create value if it were"},
  {key: "shared", v: "no", label: "Only used inside our organisation"},
  {key: "shared", v: "unsure", label: "Not sure"},
  {key: "accountable", v: "own", label: "We manage or control it"},
  {key: "accountable", v: "enriched", label: "It came from another organisation, and we have materially changed or enriched it"},
  {key: "accountable", v: "asis", label: "It came from another organisation and we use it as it is"},
  {key: "accountable", v: "unsure", label: "Not sure"},
  {key: "source", v: "source", label: "Yes, it is the source data set"},
  {key: "source", v: "product", label: "No, it is an extract, report, API or product, but it is managed and owned in its own right"},
  {key: "source", v: "derived", label: "No, it is an extract, report, API or product drawn from source data"},
  {key: "source", v: "unsure", label: "Not sure"}
);
nfHome = Table(
  {sec: 1, title: "The policy in plain English", summ: "What the policy asks, who it applies to and who does what", kind: "page", ref: "policy", ic: Icon.Journal, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1), flag: "Updated"},
  {sec: 1, title: "Roles and journeys", summ: "Who does what, by role", kind: "page", ref: "people", ic: Icon.People, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1), flag: ""},
  {sec: 1, title: "Capabilities", summ: "The capabilities behind the policy", kind: "page", ref: "capabilities", ic: Icon.Waypoint, col: RGBA(11,85,163,1), tint: RGBA(230,238,247,1), flag: ""},
  {sec: 2, title: "Asset test", summ: "Five questions: is this a critical data asset?", kind: "test", ref: "", ic: Icon.CheckBadge, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {sec: 2, title: "Worked examples", summ: "71 examples of what is in scope and what is not", kind: "examples", ref: "", ic: Icon.LevelsLayersItems, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: "New"},
  {sec: 2, title: "Matchmaker", summ: "Is the same or a related data set already in the National Data Library?", kind: "match", ref: "", ic: Icon.Link, col: RGBA(0,105,92,1), tint: RGBA(224,240,238,1), flag: ""},
  {sec: 3, title: "Your return", summ: "The twelve steps of the Baseline Return", kind: "page", ref: "return", ic: Icon.DetailList, col: RGBA(11,107,58,1), tint: RGBA(231,243,236,1), flag: ""},
  {sec: 3, title: "Track your return", summ: "What happens after you send it", kind: "page", ref: "track", ic: Icon.RadarActivityMonitor, col: RGBA(11,107,58,1), tint: RGBA(231,243,236,1), flag: ""},
  {sec: 3, title: "Embed it", summ: "Make the policy part of how you work", kind: "page", ref: "embed", ic: Icon.Tools, col: RGBA(11,107,58,1), tint: RGBA(231,243,236,1), flag: "Updated"},
  {sec: 4, title: "Questions and answers", summ: "55 answers, each showing its source", kind: "questions", ref: "", ic: Icon.QuestionMark, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1), flag: "New"},
  {sec: 4, title: "Search everything", summ: "Pages, answers, examples and glossary", kind: "search", ref: "", ic: Icon.Search, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1), flag: ""},
  {sec: 4, title: "Glossary", summ: "32 words explained", kind: "glossary", ref: "", ic: Icon.Tag, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1), flag: "New"},
  {sec: 4, title: "Resources", summ: "Templates, guidance and playbooks", kind: "page", ref: "resources", ic: Icon.Folder, col: RGBA(90,47,138,1), tint: RGBA(238,232,245,1), flag: ""},
  {sec: 5, title: "User guide", summ: "How to use this app", kind: "page", ref: "guide", ic: Icon.Journal, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1), flag: "New"},
  {sec: 5, title: "Tutorials and tours", summ: "Short walk-throughs of the main tasks", kind: "learn", ref: "", ic: Icon.Lightbulb, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1), flag: ""},
  {sec: 5, title: "Support and contact", summ: "Get help or ask a question", kind: "support", ref: "", ic: Icon.Message, col: RGBA(138,74,0,1), tint: RGBA(247,237,224,1), flag: ""},
